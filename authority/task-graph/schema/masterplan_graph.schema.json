{
  "$defs": {
    "attestation": {
      "additionalProperties": true,
      "properties": {
        "criteria": {
          "type": "array"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "minLength": 1,
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "passed",
        "criteria",
        "evidence",
        "digest",
        "occurred_at",
        "provenance"
      ],
      "type": "object"
    },
    "authority": {
      "additionalProperties": true,
      "properties": {
        "accepted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_class": {
          "minLength": 1,
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "unknown",
            "observed",
            "proposed",
            "accepted",
            "authoritative",
            "rejected",
            "superseded"
          ],
          "type": "string"
        },
        "tier": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state",
        "authority_class",
        "tier",
        "source",
        "confidence"
      ],
      "type": "object"
    },
    "decision": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "decision": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rationale": {
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "subject",
        "decision",
        "authority",
        "rationale",
        "occurred_at",
        "provenance"
      ],
      "type": "object"
    },
    "event": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "event_type": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "event_type",
        "authority",
        "occurred_at",
        "provenance"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "kind",
        "passed",
        "authority",
        "provenance"
      ],
      "type": "object"
    },
    "priority": {
      "additionalProperties": true,
      "properties": {
        "authority_locked": {
          "type": "boolean"
        },
        "band": {
          "pattern": "^P[0-9]+[A-Z]*$",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "type": "integer"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "band",
        "ordinal",
        "authority_locked",
        "rationale"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": true,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "type": "string"
        },
        "generated_at": {
          "minLength": 1,
          "type": "string"
        },
        "generated_by": {
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "type": "array"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "generated_by",
        "generated_at",
        "contract_version"
      ],
      "type": "object"
    },
    "receipt": {
      "additionalProperties": true,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "minLength": 1,
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "operation",
        "passed",
        "outputs",
        "evidence",
        "occurred_at",
        "provenance"
      ],
      "type": "object"
    },
    "segue": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "target",
        "authority",
        "provenance"
      ],
      "type": "object"
    },
    "task": {
      "additionalProperties": true,
      "properties": {
        "acceptance": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "description": {
          "type": "string"
        },
        "evidence_requirements": {
          "type": "array"
        },
        "extensions": {
          "type": "object"
        },
        "id": {
          "pattern": "^SAV-[A-Z0-9._-]+$",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "lineage": {
          "type": "object"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "purpose": {
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "status": {
          "enum": [
            "unknown",
            "proposed",
            "accepted",
            "ready",
            "active",
            "blocked",
            "paused",
            "completed",
            "reopened",
            "rejected",
            "cancelled",
            "superseded",
            "archived"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "priority",
        "status",
        "authority",
        "purpose",
        "scope",
        "acceptance",
        "evidence_requirements",
        "outputs",
        "risks",
        "security",
        "lineage",
        "provenance",
        "extensions"
      ],
      "type": "object"
    }
  },
  "$id": "savant://niche/masterplan/graph/1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attestations": {
      "items": {
        "$ref": "#/$defs/attestation"
      },
      "type": "array"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/decision"
      },
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/event"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "type": "array"
    },
    "graph_id": {
      "minLength": 1,
      "type": "string"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/receipt"
      },
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/task"
      },
      "type": "array"
    },
    "schema_metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "segues": {
      "items": {
        "$ref": "#/$defs/segue"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "authority",
    "records",
    "segues",
    "events",
    "decisions",
    "evidence",
    "receipts",
    "attestations"
  ],
  "title": "Savant Masterplan Authoritative Task Graph",
  "type": "object"
}
