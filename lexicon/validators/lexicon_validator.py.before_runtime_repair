        context = require_context(self.context)

        graph = build_graph(
            context.lexemes,
            source_field="ontology",
        )

        cycle = find_cycle(graph)

        if cycle:
            self.report.add(
                code="ontology_graph.cycle",
                severity="warning",
                validator="ontology_graph",
                message=(
                    "Ontology graph contains a "
                    "cycle. Verify that the cycle "
                    "is intentional."
                ),
