#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "runtime"
    / "runtime_transaction.py"
)

COMMANDS = {
    "begin",
    "execute",
    "commit",
    "rollback",
    "run",
    "status",
    "verify",
}


def usage() -> None:
    print(
        """
runtimetransactionctl begin ACTION [--subsystem NAME]
runtimetransactionctl execute TRANSACTION_ID
runtimetransactionctl commit TRANSACTION_ID
runtimetransactionctl rollback TRANSACTION_ID [--reason TEXT]

runtimetransactionctl run ACTION
runtimetransactionctl run ACTION --subsystem NAME
runtimetransactionctl run ACTION --subsystem NAME --subsystem NAME
runtimetransactionctl run ACTION --no-rollback

runtimetransactionctl status
runtimetransactionctl status TRANSACTION_ID
runtimetransactionctl verify
"""
    )


def main() -> int:
    if len(
        sys.argv
    ) < 2:
        usage()
        return 1

    command = sys.argv[
        1
    ]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        usage()
        return 0

    if command not in COMMANDS:
        print(
            f"Unknown command: {command}",
            file=sys.stderr,
        )

        usage()

        return 1

    return subprocess.run(
        [
            sys.executable,
            str(
                ENGINE
            ),
            *sys.argv[
                1:
            ],
        ],
        cwd=str(
            ENGINE.parent
        ),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
