#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "runtime"
    / "runtime_orchestrator.py"
)

COMMANDS = {
    "plan",
    "run",
    "status",
    "verify",
}


def usage() -> None:
    print(
        """
runtimeorchestratorctl plan validate
runtimeorchestratorctl plan compile
runtimeorchestratorctl plan integrity
runtimeorchestratorctl plan full

runtimeorchestratorctl run validate
runtimeorchestratorctl run compile
runtimeorchestratorctl run integrity
runtimeorchestratorctl run full

runtimeorchestratorctl run full --checkpoint-label TEXT
runtimeorchestratorctl run full --continue-on-failure

runtimeorchestratorctl status
runtimeorchestratorctl verify
"""
    )


def main() -> int:
    if len(
        sys.argv
    ) < 2:
        usage()
        return 1

    command = sys.argv[
        1
    ]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        usage()
        return 0

    if command not in COMMANDS:
        print(
            f"Unknown command: {command}",
            file=sys.stderr,
        )

        usage()

        return 1

    return subprocess.run(
        [
            sys.executable,
            str(
                ENGINE
            ),
            *sys.argv[
                1:
            ],
        ],
        cwd=str(
            ENGINE.parent
        ),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
