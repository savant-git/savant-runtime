#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(__file__).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "kindred"
    / "kindred_engine.py"
)

VALIDATOR = (
    LEXICON_ROOT
    / "kindred"
    / "kindred_validator.py"
)


def run(
    script: Path,
    arguments: list[str],
) -> int:
    if not script.exists():
        print(
            f"Missing file: {script}",
            file=sys.stderr,
        )

        return 1

    return subprocess.run(
        [
            sys.executable,
            str(script),
            *arguments,
        ],
        cwd=str(LEXICON_ROOT),
        check=False,
    ).returncode


def usage() -> None:
    print(
        """Usage:
kindredctl validate
kindredctl get <kindred-id>
kindredctl members <kindred-id> [--recursive]
kindredctl memberships <member-id> [--direct]
kindredctl ancestors <kindred-id>
kindredctl descendants <kindred-id>
kindredctl dependencies <kindred-id> [--recursive]
kindredctl graph
"""
    )


def main() -> int:
    if len(sys.argv) < 2:
        usage()
        return 1

    command = sys.argv[1]
    arguments = sys.argv[2:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        usage()
        return 0

    if command == "validate":
        return run(
            VALIDATOR,
            arguments,
        )

    engine_commands = {
        "get",
        "members",
        "memberships",
        "ancestors",
        "descendants",
        "dependencies",
        "graph",
    }

    if command in engine_commands:
        return run(
            ENGINE,
            [
                command,
                *arguments,
            ],
        )

    print(
        f"Unknown command: {command}",
        file=sys.stderr,
    )

    usage()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
