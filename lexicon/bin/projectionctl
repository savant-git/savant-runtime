#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "projection_engine"
    / "projection_engine.py"
)

VALIDATOR = (
    LEXICON_ROOT
    / "projection_engine"
    / "projection_validator.py"
)

ENGINE_COMMANDS = {
    "resolve",
    "record",
    "all",
    "snapshot",
    "materialize",
    "materialize-all",
}


def run(
    script: Path,
    arguments: list[str],
) -> int:

    if not script.exists():

        print(
            f"Missing file: {script}",
            file=sys.stderr,
        )

        return 1

    return subprocess.run(
        [
            sys.executable,
            str(script),
            *arguments,
        ],
        cwd=str(
            script.parent
        ),
        check=False,
    ).returncode


def usage() -> None:

    print(
        """
projectionctl validate
projectionctl compile
projectionctl integrity

projectionctl resolve <projection-id>

projectionctl record <projection-id> <source-id>

projectionctl all <projection-id>

projectionctl snapshot <projection-id>

projectionctl materialize <projection-id>
  [--output PATH]

projectionctl materialize-all
  [--output PATH]
"""
    )


def main() -> int:

    if len(
        sys.argv
    ) < 2:

        usage()

        return 1

    command = sys.argv[1]
    arguments = sys.argv[2:]

    if command in {
        "help",
        "--help",
        "-h",
    }:

        usage()

        return 0

    if command == "validate":

        return run(
            VALIDATOR,
            arguments,
        )

    if command == "compile":

        status = run(
            VALIDATOR,
            [],
        )

        if status:

            return status

        return run(
            ENGINE,
            [
                "materialize-all",
                *arguments,
            ],
        )

    if command == "integrity":

        status = run(
            VALIDATOR,
            [],
        )

        if status:

            return status

        status = run(
            ENGINE,
            [
                "materialize-all",
            ],
        )

        if status:

            return status

        return 0

    if command in ENGINE_COMMANDS:

        return run(
            ENGINE,
            [
                command,
                *arguments,
            ],
        )

    print(
        f"Unknown command: {command}",
        file=sys.stderr,
    )

    usage()

    return 1


if __name__ == "__main__":

    raise SystemExit(
        main()
    )
