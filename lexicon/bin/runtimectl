#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

BIN_ROOT = LEXICON_ROOT / "bin"

COMMAND_MAP = {
    "address": "runtimeaddressctl",
    "query": "runtimequeryctl",
    "audit": "runtimeauditctl",
    "audit-validate": (
        "runtimeauditvalidate"
    ),
    "transaction": (
        "runtimetransactionctl"
    ),
    "recovery": (
        "runtimerecoveryctl"
    ),
    "checkpoint": (
        "runtimecheckpointctl"
    ),
    "orchestrate": (
        "runtimeorchestratorctl"
    ),
}


def usage() -> None:
    print(
        """
runtimectl address ...
runtimectl query ...
runtimectl audit ...
runtimectl audit-validate
runtimectl transaction ...
runtimectl recovery ...
runtimectl checkpoint ...
runtimectl orchestrate ...

Common commands:

runtimectl orchestrate plan full
runtimectl orchestrate run validate
runtimectl orchestrate run compile
runtimectl orchestrate run integrity
runtimectl orchestrate run full
runtimectl orchestrate status
runtimectl orchestrate verify
"""
    )


def main() -> int:
    if len(
        sys.argv
    ) < 2:
        usage()
        return 1

    namespace = sys.argv[
        1
    ]

    if namespace in {
        "help",
        "--help",
        "-h",
    }:
        usage()
        return 0

    controller_name = (
        COMMAND_MAP.get(
            namespace
        )
    )

    if controller_name is None:
        print(
            f"Unknown runtime namespace: "
            f"{namespace}",
            file=sys.stderr,
        )

        usage()

        return 1

    controller = (
        BIN_ROOT
        / controller_name
    )

    if not controller.is_file():
        print(
            f"Runtime controller missing: "
            f"{controller}",
            file=sys.stderr,
        )

        return 1

    return subprocess.run(
        [
            str(
                controller
            ),
            *sys.argv[
                2:
            ],
        ],
        cwd=str(
            LEXICON_ROOT
        ),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
