#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "instances"
    / "instance_engine.py"
)

VALIDATOR = (
    LEXICON_ROOT
    / "instances"
    / "instance_validator.py"
)


ENGINE_COMMANDS = {

    "graph",

    "snapshot",

    "search",

    "resolve",

    "project",

}


def run(
    script: Path,
    arguments: list[str],
) -> int:

    if not script.exists():

        print(
            f"Missing file: {script}",
            file=sys.stderr,
        )

        return 1

    return subprocess.run(

        [
            sys.executable,
            str(script),
            *arguments,
        ],

        cwd=str(
            LEXICON_ROOT
        ),

        check=False,

    ).returncode


def usage():

    print(
"""
instancectl validate
instancectl compile
instancectl integrity

instancectl graph
instancectl snapshot

instancectl resolve <reference>

instancectl search <query>

instancectl project
instancectl project --output PATH
"""
    )


def main():

    if len(
        sys.argv
    ) < 2:

        usage()

        return 1

    command = sys.argv[1]

    arguments = sys.argv[2:]

    if command in {

        "help",

        "--help",

        "-h",

    }:

        usage()

        return 0

    if command == "validate":

        return run(

            VALIDATOR,

            arguments,

        )

    if command == "compile":

        status = run(

            VALIDATOR,

            [],

        )

        if status:

            return status

        return run(

            ENGINE,

            [

                "project",

                *arguments,

            ],

        )

    if command == "integrity":

        status = run(

            VALIDATOR,

            [],

        )

        if status:

            return status

        status = run(

            ENGINE,

            [

                "project",

            ],

        )

        if status:

            return status

        return run(

            ENGINE,

            [

                "snapshot",

            ],

        )

    if command in ENGINE_COMMANDS:

        return run(

            ENGINE,

            [

                command,

                *arguments,

            ],

        )

    print(

        f"Unknown command: {command}",

        file=sys.stderr,

    )

    usage()

    return 1


if __name__ == "__main__":

    raise SystemExit(
        main()
    )
