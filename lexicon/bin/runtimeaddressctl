#!/usr/bin/env python3

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


LEXICON_ROOT = Path(
    __file__
).resolve().parents[1]

ENGINE = (
    LEXICON_ROOT
    / "runtime"
    / "runtime_address.py"
)

COMMANDS = {
    "build",
    "materialize",
    "resolve",
    "related",
    "list",
}


def usage() -> None:
    print(
        """
runtimeaddressctl build
runtimeaddressctl materialize
runtimeaddressctl resolve ADDRESS
runtimeaddressctl related ADDRESS [--relation RELATION]
runtimeaddressctl list
"""
    )


def main() -> int:
    if len(
        sys.argv
    ) < 2:
        usage()
        return 1

    command = sys.argv[
        1
    ]

    arguments = sys.argv[
        2:
    ]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        usage()
        return 0

    if command not in COMMANDS:
        print(
            f"Unknown command: {command}",
            file=sys.stderr,
        )
        usage()
        return 1

    return subprocess.run(
        [
            sys.executable,
            str(
                ENGINE
            ),
            command,
            *arguments,
        ],
        cwd=str(
            ENGINE.parent
        ),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
