{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:runtime:transaction",
  "title": "Savant Runtime Transaction",
  "type": "object",
  "required": [
    "transaction_id",
    "sequence",
    "state",
    "action",
    "subsystems",
    "created_at",
    "updated_at",
    "results",
    "provenance",
    "lineage",
    "digest"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "^runtime-transaction-[0-9]{12}-[a-f0-9]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "committed",
        "rolled_back",
        "failed"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "validate",
        "compile",
        "integrity"
      ]
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "lexicon",
          "ontology",
          "kindred",
          "instance",
          "segue",
          "projection",
          "constitution"
        ]
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "results": {
      "type": "array"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    },
    "commit": {
      "type": [
        "object",
        "null"
      ]
    },
    "rollback": {
      "type": [
        "object",
        "null"
      ]
    },
    "snapshot": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
