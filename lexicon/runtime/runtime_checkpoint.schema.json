{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:runtime:checkpoint",
  "title": "Savant Runtime Checkpoint",
  "type": "object",
  "required": [
    "checkpoint_id",
    "sequence",
    "created_at",
    "lexicon_root",
    "targets",
    "record_count",
    "total_size",
    "tree_digest",
    "records",
    "dependencies",
    "provenance",
    "lineage",
    "digest"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "pattern": "^runtime-checkpoint-[0-9]{12}-[a-f0-9]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "lexicon_root": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_size": {
      "type": "integer",
      "minimum": 0
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction": {
      "type": [
        "object",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "source_path",
          "sha256",
          "size",
          "mode",
          "object"
        ],
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          },
          "object": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
