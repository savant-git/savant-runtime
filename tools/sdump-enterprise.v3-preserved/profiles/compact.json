  "max_file_bytes": 524288,
  "max_total_content_bytes": 8388608,
  "max_files": 100000,
  "include_tree": false,
  "include_inventory": false,
  "respect_gitignore": true,
  "redact_secrets": true,
  "follow_symlinks": false,
  "budget_strategy": "migration_priority",
  "critical_path_prefixes": [
    "canon/",
    "authority/",
    "canon-system/authority/",
    "tools/sdump-enterprise/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/palaver/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/opus/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/envoy/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/niche/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/coda/",
    "ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/notary/"
  ],
