    "runtime/",
    "commands/",
    "context/",
    "contracts/",
    "config/",
    "validators/",
    "ontology/",
    "edifices/identity/",
    "canon-system/",
    "frontend/",
    "systemd/"
  ],
  "deprioritized_path_fragments": [
    "/tests/",
    "/test/",
    "/fixtures/",
    "/examples/",
    "/example/",
    "/docs/archive/",
    "/historical/",
    "/legacy/"
  ],
  "priority_filenames": [
    "pyproject.toml",
    "requirements.txt",
    "package.json",
    "dockerfile",
    "containerfile",
    "makefile",
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml",
    "systemd.service",
    "nginx.conf"
  ],
  "recent_window_days": 30,
  "very_recent_window_days": 7,
  "small_file_bonus_bytes": 65536,
  "metadata_only_on_budget_exhaustion": true
}
