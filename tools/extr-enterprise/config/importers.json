{
  "schema": "savant.extr.importers.v1",
  "owner": "extr",
  "authority_effect": "none",
  "policy": {
    "preserve_original": true,
    "content_address_source": true,
    "never_overwrite_source": true,
    "stream_when_possible": true,
    "nested_containers": true,
    "bounded_recursion": true,
    "malformed_input": "preserve-and-report",
    "unknown_format": "binary-metadata-fallback"
  },
  "families": {
    "text": [
      ".txt",
      ".md",
      ".markdown",
      ".rst",
      ".log",
      ".csv",
      ".tsv"
    ],
    "structured": [
      ".json",
      ".jsonl",
      ".ndjson",
      ".yaml",
      ".yml",
      ".toml",
      ".xml"
    ],
    "web": [
      ".html",
      ".htm"
    ],
    "document": [
      ".pdf",
      ".docx",
      ".odt",
      ".rtf"
    ],
    "spreadsheet": [
      ".xlsx",
      ".xls",
      ".ods"
    ],
    "presentation": [
      ".pptx",
      ".odp"
    ],
    "mail": [
      ".eml",
      ".mbox"
    ],
    "archive": [
      ".zip",
      ".tar",
      ".tgz",
      ".gz",
      ".bz2",
      ".xz"
    ],
    "chatgpt": [
      "conversations.json",
      "chat.html"
    ]
  }
}
