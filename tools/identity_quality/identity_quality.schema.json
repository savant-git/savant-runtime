{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "savant://schemas/identity-quality/1.0.0",
  "title": "Savant Identity Quality Contract",
  "type": "object",
  "required": [
    "id",
    "kind",
    "level",
    "version",
    "status",
    "identity",
    "purpose",
    "authority",
    "composition",
    "contracts",
    "capabilities",
    "dependencies",
    "relationships",
    "lineage",
    "provenance",
    "runtime",
    "security",
    "observability",
    "validation",
    "lifecycle",
    "apertures"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "enum": [
        "exile",
        "prodigal",
        "quirk"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "canonical",
        "active",
        "deprecated",
        "superseded",
        "retired"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "historical_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "authority": {
      "type": "object",
      "required": [
        "owner",
        "class",
        "precedence",
        "source"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "precedence": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "composition": {
      "type": "object",
      "required": [
        "children",
        "shared_children",
        "composition_policy"
      ],
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "shared_children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "composition_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "contracts": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "errors"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorContract"
          }
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "object",
      "required": [
        "required",
        "optional",
        "runtime",
        "external"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "runtime": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      },
      "additionalProperties": true
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "parents",
        "sources",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_from",
        "captured_by",
        "source_hashes"
      ],
      "properties": {
        "created_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "captured_by": {
          "type": "string",
          "minLength": 1
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": [
        "implementation",
        "entrypoints",
        "hooks",
        "deterministic",
        "side_effects"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "absent",
            "prototype",
            "partial",
            "complete"
          ]
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "deterministic": {
          "type": "boolean"
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": [
        "boundary",
        "permissions",
        "data_classification",
        "network_policy",
        "sandbox"
      ],
      "properties": {
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "data_classification": {
          "type": "string",
          "minLength": 1
        },
        "network_policy": {
          "type": "string",
          "minLength": 1
        },
        "sandbox": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "required": [
        "metrics",
        "events",
        "health",
        "audit"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "health": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "audit": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": [
        "unit_tests",
        "integration_tests",
        "property_tests",
        "security_tests",
        "acceptance"
      ],
      "properties": {
        "unit_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integration_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "property_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state",
        "allowed_transitions"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "allowed_transitions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "apertures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aperture"
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "schema",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "errorContract": {
      "type": "object",
      "required": [
        "code",
        "condition",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "status": {
          "enum": [
            "proposed",
            "prototype",
            "partial",
            "active",
            "deprecated"
          ]
        }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "target",
        "direction"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "outbound",
            "inbound",
            "bidirectional"
          ]
        }
      },
      "additionalProperties": true
    },
    "aperture": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "admission"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 10
        },
        "admission": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
