{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "savant://dry-run/result/1.0.0",
  "title": "Savant Dry-Run Result",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "mutation_performed",
    "baseline_digest",
    "staged_digest",
    "verdict",
    "verdict_reasons",
    "gates",
    "actions",
    "result_digest"
  ],
  "properties": {
    "version": {"const": "1.0.0"},
    "mutation_performed": {"const": false},
    "verdict": {"enum": ["safe", "unsafe", "indeterminate"]},
    "baseline_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "staged_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict_reasons": {"type": "array", "items": {"type": "string"}},
    "gates": {"type": "array"},
    "actions": {"type": "array"}
  },
  "additionalProperties": true
}
