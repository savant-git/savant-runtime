      },
      {
        "id": "trigger-group.environment",
        "triggers": [
          "repository-changed",
          "configuration-changed",
          "runtime-changed",
          "external-interface-changed",
          "plugin-added",
          "plugin-removed",
          "library-version-changed",
          "security-policy-changed",
          "deployment-topology-changed"
        ]
      },
      {
        "id": "trigger-group.optimization",
        "triggers": [
          "stronger-algorithm-identified",
          "stronger-data-structure-identified",
          "stronger-projection-identified",
          "stronger-normalization-identified",
          "stronger-automation-identified",
          "stronger-validation-identified",
          "stronger-reconciliation-identified",
          "stronger-recovery-identified",
          "stronger-constitutional-design-identified"
        ]
      }
    ]
  },
  "constitutional_review": {
    "question_count": 54,
    "groups": [
      {
        "id": "review.authority",
        "questions": [
          "Is every rule still authoritative?",
          "Is every rule still necessary?",
          "Does every rule expose provenance?",
          "Does every rule expose lineage?",
          "Does every rule expose dependencies?",
          "Does every rule expose dependents?",
          "Can every rule be validated?",
          "Can every rule be replayed?",
          "Does every rule remain internally consistent?"
        ]
      },
      {
        "id": "review.architecture",
        "questions": [
          "Has duplication increased?",
          "Has coupling increased?",
          "Has cohesion decreased?",
          "Is every subsystem still composable?",
          "Is every subsystem still extensible?",
          "Is every subsystem deterministic?",
          "Are interfaces still minimal?",
          "Are projections still disposable?",
          "Can the architecture be simplified?"
        ]
      },
      {
        "id": "review.knowledge",
        "questions": [
          "Is any information obsolete?",
          "Is any information speculative?",
          "Is any information duplicated?",
          "Is any information contradictory?",
          "Is authority still minimal?",
          "Is projection still maximal?",
          "Is reconstruction deterministic?",
          "Is semantic integrity preserved?",
          "Can knowledge quality improve?"
        ]
      },
      {
        "id": "review.execution",
        "questions": [
          "Can more work be automated safely?",
          "Can task completion inference improve?",
          "Can dependency propagation improve?",
          "Can replay improve?",
          "Can validation improve?",
          "Can auditing improve?",
          "Can recovery improve?",
          "Can execution become simpler?",
          "Can execution become faster without weakening correctness?"
        ]
      },
      {
        "id": "review.evolution",
        "questions": [
          "Has stronger evidence appeared?",
          "Has stronger architecture appeared?",
          "Has more exact terminology appeared?",
          "Has stronger normalization appeared?",
          "Has a stronger graph structure appeared?",
          "Has stronger dependency modeling appeared?",
          "Has stronger replay appeared?",
          "Has stronger constitutional governance appeared?",
          "Should this constitutional region evolve?"
        ]
      },
      {
        "id": "review.fitness",
        "questions": [
          "Is complexity justified?",
          "Can stored authority decrease?",
          "Can deterministic projection increase?",
          "Can manual work decrease?",
          "Can constitutional entropy decrease?",
          "Can auditability improve?",
          "Can recoverability improve?",
          "Is the proposed revision objectively superior?",
          "Should a new constitutional revision be proposed?"
        ]
      }
    ]
  },
  "fixed_point_propagation": {
    "required": true,
    "rule": "Propagate authoritative effects until no governed derived state changes.",
    "maximum_iterations": 81,
    "nonconvergence_action": "fail-and-emit-blocking-convergence-report",
    "detect": [
      "dependency-cycle",
      "state-oscillation",
      "priority-oscillation",
      "mutual-invalidation",
      "contradictory-acceptance-criteria",
      "non-deterministic-projection",
      "unreachable-task",
      "orphaned-task",
      "duplicate-semantic-task"
    ]
  },
  "bounded_autonomy": {
    "allowed": [
      "regenerate-projections",
      "rebuild-derived-indexes",
      "recompute-task-state",
      "invalidate-stale-cache",
      "reorder-execution-queue",
      "emit-findings",
      "generate-impact-report",
      "generate-reconciliation-plan",
      "generate-migration-plan"
    ],
    "forbidden": [
      "manufacture-authority",
      "accept-own-proposal",
      "accept-constitutional-amendment",
      "invent-project-owner-decision",
      "waive-required-evidence",
      "delete-authoritative-history",
