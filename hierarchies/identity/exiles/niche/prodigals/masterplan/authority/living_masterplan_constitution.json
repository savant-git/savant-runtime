{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "savant://niche/masterplan/living-constitution/1.0.0",
  "id": "constitution.masterplan.living",
  "version": "1.0.0",
  "title": "Living Masterplan Constitution",
  "status": "proposed",
  "authority": {
    "state": "project-owner-directed-candidate",
    "authority_class": "project-owner-directed",
    "tier": 1,
    "source": "project-conversation",
    "accepted_by": null,
    "accepted_at": null,
    "confidence": 1.0
  },
  "purpose": "Govern continuous Masterplan evaluation, evidence-derived task state, deterministic dependency propagation, bounded repair, constitutional review, and projection regeneration without permitting the system to manufacture authority.",
  "governing_principles": [
    "authority-before-inference",
    "authority-before-projection",
    "current-verified-implementation-is-baseline",
    "extension-before-replacement",
    "composition-before-duplication",
    "projection-before-storage",
    "emergence-before-hardcoding",
    "immutable-history-before-destructive-mutation",
    "deterministic-reconstruction"
  ],
  "emergent_modular_hierarchy": {
    "atomic_rule": "Atomic characters are directly substantiated exactly once.",
    "instance_rule": "Everything above the atomic character layer is composed from instances.",
    "construction_law": "level_n = deterministic_composition(instances_of_level_n_minus_1)",
    "canonical_direction": [
      "atomic-character",
      "line-instance",
      "snippet-instance",
      "component-instance",
      "behavior-instance",
      "script-instance",
      "subsystem-instance",
      "system-instance",
      "constitutional-composition"
    ],
    "requirements": [
      "lower-level substance must not be duplicated",
      "instances must retain stable identity",
      "instances must expose lineage",
      "instances must expose provenance",
      "instances must expose dependencies",
      "instances must expose typed segues",
      "instances must remain independently reusable",
      "instances must remain attachable",
      "instances must remain succession-capable"
    ]
  },
  "baseline_policy": {
    "rule": "Every modification begins from the exact current verified state of the affected implementation.",
    "requirements": [
      "load-current-file-before-planning",
      "capture-current-content-digest",
      "capture-current-semantic-digest",
      "identify-current-tests",
      "identify-current-dependencies",
      "identify-current-dependents",
      "preserve-working-behavior",
      "extend-before-replace",
      "compare-result-with-prior-verified-state"
    ],
    "prohibitions": [
      "reconstructing-from-memory",
      "using-an-older-file-as-baseline",
      "silently-removing-existing-capability",
      "replacing-when-extension-is-possible",
      "discarding-lineage",
      "discarding-provenance",
      "ignoring-dependents",
      "claiming-parity-without-evidence",
      "publishing-without-integrated-verification"
    ]
  },
  "task_state_policy": {
    "authoritative_owner": "authority/task-graph/masterplan.json",
    "derived_surfaces": [
      "markdown-roadmap",
      "codex-instructions",
      "chatgpt-project-source",
      "execution-queue",
      "task-observatory",
      "status-report",
      "checklist",
      "priority-projection",
      "dependency-projection"
    ],
    "completion_rule": "Task completion is a deterministic projection of current admissible evidence.",
    "manual_completion_rule": "Manual completion requests create review decisions and never directly mutate completion state.",
    "completion_requirements": [
      "objective-satisfied",
      "dependencies-resolved",
      "required-outputs-present",
      "output-digests-valid",
      "required-validators-pass",
      "required-tests-pass",
      "required-evidence-current",
      "required-receipts-present",
      "required-attestation-present",
      "policy-evaluation-permits-completion",
      "replay-passes",
      "integrity-verification-passes",
      "graph-state-updated",
      "projections-regenerated",
      "recovery-point-recorded",
      "no-blocking-contradiction",
      "no-stale-dependency-evidence",
      "transition-authorized"
    ],
    "reopening_triggers": [
      "upstream-authority-changed",
      "dependency-reopened",
      "required-output-changed",
      "required-output-missing",
      "content-digest-changed",
      "semantic-digest-changed",
      "schema-changed",
      "validator-changed-materially",
      "test-failed",
      "policy-changed",
      "replay-diverged",
      "integrity-verification-failed",
      "superseding-decision-invalidated-evidence",
      "dependency-closure-changed",
      "acceptance-criteria-changed",
      "required-capability-unavailable",
      "environmental-requirement-changed",
      "migration-invalidated-output"
    ]
  },
  "quality_checkpoints": {
    "checkpoint_count": 9,
    "domains": [
      {
        "id": "checkpoint.structural-validity",
        "ordinal": 1,
        "purpose": "Confirm valid structure, syntax, schema shape, and required identity."
      },
      {
        "id": "checkpoint.semantic-correctness",
        "ordinal": 2,
        "purpose": "Confirm the implementation performs the intended semantic function."
      },
      {
        "id": "checkpoint.authority-validity",
        "ordinal": 3,
        "purpose": "Confirm every governing value has admissible authority."
      },
      {
        "id": "checkpoint.dependency-completeness",
        "ordinal": 4,
        "purpose": "Confirm dependencies and affected dependents are complete and traversable."
      },
      {
        "id": "checkpoint.deterministic-behavior",
        "ordinal": 5,
        "purpose": "Confirm equal authoritative inputs produce equal results."
      },
      {
        "id": "checkpoint.compatibility",
        "ordinal": 6,
        "purpose": "Confirm required prior behavior and interfaces remain available."
      },
      {
        "id": "checkpoint.stability",
        "ordinal": 7,
        "purpose": "Confirm regression, edge-case, stress, and repeat execution stability."
      },
      {
        "id": "checkpoint.recovery-replay",
        "ordinal": 8,
        "purpose": "Confirm rollback, reconstruction, and replay correctness."
      },
      {
        "id": "checkpoint.integration-readiness",
        "ordinal": 9,
        "purpose": "Confirm safe admission into the next higher composition."
      }
    ],
    "upgrade_comparison_requirements": [
      "prior-functional-parity",
      "no-unexplained-regressions",
      "authority-boundaries-not-weakened",
      "lineage-preserved",
      "provenance-preserved",
      "replay-not-weakened",
      "recoverability-not-weakened",
      "extensibility-not-weakened",
      "integrated-verification-passed"
    ]
  },
  "evolution_triggers": {
    "trigger_count": 54,
    "groups": [
      {
        "id": "trigger-group.authority",
        "triggers": [
          "authoritative-record-added",
          "authoritative-record-modified",
