#!/usr/bin/env python3
"""
Inspect the current Masterplan-to-Opus binding chain.

This tool is read-only. It verifies each stage's latest pointer, referenced
artifacts, readiness state, and first exact blocker.

It does not import itself, rerun stages, call providers, modify authority,
transition tasks, admit evidence, or mutate implementation.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any, Final


ROOT: Final[Path] = Path(
    "/root/savant-runtime"
).resolve()

REPORT_ROOT: Final[Path] = (
    ROOT
    / "reports"
    / "niche"
    / "masterplan"
)

STAGE_KEYS: Final[tuple[str, ...]] = (
    "agent_context",
    "opus_packet",
    "opus_queue",
    "opus_discovery",
    "opus_plan",
    "opus_workspace",
    "living_cycle",
    "provider_binding",
    "evidence_handoff",
)

STAGE_POINTERS: Final[dict[str, Path]] = {
    "agent_context": (
        REPORT_ROOT
        / "agent_context"
        / "latest.json"
    ),
    "opus_packet": (
        REPORT_ROOT
        / "opus-packets"
        / "latest.json"
    ),
    "opus_queue": (
        REPORT_ROOT
        / "opus-queue"
        / "latest.json"
    ),
    "opus_discovery": (
        REPORT_ROOT
        / "opus-binding-discovery"
        / "latest.json"
    ),
    "opus_plan": (
        REPORT_ROOT
        / "opus-binding-plan"
        / "latest.json"
    ),
    "opus_workspace": (
        REPORT_ROOT
        / "opus-binding-workspace"
        / "latest.json"
    ),
    "living_cycle": (
        REPORT_ROOT
        / "living-cycle"
        / "latest.json"
    ),
    "provider_binding": (
        REPORT_ROOT
        / "opus-provider-binding"
        / "latest.json"
    ),
    "evidence_handoff": (
        REPORT_ROOT
        / "opus-evidence-handoff"
        / "latest.json"
    ),
}

REQUIRED_REFERENCES: Final[
    dict[str, tuple[str, ...]]
] = {
    "agent_context": (),
    "opus_packet": (
        "packet",
        "manifest",
    ),
    "opus_queue": (
        "queue",
        "queue_manifest",
        "report",
        "report_manifest",
    ),
    "opus_discovery": (
        "report",
        "manifest",
    ),
    "opus_plan": (
        "plan",
        "manifest",
    ),
    "opus_workspace": (
        "workspace",
        "workspace_manifest",
        "report",
        "report_manifest",
    ),
    "living_cycle": (
        "report",
        "manifest",
    ),
    "provider_binding": (
        "binding",
        "manifest",
    ),
    "evidence_handoff": (
        "handoff",
        "manifest",
    ),
}

READY_STATES: Final[
    dict[str, tuple[str, ...]]
] = {
    "agent_context": (),
    "opus_packet": (),
    "opus_queue": (
        "queued",
        "leased",
        "running",
        "succeeded",
        "admitted",
    ),
    "opus_discovery": (
        "selected",
    ),
    "opus_plan": (
        "planned",
    ),
    "opus_workspace": (
        "ready",
    ),
    "living_cycle": (),
    "provider_binding": (
        "ready",
        "bound",
    ),
    "evidence_handoff": (
        "ready",
        "projected",
        "admitted",
    ),
}

STATE_FIELDS: Final[
    dict[str, tuple[str, ...]]
] = {
    "agent_context": (),
    "opus_packet": (),
    "opus_queue": (
        "state",
    ),
    "opus_discovery": (
        "selection_state",
        "state",
    ),
    "opus_plan": (
        "state",
    ),
    "opus_workspace": (
        "state",
    ),
    "living_cycle": (),
    "provider_binding": (
        "state",
    ),
    "evidence_handoff": (
        "state",
    ),
}


class InspectionError(RuntimeError):
    """Raised when binding-state inspection cannot complete reliably."""


@dataclass(frozen=True, slots=True)
class StageInspection:
    ordinal: int
    key: str
    latest_path: str
    latest_exists: bool
    latest_json_valid: bool
    references_valid: bool
    referenced_file_count: int
    state: str | None
    ready: bool
    passed: bool
    blocker: str | None
    digest: str | None


def canonical_json_bytes(
    value: object,
) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        + "\n"
    ).encode(
        "utf-8"
    )


def semantic_digest(
    value: object,
) -> str:
    return hashlib.sha256(
        canonical_json_bytes(
            value
        )
    ).hexdigest()


def confined_path(
    raw_path: object,
    field: str,
) -> Path:
    if not isinstance(
        raw_path,
        str,
    ):
        raise InspectionError(
            f"{field} must be a string path"
        )

    path = Path(
        raw_path
    )

    if not path.is_absolute():
        raise InspectionError(
            f"{field} must be absolute: {path}"
        )

    resolved = path.resolve(
        strict=False
    )

    try:
        resolved.relative_to(
            ROOT
        )
    except ValueError as error:
        raise InspectionError(
            f"{field} escapes runtime root: {resolved}"
        ) from error

    return resolved


def load_json(
    path: Path,
) -> dict[str, Any]:
    if not path.is_file():
        raise InspectionError(
            f"required JSON file missing: {path}"
        )

    try:
        value = json.loads(
            path.read_text(
                encoding="utf-8"
            )
        )
    except (
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as error:
        raise InspectionError(
            f"cannot load JSON {path}: {error}"
        ) from error

    if not isinstance(
        value,
        dict,
    ):
        raise InspectionError(
            f"JSON root must be an object: {path}"
        )

    return value


def derive_state(
    key: str,
    latest: dict[str, Any],
) -> str | None:
    for field in STATE_FIELDS[
        key
    ]:
        value = latest.get(
            field
        )

        if isinstance(
            value,
            str,
        ) and value:
            return value

    return None


def validate_references(
    key: str,
    latest: dict[str, Any],
) -> tuple[
    bool,
    int,
    str | None,
]:
    count = 0

    for field in REQUIRED_REFERENCES[
        key
    ]:
        raw_path = latest.get(
            field
        )

        if not isinstance(
            raw_path,
            str,
        ):
            return (
                False,
                count,
                (
                    "latest pointer lacks required "
                    f"reference field: {field}"
                ),
            )

        try:
            path = confined_path(
                raw_path,
                f"{key}.{field}",
            )
        except InspectionError as error:
            return (
                False,
                count,
                str(
                    error
                ),
            )

        if not path.is_file():
            return (
                False,
                count,
                f"referenced file missing: {path}",
            )

        count += 1

        if path.suffix.casefold() == ".json":
            try:
                load_json(
                    path
                )
            except InspectionError as error:
                return (
                    False,
                    count,
                    str(
                        error
                    ),
                )

    return (
        True,
        count,
        None,
    )


def inspect_stage(
    ordinal: int,
    key: str,
) -> StageInspection:
    latest_path = STAGE_POINTERS[
        key
    ]

    if not latest_path.is_file():
        return StageInspection(
            ordinal=ordinal,
            key=key,
            latest_path=str(
                latest_path
            ),
            latest_exists=False,
            latest_json_valid=False,
            references_valid=False,
            referenced_file_count=0,
            state=None,
            ready=False,
            passed=False,
            blocker=(
                f"latest pointer missing: {latest_path}"
            ),
            digest=None,
        )

    try:
        latest = load_json(
            latest_path
        )
    except InspectionError as error:
        return StageInspection(
            ordinal=ordinal,
            key=key,
            latest_path=str(
                latest_path
            ),
            latest_exists=True,
            latest_json_valid=False,
            references_valid=False,
            referenced_file_count=0,
            state=None,
            ready=False,
            passed=False,
            blocker=str(
                error
            ),
            digest=None,
        )

    (
        references_valid,
        referenced_file_count,
        reference_blocker,
    ) = validate_references(
        key,
        latest,
    )

    state = derive_state(
        key,
        latest,
    )

    allowed_states = READY_STATES[
        key
    ]

    blocker = reference_blocker

    if (
        blocker is None
        and allowed_states
        and state not in allowed_states
    ):
        blocker = (
            f"stage state is not ready: {state!r}; "
            f"expected one of {allowed_states}"
        )

    if (
        blocker is None
        and latest.get(
            "passed"
        )
        is False
    ):
        blocker = "stage reports passed=false"

    ready = (
        blocker is None
    )

    return StageInspection(
        ordinal=ordinal,
        key=key,
        latest_path=str(
            latest_path
        ),
        latest_exists=True,
        latest_json_valid=True,
        references_valid=references_valid,
        referenced_file_count=(
            referenced_file_count
        ),
        state=state,
        ready=ready,
        passed=ready,
        blocker=blocker,
        digest=semantic_digest(
            latest
        ),
    )


def inspect_chain() -> dict[str, Any]:
    stages: list[
        StageInspection
    ] = []

    first_blocker: str | None = None

    for ordinal, key in enumerate(
        STAGE_KEYS,
        start=1,
    ):
        stage = inspect_stage(
            ordinal,
            key,
        )

        stages.append(
            stage
        )

        if not stage.passed:
            first_blocker = (
                f"{key}: {stage.blocker}"
            )

            break

    chain_complete = (
        len(
            stages
        )
        == len(
            STAGE_KEYS
        )
        and all(
            stage.passed
            for stage in stages
        )
    )

    next_stage = (
        None
        if chain_complete
        else stages[
            -1
        ].key
    )

    result: dict[str, Any] = {
        "operation": (
            "inspect_masterplan_opus_binding_state"
        ),
        "passed": True,
        "chain_complete": chain_complete,
        "stage_count": len(
            STAGE_KEYS
        ),
        "inspected_stage_count": len(
            stages
        ),
        "first_blocker": first_blocker,
        "next_stage": next_stage,
        "authority_effect": "none",
        "provider_calls_performed": False,
        "implementation_mutation_performed": False,
        "stages": [
            asdict(
                stage
            )
            for stage in stages
        ],
    }

    result[
        "semantic_digest"
    ] = semantic_digest(
        {
            key: value
            for key, value
            in result.items()
            if key != "semantic_digest"
        }
    )

    return result


def print_human(
    result: dict[str, Any],
) -> None:
    print(
        "chain complete:",
        result[
            "chain_complete"
        ],
    )

    print(
        "inspected stages:",
        result[
            "inspected_stage_count"
        ],
        "/",
        result[
            "stage_count"
        ],
    )

    print(
        "first blocker:",
        result[
            "first_blocker"
        ],
    )

    print(
        "next stage:",
        result[
            "next_stage"
        ],
    )

    for stage in result[
        "stages"
    ]:
        print()

        print(
            f"{stage['ordinal']}. "
            f"{stage['key']}"
        )

        print(
            "latest:",
            stage[
                "latest_path"
            ],
        )

        print(
            "state:",
            stage[
                "state"
            ],
        )

        print(
            "references:",
            stage[
                "referenced_file_count"
            ],
        )

        print(
            "ready:",
            stage[
                "ready"
            ],
        )

        if stage[
            "blocker"
        ]:
            print(
                "blocker:",
                stage[
                    "blocker"
                ],
            )


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Inspect the current Masterplan-to-Opus "
            "binding chain."
        )
    )

    parser.add_argument(
        "--json",
        action="store_true",
    )

    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()

    try:
        result = inspect_chain()

        if arguments.json:
            print(
                json.dumps(
                    result,
                    indent=2,
                    sort_keys=True,
                )
            )
        else:
            print_human(
                result
            )

        return 0

    except InspectionError as error:
        print(
            json.dumps(
                {
                    "operation": (
                        "inspect_masterplan_opus_binding_state"
                    ),
                    "passed": False,
                    "authority_effect": "none",
                    "provider_calls_performed": False,
                    "implementation_mutation_performed": False,
                    "error": str(
                        error
                    ),
                },
                indent=2,
                sort_keys=True,
            ),
            file=sys.stderr,
        )

        return 1


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
