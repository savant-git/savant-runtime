# Copy to a protected service-manager environment file outside the repository.
# Set permissions to 0600 and never commit the populated file.

PALAVER_API_TOKEN=replace-with-a-long-random-token
PALAVER_ALLOWED_ORIGINS=http://127.0.0.1:5173
PALAVER_HOST=127.0.0.1
PALAVER_PORT=8787
PALAVER_MAX_CONTENT_LENGTH=65536
PALAVER_MAX_TEXT_LENGTH=12000
PALAVER_REQUEST_TIMEOUT_SECONDS=30

# Configure one or both providers at runtime.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Envoy runtime contained within this deployment.
ENVOY_RUNTIME_PATH=
