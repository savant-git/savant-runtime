{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "savant://runtime/living-substrates/binding/1.0.0",
  "title": "Savant Living Substrate Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "owner_id",
    "slot",
    "substrate",
    "substrate_instance",
    "authority_state",
    "enabled",
    "version",
    "specialization",
    "parameters",
    "dependencies",
    "lineage",
    "provenance",
    "compatibility"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "enum": [
        "structure",
        "interface",
        "memory",
        "authority",
        "exchange",
        "assurance",
        "evolution",
        "derivation",
        "execution"
      ]
    },
    "substrate": {
      "enum": [
        "scyon",
        "splyce",
        "scrybe",
        "pryme",
        "cypher",
        "thryce",
        "spyral",
        "lythe",
        "dryve"
      ]
    },
    "substrate_instance": {
      "type": "string",
      "minLength": 1
    },
    "authority_state": {
      "enum": [
        "observed",
        "proposed",
        "provisional",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "specialization": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "focal": {
          "type": [
            "string",
            "null"
          ]
        },
        "overlay": {
          "type": [
            "string",
            "null"
          ]
        },
        "mask": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "superseded_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "minimum_substrate_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "reversible": {
          "type": "boolean"
        }
      }
    }
  }
}
