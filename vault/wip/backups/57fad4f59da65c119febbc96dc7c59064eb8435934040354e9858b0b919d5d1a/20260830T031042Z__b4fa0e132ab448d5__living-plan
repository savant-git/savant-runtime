def add(
    semantic_id: str,
    text: str,
    status: str,
    priority: int,
    dependencies: list[str],
    *,
    source: list[str],
) -> dict[str, Any]:
    if semantic_id in by_id():
        raise ValueError(
            (
                "masterplan record already "
                "exists: "
                + semantic_id
            )
        )

    event = assert_record(
        stream=stream,
        semantic_id=semantic_id,
        text=text,
        authority=
            "current_user_directive",
        priority=priority,
        status=status,
        supersedes=[],
        dependencies=dependencies,
        relationships=[],
        asserted_by="user",
        source=source,
    )

    return {
        "added":
            semantic_id,

        "event":
            event,

        "progress":
            progress(),
    }


def export() -> dict[str, Any]:
    projection_status = project()

    values = records()

    reverse = reverse_dependencies(
        values
    )

    return {
        "schema":
            "savant.living-plan.export.v1",

        "stream":
            stream,

        "progress":
            progress(),

        "ready":
            [
                record[
                    "id"
                ]
                for record
                in ready_records()
            ],

        "records":
            values,

        "reverse_dependencies":
            reverse,

        "governance":
            projection_status,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="living-plan",
        description=(
            "operational interface over the "
            "authoritative living masterplan stream"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    show_parser = subparsers.add_parser(
        "show"
    )

    show_parser.add_argument(
        "id",
        nargs="?",
    )

    subparsers.add_parser(
        "progress"
    )

    subparsers.add_parser(
        "ready"
    )

    impact_parser = subparsers.add_parser(
        "impact"
    )

    impact_parser.add_argument(
        "id"
    )

    status_parser = subparsers.add_parser(
        "status"
    )

    status_parser.add_argument(
        "id"
    )

    status_parser.add_argument(
        "status"
    )

    status_parser.add_argument(
        "--source",
        action="append",
        default=[
            "living-plan-cli"
        ],
    )

    text_parser = subparsers.add_parser(
        "update"
    )

    text_parser.add_argument(
        "id"
    )

    text_parser.add_argument(
        "text"
    )

    text_parser.add_argument(
        "--source",
        action="append",
        default=[
            "living-plan-cli"
        ],
    )

    add_parser = subparsers.add_parser(
        "add"
    )

    add_parser.add_argument(
        "id"
    )

    add_parser.add_argument(
        "text"
    )

    add_parser.add_argument(
        "--status",
        default="planned"
    )

    add_parser.add_argument(
        "--priority",
        type=int,
        default=1000,
    )

    add_parser.add_argument(
        "--dependency",
        action="append",
        default=[],
    )

    add_parser.add_argument(
        "--source",
        action="append",
        default=[
            "living-plan-cli"
        ],
    )

    subparsers.add_parser(
        "export"
    )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "show":
            output = show(
                args.id
            )

        elif args.command == "progress":
            output
