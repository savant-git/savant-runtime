    ".key",
    ".crt",
    ".cer",
    ".p12",
    ".pfx",
    ".pdf",
    ".mht",
    ".mhtml",
    ".map"
  ],
  "exclude_patterns": [
    "source/**",
    "exports/**",
    "audit/**",
    "_reports/**",
    "repair_backups/**",
    "relics/**",

    "imports/**",
    "s3_downloads/**",

    "runtime/reports/**",
    "runtime/living-state/**",
    "runtime/living-fabric/**",

    "canon-system/projections/**",
    "canon-system/runtime/**",

    "authority/task-graph/snapshots/**",

    "assurance/structure-intelligence/**",

    "evolution/structure-migration/**",

    "migrations/**",

    "vault/wip/receipts/**",
    "vault/kindred-preview/**",
    "vault/**/kindred-preview/**",

    "**/snapshots/**",
    "**/backups/**",
    "**/archives/**",
    "**/archive/**",

    "**/before-*/*",
    "**/before_*/*",
    "**/pre-*/*",
    "**/pre_*/*",
    "**/broken_*/*",

    "**/*.log",

    ".venv*/**",
    "**/.venv*/**",
    "**/__pycache__/**",

    "current_runtime_source_dump_*",
    "**/current_runtime_source_dump_*",

    "**/sdump-*/*",
    "**/sdump_*.txt"
  ],
  "secret_file_patterns": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "credentials.json",
    "secrets.*",
    "*secret*",
    "id_rsa",
    "id_ed25519"
  ],
  "max_file_bytes": 1048576,
  "max_total_content_bytes": 25165824,
  "max_files": 100000,
  "include_tree": false,
  "include_inventory": false,
  "respect_gitignore": true,
  "redact_secrets": true,
  "follow_symlinks": false
}
