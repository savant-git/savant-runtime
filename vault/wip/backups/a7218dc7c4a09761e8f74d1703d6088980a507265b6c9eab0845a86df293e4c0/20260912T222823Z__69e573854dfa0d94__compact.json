{
  "id": "compact",
  "description": "Current Savant source, canon, configuration, and authoritative text surfaces. Historical generations, receipts, archives, imported material, generated projections, bulky derivatives, caches, and replayable evidence are excluded.",
  "include_extensions": [
    ".py",
    ".pyi",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".mts",
    ".cts",
    ".go",
    ".rs",
    ".java",
    ".kt",
    ".kts",
    ".c",
    ".cc",
    ".cpp",
    ".cxx",
    ".h",
    ".hh",
    ".hpp",
    ".hxx",
    ".cs",
    ".rb",
    ".php",
    ".lua",
    ".pl",
    ".r",
    ".sh",
    ".bash",
    ".zsh",
    ".fish",
    ".ps1",
    ".sql",
    ".graphql",
    ".gql",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg",
    ".conf",
    ".md",
    ".markdown",
    ".txt",
    ".rst",
    ".html",
    ".htm",
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".vue",
    ".svelte",
    ".xml",
    ".xsd",
    ".tf",
    ".tfvars",
    ".gradle",
    ".properties"
  ],
  "include_filenames": [
    "dockerfile",
    "containerfile",
    "makefile",
    "procfile",
    "rakefile",
    "gemfile",
    "pipfile",
    "justfile",
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml",
    "pyproject.toml",
    "requirements.txt",
    "package.json",
    "cargo.toml",
    "go.mod",
    "pom.xml",
    "build.gradle",
    "settings.gradle",
    "composer.json",
    "deno.json",
    "bunfig.toml"
  ],
  "canon_path_names": [
    "canon",
    "lexicon",
    "ontology",
    "registry",
    "memory",
    "corpus",
    "shards",
    "prompts",
    "personas"
  ],
  "exclude_dir_names": [
    ".git",
    ".hg",
    ".svn",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".hypothesis",
    ".tox",
    ".nox",
    ".cache",
    ".next",
    ".nuxt",
    ".svelte-kit",
    ".turbo",
    ".vercel",
    ".parcel-cache",
    ".vite",
    ".transfer",
    "node_modules",
    "vendor",
    "dist",
    "build",
    "coverage",
    "target",
    "out",
    "obj",
    "venv",
    ".venv",
    "env",
    "tmp",
    "temp",
    "repair_backups",
    "relics",
    "snapshots",
    "backups",
    "archives"
  ],
  "exclude_file_names": [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "bun.lock",
    "bun.lockb",
    "cargo.lock",
    "poetry.lock",
    "pipfile.lock",
    "composer.lock",
    "gemfile.lock",
    "credentials.json",
    "id_rsa",
    "id_ed25519",
    "cache.json",
    "current.json",
    "health.json",
    "history.jsonl",
    "journal.jsonl",
    "receipt.json",
    "engine.lock"
  ],
  "exclude_extensions": [
    ".jsonl",
    ".zip",
    ".tar",
    ".gz",
    ".tgz",
    ".bz2",
    ".xz",
    ".7z",
    ".rar",
    ".zst",
    ".bak",
    ".old",
    ".orig",
    ".backup",
    ".save",
    ".tmp",
    ".swp",
    ".swo",
    ".db",
    ".sqlite",
    ".sqlite3",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".svg",
    ".ico",
    ".bmp",
    ".tiff",
    ".mp3",
    ".wav",
    ".flac",
    ".ogg",
    ".m4a",
    ".mp4",
    ".mov",
    ".webm",
    ".avi",
    ".mkv",
    ".ttf",
    ".otf",
    ".woff",
    ".woff2",
    ".eot",
    ".pyc",
    ".pyo",
    ".class",
    ".o",
    ".obj",
    ".so",
    ".dll",
    ".dylib",
    ".exe",
