#!/usr/bin/env bash
set -euo pipefail

PALAVER_ROOT="/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/palaver"
PALAVER_RUNTIME="${PALAVER_ROOT}/runtime"
SAVANT_ROOT="/root/savant-runtime"
SAVANT_ENV="${SAVANT_ROOT}/.env"
ROOT_ENV="/root/.env"

if [ -f "$ROOT_ENV" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_ENV"
  set +a
fi

if [ -f "$SAVANT_ENV" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$SAVANT_ENV"
  set +a
fi

COMMAND="${1:-serve}"

case "$COMMAND" in
  inspect)
    exec python3 \
      "${PALAVER_RUNTIME}/deployment.py" \
      inspect
    ;;

  check)
    exec python3 \
      "${PALAVER_RUNTIME}/deployment.py" \
      check
    ;;

  integration-inspect)
    cd "$SAVANT_ROOT"
    exec python3 \
      "${PALAVER_RUNTIME}/transport_integration.py" \
      --inspect
    ;;

  serve)
    cd "$SAVANT_ROOT"
    exec python3 \
      "${PALAVER_RUNTIME}/transport_integration.py"
    ;;

  *)
    printf '%s\n' \
      "usage: palaver-enterprise {inspect|check|integration-inspect|serve}" \
      >&2
    exit 2
    ;;
esac
