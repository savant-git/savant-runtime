def normalized_path(
    value: str,
) -> Path:
    return Path(
        os.path.abspath(
            value
        )
    )


def result(
    check_id: str,
    passed: bool,
    *,
    severity: str = "error",
    message: str,
    evidence: Any = None,
) -> dict[str, Any]:
    payload = {
        "check":
            check_id,

        "passed":
            bool(
                passed
            ),

        "severity":
            severity,

        "message":
            message,
    }

    if evidence is not None:
        payload[
            "evidence"
        ] = evidence

    return payload


def check_absolute_path(
    path: str,
) -> dict[str, Any]:
    passed = Path(
        path
    ).is_absolute()

    return result(
        "absolute-path",
        passed,
        message=(
            "path is absolute"
            if passed
            else "savant implementation paths must be absolute"
        ),
        evidence=path,
    )


def check_runtime_root(
    path: str,
) -> dict[str, Any]:
    candidate = normalized_path(
        path
    )

    try:
        candidate.relative_to(
            root
        )

        passed = True

    except ValueError:
        passed = False

    return result(
        "runtime-root",
        passed,
        message=(
            "path is within the canonical savant runtime"
            if passed
            else (
                "path is outside /root/savant-runtime; "
                "stronger authority is required"
            )
        ),
        evidence=str(
            candidate
        ),
    )


