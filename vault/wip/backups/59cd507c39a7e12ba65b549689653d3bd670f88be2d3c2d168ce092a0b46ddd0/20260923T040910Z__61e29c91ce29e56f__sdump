#!/usr/bin/env python3

from __future__ import annotations

import sys


runtime_path = (
    "/root/savant-runtime/runtime"
)

sdump_path = (
    "/root/savant-runtime/"
    "tools/sdump-enterprise"
)

for path in (
    sdump_path,
    runtime_path,
):
    if path not in sys.path:
        sys.path.insert(
            0,
            path,
        )


from sdump_enterprise.stream_dump import (
    StreamDumpError,
    main,
)


try:
    raise SystemExit(
        main()
    )

except (
    StreamDumpError,
    RuntimeError,
    OSError,
) as error:
    print(
        f"sdump error: {error}",
        file=sys.stderr,
    )

    raise SystemExit(
        1
    )
