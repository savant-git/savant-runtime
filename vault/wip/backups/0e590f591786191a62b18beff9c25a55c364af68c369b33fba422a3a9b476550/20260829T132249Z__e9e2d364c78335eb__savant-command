#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import sys
from typing import Any


registry_path = Path(
    "/root/savant-runtime/tools/commands/registry.json"
)


def load_registry() -> dict[str, Any]:
    try:
        value = json.loads(
            registry_path.read_text(
                encoding="utf-8"
            )
        )

    except (
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as error:
        raise RuntimeError(
            f"registry unavailable: {error}"
        ) from error

    if not isinstance(value, dict):
        raise RuntimeError(
            "registry root must be an object"
        )

    return value


def commands(
    registry: dict[str, Any],
) -> dict[str, Any]:
    value = registry.get(
        "commands",
        {}
    )

    if not isinstance(value, dict):
        raise RuntimeError(
            "registry commands must be an object"
        )

    return value


def show_all(
    entries: dict[str, Any],
) -> None:
    for name in sorted(entries):
        entry = entries[name]

        if not isinstance(entry, dict):
            continue

        description = str(
            entry.get(
                "description",
                ""
            )
        )

        target = entry.get(
            "target"
        )

        if target:
            print(
                f"{name}  {description}  -> {target}"
            )
        else:
            print(
                f"{name}  {description}"
            )


def show_one(
    entries: dict[str, Any],
    name: str,
) -> int:
    entry = entries.get(name)

    if not isinstance(entry, dict):
        print(
            f"unknown savant command: {name}",
            file=sys.stderr,
        )
        return 1

    print(
        json.dumps(
            {
                "command": name,
                **entry,
            },
            ensure_ascii=False,
            sort_keys=True,
            indent=2,
        )
    )

    return 0


def check(
    registry: dict[str, Any],
    entries: dict[str, Any],
) -> int:
    required_length = int(
        registry.get(
            "command_length",
            3,
        )
    )

    failed = False

    for name in sorted(entries):
        if (
            len(name) != required_length
            or name != name.casefold()
            or not name.isalnum()
        ):
            print(
                f"invalid: {name}",
                file=sys.stderr,
            )
            failed = True

        external = shutil.which(
            name
        )

        if external:
            print(
                f"collision: {name} -> {external}",
                file=sys.stderr,
            )
            failed = True

    if failed:
        return 1

    print(
        "savant command registry: valid"
    )

    return 0


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(
        prog="savant-command"
    )

    value.add_argument(
        "command",
        nargs="?",
    )

    value.add_argument(
        "--check",
        action="store_true",
    )

    return value


def main() -> int:
    try:
        registry = load_registry()
        entries = commands(registry)

    except RuntimeError as error:
        print(
            f"savant-command: {error}",
            file=sys.stderr,
        )
        return 1

    arguments = parser().parse_args()

    if arguments.check:
        return check(
            registry,
            entries,
        )

    if arguments.command:
        return show_one(
            entries,
            arguments.command,
        )

    show_all(entries)
    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )x
