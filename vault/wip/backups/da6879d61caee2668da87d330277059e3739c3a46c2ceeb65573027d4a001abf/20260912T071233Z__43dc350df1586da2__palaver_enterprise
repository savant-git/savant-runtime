#!/usr/bin/env bash
set -euo pipefail

PALAVER_ROOT="/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/palaver"
RUNTIME="$PALAVER_ROOT/runtime"

OPUS_COMPAT="$RUNTIME/opus_router_package_compat.py"
ENVOY_COMPAT="$RUNTIME/envoy_runtime_package_compat.py"
ENTRYPOINT="$RUNTIME/server_enterprise.py"

if [ ! -f "$OPUS_COMPAT" ]; then
    echo "[ERROR] Palaver Opus compatibility runtime missing: $OPUS_COMPAT" >&2
    exit 1
fi

if [ ! -f "$ENVOY_COMPAT" ]; then
    echo "[ERROR] Palaver Envoy compatibility runtime missing: $ENVOY_COMPAT" >&2
    exit 1
fi

if [ ! -f "$ENTRYPOINT" ]; then
    echo "[ERROR] Palaver enterprise entrypoint missing: $ENTRYPOINT" >&2
    exit 1
fi

exec python3 -c '
import importlib.util
import runpy
import sys


def load(name, path):
    spec = importlib.util.spec_from_file_location(
        name,
        path,
    )

    if spec is None or spec.loader is None:
        raise RuntimeError(
            f"unable to construct compatibility import: {path}"
        )

    module = importlib.util.module_from_spec(
        spec
    )

    sys.modules[
        name
    ] = module

    spec.loader.exec_module(
        module
    )

    return module


opus_path = sys.argv[1]
envoy_path = sys.argv[2]
entrypoint = sys.argv[3]

opus = load(
    "savant_palaver_opus_runtime_package_compat",
    opus_path,
)

opus_status = opus.install()

if not opus_status.get("installed"):
    raise RuntimeError(
        "Palaver Opus runtime compatibility installation failed"
    )

envoy = load(
    "savant_palaver_envoy_runtime_package_compat",
    envoy_path,
)

envoy_status = envoy.install()

if not envoy_status.get("installed"):
    raise RuntimeError(
        "Palaver Envoy runtime compatibility installation failed"
    )

sys.argv = [
    entrypoint,
    *sys.argv[4:],
]

runpy.run_path(
    entrypoint,
    run_name="__main__",
)
' "$OPUS_COMPAT" "$ENVOY_COMPAT" "$ENTRYPOINT" "$@"
