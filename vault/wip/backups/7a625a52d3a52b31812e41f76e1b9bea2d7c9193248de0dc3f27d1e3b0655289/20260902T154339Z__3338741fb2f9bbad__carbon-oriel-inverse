#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel_inverse import (  # noqa: E402
    capability_manifest,
    engine,
    oriel_inverse_error,
    selftest,
    status,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_object(
    path: str,
) -> dict[str, Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "input must be a JSON object"
        )

    return value


def csv_values(
    value: str | None,
) -> list[str]:
    if value is None:
        return []

    return [
        item.strip()
        for item
        in value.split(
            ","
        )
        if item.strip()
    ]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-inverse",
        description=(
            "Carbon-owned inverse chronology "
            "and logistics search"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "capabilities"
    )

    subparsers.add_parser(
        "selftest"
    )

    search_parser = (
        subparsers.add_parser(
            "search"
        )
    )

    search_parser.add_argument(
        "--oriel",
        required=True,
    )

    search_parser.add_argument(
        "--desired-event",
        required=True,
    )

    search_parser.add_argument(
        "--mode",
        default="tour_bus",
    )

    search_parser.add_argument(
        "--candidate-locations"
    )

    search_parser.add_argument(
        "--transport-modes"
    )

    search_parser.add_argument(
        "--policy"
    )

    explain_parser = (
        subparsers.add_parser(
            "explain"
        )
    )

    explain_parser.add_argument(
        "result"
    )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "capabilities":
            output = capability_manifest()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "search":
            policy = (
                read_object(
                    args.policy
                )
                if args.policy
                else None
            )

            output = engine.search(
                read_object(
                    args.oriel
                ),
                read_object(
                    args.desired_event
                ),
                mode=args.mode,
                candidate_locations=
                    csv_values(
                        args.candidate_locations
                    ),
                transport_modes=
                    csv_values(
                        args.transport_modes
                    ),
                policy=policy,
            )

        elif args.command == "explain":
            output = engine.explain(
                read_object(
                    args.result
                )
            )

        else:
            parser.error(
                "unknown command"
            )

            return 2

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_error,
        oriel_inverse_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and output.get(
            "ok"
        )
        is False
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
