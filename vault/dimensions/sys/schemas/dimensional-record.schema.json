{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "savant://vault/dimensions/schemas/dimensional-record/1.3.0",
  "title": "Savant Dimensional Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "record_id",
    "dimension",
    "canon",
    "state",
    "claims",
    "unknowns",
    "contradictions",
    "lineage",
    "provenance",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "savant://vault/dimensions/record/1.3.0"
    },
    "version": {
      "const": "1.3.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "ordinal"
      ],
      "properties": {
        "key": {
          "enum": [
            "context",
            "motive",
            "proof",
            "seed",
            "sense",
            "signal",
            "trajectory",
            "affinity"
          ]
        },
        "name": {
          "enum": [
            "Context",
            "Motive",
            "Proof",
            "Seed",
            "Sense",
            "Signal",
            "Trajectory",
            "Affinity"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        }
      }
    },
    "canon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "absolute_path",
        "sha256",
        "size",
        "modified_ns"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "absolute_path": {
          "type": "string",
          "pattern": "^/root/savant-runtime/vault/dimensions/canon/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensional",
        "admission",
        "authority",
        "generated_at"
      ],
      "properties": {
        "dimensional": {
          "enum": [
            "unresolved",
            "partial",
            "resolved"
          ]
        },
        "admission": {
          "enum": [
            "unadmitted",
            "candidate",
            "admitted",
            "rejected",
            "superseded"
          ]
        },
        "authority": {
          "enum": [
            "none",
            "observational",
            "evidentiary",
            "interpretive",
            "prospective",
            "historical",
            "mixed",
            "authoritative"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted",
        "candidate"
      ],
      "properties": {
        "admitted": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "candidate": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_digest",
        "generator",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generator": {
          "const": "/root/savant-runtime/vault/dimensions/sys/scaffold.py"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source"
      ],
      "properties": {
        "method": {
          "const": "deterministic-dimensional-scaffold"
        },
        "source": {
          "type": "string",
          "pattern": "^savant://vault/dimensions/canon/"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_exists",
        "digest_matches",
        "schema_valid",
        "authority_manufactured"
      ],
      "properties": {
        "canon_exists": {
          "type": "boolean"
        },
        "digest_matches": {
          "type": "boolean"
        },
        "schema_valid": {
          "type": "boolean"
        },
        "authority_manufactured": {
          "const": false
        }
      }
    }
  }
}
