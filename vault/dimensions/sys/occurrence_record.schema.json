
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Occurrence Record",
  "type":"object",
  "required":[
    "id",
    "class",
    "path",
    "line",
    "column",
    "text"
  ],
  "properties":{
    "id":{"type":"string"},
    "class":{"type":"string"},
    "path":{"type":"string"},
    "line":{"type":"integer"},
    "column":{"type":"integer"},
    "text":{"type":"string"},
    "reason":{"type":"string"},
    "mutable":{"type":"boolean"}
  }
}
