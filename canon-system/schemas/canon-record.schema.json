{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savant.local/schema/canon-record.schema.json",
  "title": "Savant Canon Record",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "version",
    "authority",
    "future_slots",
    "open_questions",
    "lineage",
    "provenance",
    "dependencies",
    "relationships",
    "attachments"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "provisional",
        "candidate",
        "accepted",
        "canonical",
        "axiomatic",
        "immutable",
        "deprecated",
        "superseded",
        "rejected"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "state",
        "tier",
        "confidence"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "future_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "dependencies": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "attachments": {
      "type": "array"
    }
  },
  "additionalProperties": true
}