{
  "id": "audit",
  "description": "Comprehensive secret-safe authoritative source projection for audit evidence, including dependency manifests and lockfiles while excluding generated, binary, cache, credential, and dependency trees.",
  "include_extensions": [
    ".py", ".pyi", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts", ".go", ".rs", ".java", ".kt", ".kts", ".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".cs", ".rb", ".php", ".lua", ".pl", ".r", ".sh", ".bash", ".zsh", ".fish", ".ps1", ".sql", ".graphql", ".gql", ".json", ".jsonl", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".md", ".markdown", ".txt", ".rst", ".html", ".htm", ".css", ".scss", ".sass", ".less", ".vue", ".svelte", ".xml", ".xsd", ".tf", ".tfvars", ".gradle", ".properties", ".csv", ".tsv", ".lock"
  ],
  "include_filenames": [
    "dockerfile", "containerfile", "makefile", "procfile", "rakefile", "gemfile", "gemfile.lock", "pipfile", "pipfile.lock", "justfile", "compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml", "pyproject.toml", "requirements.txt", "requirements-dev.txt", "package.json", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "bun.lock", "bun.lockb", "cargo.toml", "cargo.lock", "go.mod", "go.sum", "pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "gradle.lockfile", "composer.json", "composer.lock", "deno.json", "bunfig.toml", "poetry.lock", "pdm.lock", "uv.lock"
  ],
  "canon_path_names": ["canon", "lexicon", "ontology", "registry", "memory", "corpus", "shards", "prompts", "personas", "authority", "lineage", "graph"],
  "exclude_dir_names": [".git", ".hg", ".svn", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox", ".nox", ".cache", ".next", ".nuxt", ".svelte-kit", ".turbo", ".vercel", ".parcel-cache", ".vite", "node_modules", "vendor", "dist", "build", "coverage", "target", "out", "obj", "venv", ".venv", "env", "tmp", "temp"],
  "exclude_file_names": ["credentials.json", "id_rsa", "id_ed25519"],
  "exclude_extensions": [".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".zst", ".db", ".sqlite", ".sqlite3", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".bmp", ".tiff", ".mp3", ".wav", ".flac", ".ogg", ".m4a", ".mp4", ".mov", ".webm", ".avi", ".mkv", ".ttf", ".otf", ".woff", ".woff2", ".eot", ".pyc", ".pyo", ".class", ".o", ".obj", ".so", ".dll", ".dylib", ".exe", ".pem", ".key", ".crt", ".cer", ".p12", ".pfx", ".pdf", ".mht", ".mhtml"],
  "exclude_patterns": ["source/**", "exports/**", "audit/**", "_reports/**", "repair_backups/**", "relics/**", "imports/source-dumps/**", "imports/**/source-dumps/**", "vault/kindred-preview/**", "vault/**/kindred-preview/**", ".venv*/**", "**/.venv*/**", "**/__pycache__/**", "**/sdump-*/*", "**/sdump_*.txt"],
  "secret_file_patterns": [".env", ".env.*", "*.pem", "*.key", "credentials.json", "secrets.*", "*secret*", "id_rsa", "id_ed25519"],
  "max_file_bytes": 8388608,
  "max_total_content_bytes": 1073741824,
  "max_files": 300000,
  "include_tree": true,
  "include_inventory": true,
  "respect_gitignore": false,
  "redact_secrets": true,
  "follow_symlinks": false
}
