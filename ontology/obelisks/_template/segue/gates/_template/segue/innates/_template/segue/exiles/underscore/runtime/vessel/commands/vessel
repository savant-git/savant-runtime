#!/usr/bin/env bash
set -euo pipefail

vessel_root="/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/underscore/runtime/vessel"
python_bin="${vessel_root}/venv/bin/python"
engine="${vessel_root}/vessel.py"

if [[ ! -x "${python_bin}" ]]; then
    printf '%s\n' \
        "underscore vessel python is unavailable: ${python_bin}" \
        >&2
    exit 1
fi

if [[ ! -f "${engine}" ]]; then
    printf '%s\n' \
        "underscore vessel runtime is unavailable: ${engine}" \
        >&2
    exit 1
fi

exec "${python_bin}" "${engine}" "$@"
