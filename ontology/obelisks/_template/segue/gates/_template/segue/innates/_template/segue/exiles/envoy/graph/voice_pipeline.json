{
  "id": "envoy:voice_pipeline",
  "type": "runtime_pipeline",
  "owner": "envoy",
  "conversation_owner": "palaver",
  "persona_owner": "envoy",
  "voice_owner": "envoy",
  "provider_execution_owner": "opus",
  "route": "voice_tts_route",
  "persona_precedence": [
    "request",
    "workspace",
    "default"
  ],
  "stages": [
    {
      "id": "persona_resolution",
      "owner": "envoy",
      "operation": "resolve_persona"
    },
    {
      "id": "voice_resolution",
      "owner": "envoy",
      "operation": "resolve_voice"
    },
    {
      "id": "provider_execution",
      "owner": "opus",
      "operation": "synthesize"
    },
    {
      "id": "audio_projection",
      "owner": "envoy",
      "transport": "base64",
      "format_source": "mime_type"
    },
    {
      "id": "conversation_projection",
      "owner": "palaver",
      "endpoint": "/api/voice/synthesize"
    }
  ]
}
