{
  "id": "opus_voice_orchestration_contract",
  "type": "runtime_contract",
  "status": "active",
  "owner": "envoy",
  "provider": "opus",
  "consumer": "envoy",
  "route": "voice_tts_route",
  "purpose": "Envoy resolves persona and voice intent while Opus exclusively owns external provider orchestration and execution.",
  "flow": [
    "envoy.resolve_persona",
    "envoy.resolve_voice_profile",
    "envoy.emit_voice_intent",
    "opus.select_provider",
    "opus.route_provider",
    "opus.access_provider_credentials",
    "opus.execute_provider",
    "opus.apply_retry_policy",
    "opus.apply_fallback_policy",
    "envoy.project_provider_output",
    "envoy.attach_voice_metadata"
  ],
  "authority": {
    "persona_identity_owner": "envoy",
    "persona_resolution_owner": "envoy",
    "voice_identity_owner": "envoy",
    "voice_resolution_owner": "envoy",
    "voice_intent_owner": "envoy",
    "provider_selection_owner": "opus",
    "provider_routing_owner": "opus",
    "provider_credentials_owner": "opus",
    "provider_execution_owner": "opus",
    "provider_retry_policy_owner": "opus",
    "provider_fallback_policy_owner": "opus"
  },
  "constraints": {
    "envoy_may_select_provider": false,
    "envoy_may_route_provider": false,
    "envoy_may_access_provider_credentials": false,
    "envoy_may_execute_provider_calls": false,
    "envoy_may_define_provider_retry_policy": false,
    "envoy_may_define_provider_fallback_policy": false,
    "authority_transfer": false
  },
  "rule": "Envoy owns persona and voice identity and intent. Opus owns provider selection, routing, credentials, execution, retry policy, and fallback policy."
}
