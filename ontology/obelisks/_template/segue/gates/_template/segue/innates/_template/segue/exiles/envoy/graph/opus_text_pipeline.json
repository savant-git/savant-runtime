{
  "id": "envoy:opus_text_pipeline",
  "type": "runtime_dependency",
  "source": "exile:envoy",
  "target": "exile:opus",
  "relation": "delegates_provider_execution_to",
  "route": "text_inference_route",
  "bridge_schema": "savant.envoy.opus-text-bridge.v1",
  "flow": [
    "envoy.emit_text_request",
    "opus.execute_text_request",
    "opus.attach_execution_lineage",
    "envoy.accept_authority_bounded_result"
  ],
  "authority": {
    "request_owner": "envoy",
    "provider_selection": "opus",
    "provider_routing": "opus",
    "provider_credentials": "opus",
    "provider_execution": "opus",
    "provider_retry_policy": "opus",
    "provider_fallback_policy": "opus"
  },
  "required_lineage": {
    "owner": "opus",
    "route": "text_inference_route"
  },
  "envoy_permissions": {
    "select_provider": false,
    "access_provider_credentials": false,
    "execute_provider_calls": false,
    "define_provider_retry_policy": false,
    "define_provider_fallback_policy": false
  }
}
