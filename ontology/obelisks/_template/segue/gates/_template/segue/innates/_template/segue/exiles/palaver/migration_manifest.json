{
  "schema": "savant.palaver.migration-manifest.v1",
  "identity": "exile:palaver",
  "runtime_root": "/root/savant-runtime",
  "palaver_root": "/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/palaver",
  "canonical_entrypoint": "runtime/server.py",
  "legacy_implementation": "apps/webui_ultra/server.py",
  "launcher": "commands/palaver_ultra",
  "network": {
    "default_bind_host": "127.0.0.1",
    "observed_port": 8787,
    "frontend_bind_host": "0.0.0.0",
    "frontend_port": 5173,
    "tunnel_target": "http://127.0.0.1:5173",
    "nginx_integration_observed": false
  },
  "authority": {
    "identity": "exile:palaver",
    "conversation_owner": "palaver",
    "workspace_owner": "palaver",
    "persona_owner": "envoy",
    "provider_owner": "opus",
    "task_owner": "niche",
    "memory_context_owner": "scrybe",
    "canonical_memory_store": "fluid-canon",
    "mutation_owner": "coda",
    "patch_review_owner": "palaver",
    "default_persona": "orobouros",
    "persona_precedence": [
      "request",
      "workspace",
      "default"
    ]
  },
  "required_files": [
    "runtime/server.py",
    "runtime/coda_bridge.py",
    "runtime/direct_command_bridge.py",
    "runtime/envoy_bridge.py",
    "runtime/niche_bridge.py",
    "runtime/opus_bridge.py",
    "runtime/patch_review_bridge.py",
    "runtime/scrybe_bridge.py",
    "apps/webui_ultra/server.py",
    "commands/palaver_ultra"
  ],
  "external_runtime_files": [
    "/root/savant-runtime/runtime/services/palaver-systemd.env",
    "/root/savant-runtime/PALAVER_DOCTOR.sh",
    "/root/savant-runtime/palaver_voice_backend.py",
    "/root/savant-runtime/webui_ultra"
  ],
  "runtime_dependencies": {
    "python": {
      "command": "python3",
      "required": true
    },
    "frontend": {
      "working_directory": "/root/savant-runtime/webui_ultra",
      "command": "/usr/bin/env npx vite --host 0.0.0.0 --port 5173",
      "requires": [
        "node",
        "npm",
        "npx"
      ]
    },
    "voice": {
      "python": "/root/savant-runtime/.venv_voice/bin/python",
      "entrypoint": "/root/savant-runtime/palaver_voice_backend.py",
      "environment_file": "/root/savant-runtime/runtime/services/palaver-systemd.env"
    },
    "tunnel": {
      "command": "/usr/bin/cloudflared",
      "target": "http://127.0.0.1:5173"
    }
  },
  "service_units": [
    {
      "name": "palaver.service",
      "path": "/etc/systemd/system/palaver.service",
      "observed_state": "enabled",
      "working_directory": "/root/savant-runtime",
      "environment_file": "/root/savant-runtime/runtime/services/palaver-systemd.env",
      "exec_start": "/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/palaver/commands/palaver_ultra"
    },
    {
      "name": "palaver-doctor.service",
      "path": "/etc/systemd/system/palaver-doctor.service",
      "observed_state": "static",
      "exec_start": "/root/savant-runtime/PALAVER_DOCTOR.sh"
    },
    {
      "name": "palaver-frontend.service",
      "path": "/etc/systemd/system/palaver-frontend.service",
      "observed_state": "disabled",
      "working_directory": "/root/savant-runtime/webui_ultra",
      "exec_start": "/usr/bin/env npx vite --host 0.0.0.0 --port 5173"
    },
    {
      "name": "palaver-tunnel.service",
      "path": "/etc/systemd/system/palaver-tunnel.service",
      "observed_state": "disabled",
      "exec_start": "/usr/bin/cloudflared tunnel --url http://127.0.0.1:5173",
      "depends_on": [
        "palaver-frontend.service"
      ]
    },
    {
      "name": "palaver-voice-backend.service",
      "path": "/etc/systemd/system/palaver-voice-backend.service",
      "observed_state": "disabled",
      "working_directory": "/root/savant-runtime",
      "environment_file": "/root/savant-runtime/runtime/services/palaver-systemd.env",
      "exec_start": "/root/savant-runtime/.venv_voice/bin/python /root/savant-runtime/palaver_voice_backend.py"
    }
  ],
  "environment": {
    "root_env_file_observed": false,
    "root_env_path": "/root/savant-runtime/.env",
    "systemd_env_file_observed": true,
    "systemd_env_path": "/root/savant-runtime/runtime/services/palaver-systemd.env",
    "systemd_env_optional": true
  },
  "startup_semantics": {
    "canonical_service": "palaver.service",
    "canonical_launcher": "commands/palaver_ultra",
    "launcher_precedence": [
      "runtime/server.py",
      "apps/webui_ultra/server.py"
    ],
    "manual_parallel_runtime_start_supported": false,
    "port_8787_single_owner_required": true,
    "address_in_use_interpretation": "a second manually started palaver runtime will fail when palaver.service already owns port 8787"
  },
  "migration_rules": [
    "preserve canonical runtime and legacy implementation together",
    "preserve canonical-first legacy-fallback launcher behavior",
    "preserve bridge modules as independent runtime dependencies",
    "preserve persona and provider identity separation",
    "preserve persona precedence",
    "preserve existing service enablement states",
    "preserve palaver-systemd.env as the observed service environment source",
    "preserve the separate voice python environment",
    "preserve frontend and tunnel as separate services",
    "preserve palaver.service as the canonical owner of the palaver runtime listener",
    "do not infer nginx integration",
    "do not create a root environment file from inference",
    "do not rewrite application files solely for migration",
    "do not start a second manual runtime while palaver.service owns port 8787",
    "validate destination before enabling or starting palaver"
  ]
}
