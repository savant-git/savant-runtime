{
  "id": "carbon.graph.simulation_lifecycle",
  "owner": "carbon",
  "type": "simulation_lifecycle_projection",
  "status": "active",
  "nodes": [
    {
      "id": "carbon:definition",
      "type": "simulation_definition"
    },
    {
      "id": "carbon:instance",
      "type": "simulation_instance"
    },
    {
      "id": "carbon:branch",
      "type": "simulation_branch"
    },
    {
      "id": "carbon:state",
      "type": "simulation_state"
    },
    {
      "id": "carbon:checkpoint",
      "type": "simulation_checkpoint"
    },
    {
      "id": "carbon:execution",
      "type": "simulation_execution"
    },
    {
      "id": "carbon:receipt",
      "type": "execution_receipt"
    },
    {
      "id": "carbon:replay",
      "type": "replay_projection"
    },
    {
      "id": "carbon:comparison",
      "type": "comparison_projection"
    },
    {
      "id": "carbon:interrogation",
      "type": "query_projection"
    }
  ],
  "edges": [
    {
      "source": "carbon:definition",
      "target": "carbon:instance",
      "relation": "instantiates"
    },
    {
      "source": "carbon:instance",
      "target": "carbon:branch",
      "relation": "establishes_root_branch"
    },
    {
      "source": "carbon:branch",
      "target": "carbon:state",
      "relation": "contains_current_state"
    },
    {
      "source": "carbon:state",
      "target": "carbon:checkpoint",
      "relation": "may_checkpoint_as"
    },
    {
      "source": "carbon:branch",
      "target": "carbon:execution",
      "relation": "executes_through"
    },
    {
      "source": "carbon:execution",
      "target": "carbon:state",
      "relation": "projects_resulting_state"
    },
    {
      "source": "carbon:execution",
      "target": "carbon:receipt",
      "relation": "emits"
    },
    {
      "source": "carbon:receipt",
      "target": "carbon:replay",
      "relation": "supports"
    },
    {
      "source": "carbon:checkpoint",
      "target": "carbon:branch",
      "relation": "may_fork_into"
    },
    {
      "source": "carbon:state",
      "target": "carbon:comparison",
      "relation": "may_participate_in"
    },
    {
      "source": "carbon:state",
      "target": "carbon:interrogation",
      "relation": "may_be_queried_through"
    }
  ],
  "invariants": {
    "definition_identity_preserved": true,
    "instance_identity_preserved": true,
    "branch_identity_preserved": true,
    "checkpoint_immutable": true,
    "ancestor_branch_not_overwritten": true,
    "execution_receipted": true,
    "replay_divergence_exposed": true,
    "comparison_non_mutating": true,
    "interrogation_non_mutating": true,
    "authority_transfer": false
  }
}
