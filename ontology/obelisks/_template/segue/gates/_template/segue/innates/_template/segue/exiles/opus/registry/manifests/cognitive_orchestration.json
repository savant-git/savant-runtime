{
  "id": "opus.cognitive_orchestration",
  "owner": "opus",
  "type": "orchestration_manifest",
  "status": "active",
  "schema": "savant://opus/cognitive-orchestration/1",
  "singular_purpose": "bounded heterogeneous cognitive orchestration",
  "quality_target": {
    "class": "enterprise_grade",
    "definition": "ten_times_base_production_grade",
    "quality_multiplier": 10
  },
  "architecture": {
    "primitive": "orchestration_instance",
    "composition": "instance_reference",
    "relationships": "typed_segues",
    "outputs": "derived_projections",
    "authority_transfer": false
  },
  "primitives": [
    "orchestration_instance",
    "task_instance",
    "hypothesis_instance",
    "argument_instance",
    "evidence_reference",
    "inference_instance",
    "critique_instance",
    "falsification_instance",
    "judgment_instance",
    "synthesis_instance",
    "receipt_instance"
  ],
  "segue_types": [
    "decomposes_into",
    "depends_on",
    "supports",
    "challenges",
    "contradicts",
    "falsifies",
    "qualifies",
    "competes_with",
    "derived_from",
    "synthesizes",
    "critiques",
    "supersedes",
    "observes",
    "routes_to"
  ],
  "epistemic_classes": [
    "source_derived",
    "verified",
    "strong_inference",
    "weak_inference",
    "hypothesis",
    "speculation",
    "unknown",
    "contradicted"
  ],
  "enhancements": [
    "heterogeneous_model_ensembles",
    "heterogeneous_provider_ensembles",
    "independent_first_passes",
    "adaptive_task_decomposition",
    "dependency_dag_execution",
    "structured_concurrency",
    "adaptive_compute_allocation",
    "epistemic_ledger",
    "hypothesis_graph",
    "argument_graph",
    "adversarial_critique",
    "explicit_falsification",
    "red_team_passes",
    "independent_judgment",
    "confidence_calibration",
    "disagreement_preservation",
    "semantic_deduplication",
    "novelty_detection",
    "information_gain_stopping",
    "contradiction_preservation",
    "evidence_grounding",
    "authority_isolation",
    "context_budgeting",
    "provider_diversity",
    "model_diversity",
    "failure_isolation",
    "circuit_breaking",
    "quorum_policies",
    "speculative_parallelism",
    "branch_and_bound_reasoning",
    "counterfactual_testing",
    "uncertainty_propagation",
    "synthesis_critique",
    "deterministic_structural_identity",
    "replay_receipts",
    "incremental_reprojection",
    "projection_caching",
    "cost_budgeting",
    "latency_budgeting",
    "graceful_degradation",
    "capability_aware_routing",
    "explicit_unresolved_results",
    "optional_distributed_tracing"
  ],
  "execution": {
    "default_strategy": "adaptive_ensemble",
    "minimum_workers": 1,
    "default_workers": 4,
    "maximum_workers": 16,
    "default_rounds": 2,
    "maximum_rounds": 8,
    "maximum_depth": 8,
    "maximum_total_calls": 64,
    "minimum_provider_diversity": 1,
    "preferred_provider_diversity": 3,
    "minimum_model_diversity": 1,
    "preferred_model_diversity": 3,
    "parallelism": "bounded",
    "fail_fast": false
  },
  "stopping": {
    "budget_exhausted": true,
    "deadline_reached": true,
    "sufficient_support": true,
    "low_information_gain": true,
    "stable_synthesis": true,
    "irreducible_disagreement": true,
    "explicit_cancellation": true
  },
  "invariants": {
    "model_output_is_authority": false,
    "provider_output_is_authority": false,
    "consensus_is_authority": false,
    "confidence_is_authority": false,
    "source_authority_preserved": true,
    "accepted_authority_preserved": true,
    "uncertainty_preserved": true,
    "material_dissent_preserved": true,
    "counterevidence_preserved": true,
    "provider_failures_preserved": true,
    "lineage_preserved": true,
    "provenance_preserved": true,
    "replay_inputs_preserved": true,
    "bounded_execution": true,
    "composition_by_reference": true,
    "derived_projections_rebuildable": true,
    "authority_transfer": false
  },
  "optional_dependencies": {
    "opentelemetry": {
      "purpose": "distributed tracing and metrics",
      "required": false
    },
    "tenacity": {
      "purpose": "provider adapter retry compatibility only",
      "required": false,
      "owns_retry_policy": false
    }
  }
}
