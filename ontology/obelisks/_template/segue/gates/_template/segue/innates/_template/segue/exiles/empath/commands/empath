#!/usr/bin/env python3

from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from pathlib import Path
from typing import Any


ROOT = Path(
    "/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/empath"
)

RUNTIME = ROOT / "runtime" / "empath.py"


def load_runtime() -> Any:
    spec = importlib.util.spec_from_file_location(
        "savant_empath_runtime",
        RUNTIME,
    )

    if spec is None or spec.loader is None:
        raise RuntimeError(
            f"unable to load empath runtime: {RUNTIME}"
        )

    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)

    return module


def read_text(args: argparse.Namespace) -> str:
    if args.text is not None:
        return args.text

    if args.file is not None:
        return Path(args.file).read_text(
            encoding="utf-8"
        )

    if not sys.stdin.isatty():
        return sys.stdin.read()

    raise SystemExit(
        "empath requires --text, --file, or stdin"
    )


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(
        prog="empath",
        description=(
            "Savant Empath deterministic, "
            "projection-only conversational signal engine"
        ),
    )

    source = command.add_mutually_exclusive_group()

    source.add_argument(
        "--text",
        help="text to analyze",
    )

    source.add_argument(
        "--file",
        help="UTF-8 text file to analyze",
    )

    command.add_argument(
        "--source-id",
        default=None,
        help="optional source identity carried as provenance",
    )

    command.add_argument(
        "--pretty",
        action="store_true",
        help="pretty-print JSON",
    )

    command.add_argument(
        "--capabilities",
        action="store_true",
        help="print capability and authority boundary",
    )

    return command


def main() -> int:
    args = parser().parse_args()
    runtime = load_runtime()

    if args.capabilities:
        payload = {
            "schema": "savant.empath.capabilities.v1",
            "engine": runtime.ENGINE,
            "version": runtime.VERSION,
            "authority_effect": "none",
            "projection_only": True,
            "capabilities": [
                "affective_signal_projection",
                "interaction_temperature_projection",
                "friction_projection",
                "urgency_projection",
                "uncertainty_projection",
                "directness_projection",
                "response_calibration_projection",
                "linguistic_evidence_spans",
                "contradiction_signal_projection",
                "deterministic_replay",
                "multi_turn_delta_projection"
            ],
            "prohibited": [
                "diagnosis",
                "deception_detection_claim",
                "private_mental_state_claim",
                "authority_mutation",
                "persona_mutation",
                "provider_ownership"
            ],
        }

    else:
        payload = runtime.analyze(
            read_text(args),
            source_id=args.source_id,
        )

    json.dump(
        payload,
        sys.stdout,
        ensure_ascii=False,
        indent=2 if args.pretty else None,
        sort_keys=args.pretty,
    )

    sys.stdout.write("\n")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
