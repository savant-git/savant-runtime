{
  "id": "carbon.contracts",
  "owner": "carbon",
  "type": "contract_registry",
  "status": "active",
  "contracts": [
    {
      "id": "simulation_definition",
      "owner": "carbon",
      "input": {
        "sources": "references",
        "parameters": "mapping",
        "constraints": "collection",
        "relationships": "collection",
        "events": "collection",
        "dependencies": "references",
        "execution_rules": "mapping"
      },
      "output": "simulation_definition",
      "authority_effect": "none"
    },
    {
      "id": "simulation_execution",
      "owner": "carbon",
      "input": {
        "simulation": "reference",
        "branch": "optional_reference",
        "checkpoint": "optional_reference",
        "parameters": "optional_mapping",
        "events": "optional_collection"
      },
      "output": "simulation_execution_projection",
      "receipt": true,
      "authority_effect": "none"
    },
    {
      "id": "simulation_branch",
      "owner": "carbon",
      "input": {
        "simulation": "reference",
        "parent_branch": "reference",
        "branch_point": "reference",
        "changes": "mapping"
      },
      "output": "simulation_branch",
      "immutable_ancestry": true,
      "authority_effect": "none"
    },
    {
      "id": "simulation_checkpoint",
      "owner": "carbon",
      "input": {
        "simulation": "reference",
        "branch": "reference",
        "state": "simulation_state"
      },
      "output": "immutable_checkpoint",
      "authority_effect": "none"
    },
    {
      "id": "simulation_replay",
      "owner": "carbon",
      "input": {
        "simulation": "reference",
        "execution": "reference"
      },
      "output": "replay_projection",
      "divergence_must_be_exposed": true,
      "authority_effect": "none"
    },
    {
      "id": "simulation_compare",
      "owner": "carbon",
      "input": {
        "left": "reference",
        "right": "reference"
      },
      "output": "comparison_projection",
      "mutates_inputs": false,
      "authority_effect": "none"
    },
    {
      "id": "simulation_interrogate",
      "owner": "carbon",
      "input": {
        "simulation": "reference",
        "query": "mapping"
      },
      "output": "simulation_query_projection",
      "authority_effect": "none"
    },
    {
      "id": "oriel_discover",
      "owner": "carbon",
      "input": {
        "query": "optional_mapping"
      },
      "output": "oriel_specialization_profile",
      "mutates_inputs": false,
      "authoritative": false,
      "authority_effect": "none"
    },
    {
      "id": "oriel_interrogate",
      "owner": "carbon",
      "input": {
        "operation": "oriel_operation_identifier",
        "simulation": "reference_or_mapping",
        "facts": "optional_collection",
        "arguments": "optional_mapping"
      },
      "output": "oriel_derived_projection",
      "mutates_inputs": false,
      "simulation_owner": "carbon",
      "authority_effect": "none"
    },
    {
      "id": "guise_create",
      "owner": "carbon",
      "input": {
        "character_id": "identifier",
        "display_name": "optional_string"
      },
      "output": "guise_character_graph",
      "mutates_authority": false,
      "authority_effect": "none"
    },
    {
      "id": "guise_import",
      "owner": "carbon",
      "input": {
        "character": "reference",
        "source": "reference",
        "content": "imported_writing",
        "provider": "optional_replaceable_attachment"
      },
      "output": "guise_extraction_candidates",
      "automatic_canonization": false,
      "source_authority_preserved": true,
      "authority_effect": "none"
    },
    {
      "id": "guise_generate",
      "owner": "carbon",
      "input": {
        "character": "reference",
        "request": "mapping",
        "provider": "replaceable_attachment"
      },
      "output": "guise_character_hypotheses",
      "requires_acceptance": true,
      "authoritative": false,
      "authority_effect": "none"
    },
    {
      "id": "guise_project",
      "owner": "carbon",
      "input": {
        "character": "reference",
        "projection_type": "guise_projection_identifier",
        "temporal_scope": "optional_mapping",
        "relationship_scope": "optional_reference"
      },
      "output": "guise_derived_projection",
      "mutates_inputs": false,
      "authoritative": false,
      "authority_effect": "none"
    },
    {
      "id": "guise_compare",
      "owner": "carbon",
      "input": {
        "left_character": "reference",
        "right_character": "reference",
        "scope": "optional_mapping"
      },
      "output": "guise_character_comparison",
      "mutates_inputs": false,
      "authority_effect": "none"
    },
    {
      "id": "guise_counterfactual",
      "owner": "carbon",
      "input": {
        "character": "reference",
        "state": "reference_or_mapping",
        "changes": "mapping"
      },
      "output": "guise_counterfactual_projection",
      "simulation_owner": "carbon",
      "mutates_character": false,
      "authority_effect": "none"
    },
    {
      "id": "guise_interrogate",
      "owner": "carbon",
      "input": {
        "character": "reference",
        "operation": "guise_operation_identifier",
        "arguments": "optional_mapping"
      },
      "output": "guise_derived_projection",
      "mutates_inputs": false,
      "authority_effect": "none"
    }
  ],
  "global_invariants": {
    "simulation_is_not_observation": true,
    "simulation_is_not_accepted_authority": true,
    "source_authority_preserved": true,
    "uncertainty_preserved": true,
    "branch_lineage_preserved": true,
    "provenance_preserved": true,
    "guise_extraction_is_not_canon": true,
    "guise_generation_is_not_canon": true,
    "guise_simulation_is_not_canon": true,
    "character_data_does_not_define_guise": true,
    "authority_transfer": false
  }
}
