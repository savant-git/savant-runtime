class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/":
            html_response(self, HTML)
            return

        if path == "/api/health":
            json_response(self, {
                "ok": True,
                "health": health(),
            })
            return

        json_response(self, {"ok": False, "error": "not found"}, 404)

    def do_POST(self):
        try:
            path = urlparse(self.path).path
            data = read_body(self)

            if path == "/api/health":
                json_response(self, {
                    "ok": True,
                    "health": health(),
                })
                return

            if path == "/api/chat":
            message = data.get("message", "").strip()
            if not message:
                json_response(self, {"ok": False, "answer": "", "trace": "empty"})
                return
            result = chat_response(message)
            json_response(self, {"ok": True, **result})
            return

        if path == "/api/patch/write":
            target = data.get("path", "").strip()
            content = data.get("content", "")
            intent = data.get("intent", "browser write proposal")
            if not target:
                json_response(self, {"ok": False, "output": "missing path"})
                return
            r = run_cmd(["./patch", "write", target, "--stdin", "--intent", intent], input_text=content)
            json_response(self, {"ok": r["ok"], "output": r["stdout"] + r["stderr"]})
            return

        if path == "/api/patch/append":
            target = data.get("path", "").strip()
            content = data.get("content", "")
            intent = data.get("intent", "browser append proposal")
            if not target:
                json_response(self, {"ok": False, "output": "missing path"})
                return
            r = run_cmd(["./patch", "append", target, "--stdin", "--intent", intent], input_text=content)
            json_response(self, {"ok": r["ok"], "output": r["stdout"] + r["stderr"]})
            return

            json_response(self, {"ok": False, "error": "not found"}, 404)

        except Exception as e:
            crash_dir = ROOT / "vault" / "diagnostics" / "crashes"
            crash_dir.mkdir(parents=True, exist_ok=True)
            stamp = datetime.now(UTC).strftime("%Y%m%d_%H%M%S_%f")
            (crash_dir / f"webui_ultra_{stamp}.txt").write_text(
                traceback.format_exc(),
                encoding="utf-8",
            )
            json_response(self, {
                "ok": False,
                "answer": "Server route crashed. See vault/diagnostics/crashes.",
                "trace": str(e),
            }, 500)


def main():
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    print(f"Palaver Ultra running: http://127.0.0.1:{PORT}")
    server.serve_forever()


if __name__ == "__main__":
    main()
