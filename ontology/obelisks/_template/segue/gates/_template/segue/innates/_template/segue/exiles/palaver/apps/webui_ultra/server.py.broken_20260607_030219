def utc_now() -> str:
    return datetime.now(UTC).isoformat()


def load_env_file() -> None:
    env = ROOT / ".env"
    if not env.exists():
        return

    for line in env.read_text(encoding="utf-8", errors="ignore").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip().strip('"').strip("'")
        os.environ.setdefault(k, v)


load_env_file()


def read_body(handler: BaseHTTPRequestHandler) -> dict:
    size = int(handler.headers.get("Content-Length", "0"))
    raw = handler.rfile.read(size).decode("utf-8") if size else "{}"
    try:
        return json.loads(raw)
    except Exception:
        return {}


def json_response(handler: BaseHTTPRequestHandler, payload: dict, code: int = 200) -> None:
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    handler.send_response(code)
    handler.send_header("Content-Type", "application/json; charset=utf-8")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def html_response(handler: BaseHTTPRequestHandler, html: str, code: int = 200) -> None:
    data = html.encode("utf-8")
    handler.send_response(code)
    handler.send_header("Content-Type", "text/html; charset=utf-8")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def run_cmd(args: list[str], input_text: str | None = None) -> dict:
    try:
        p = subprocess.run(
            args,
            cwd=str(ROOT),
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
        )
        return {
            "ok": p.returncode == 0,
            "stdout": p.stdout,
            "stderr": p.stderr,
            "code": p.returncode,
            "args": args,
        }
    except Exception as e:
        return {
            "ok": False,
            "stdout": "",
            "stderr": str(e),
            "code": -1,
            "args": args,
        }


