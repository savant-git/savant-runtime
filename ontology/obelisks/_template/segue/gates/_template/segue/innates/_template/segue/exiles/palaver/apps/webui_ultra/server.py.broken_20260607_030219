def cmd_answer(args: list[str], trace: str) -> dict:
    r = run_cmd(args)
    return {
        "answer": (r["stdout"] or "") + (("\n[stderr]\n" + r["stderr"]) if r["stderr"] else ""),
        "trace": trace + "\n" + " ".join(args),
    }


def command_result(text: str) -> dict | None:
    low = text.lower().strip()

    if low in {"health", "status"}:
        return {"answer": json.dumps(health(), indent=2, ensure_ascii=False), "trace": "health"}

    if low == "diag":
        if diagnostics:
            try:
                return {
                    "answer": json.dumps(diagnostics(), indent=2, ensure_ascii=False),
                    "trace": "diagnostics via core",
                }
            except Exception as e:
                return {"answer": str(e), "trace": "diagnostics error"}
        return cmd_answer(["./palaver_diag"], "diagnostics command")

    if low == "files":
        return cmd_answer(["./file", "list", ".", "--limit", "1000"], "file list")

    if low.startswith("file list "):
        path = text[len("file list "):].strip()
        return cmd_answer(["./file", "list", path, "--limit", "1000"], "file list")

    if low.startswith("file read "):
        path = text[len("file read "):].strip()
        return cmd_answer(["./file", "read", path, "--start", "1", "--end", "900"], "file read")

    if low.startswith("search "):
        q = text[len("search "):].strip()
        return cmd_answer(["./search", "term", q, "--limit", "80"], "message search")

    if low.startswith("retrieve "):
        q = text[len("retrieve "):].strip()
        return cmd_answer(["./retrieve", "term", q, "--limit", "30"], "memory retrieval")

    if low == "graph":
        return cmd_answer(["./graph_info"], "graph info")

    if low == "patches":
        return cmd_answer(["./patch", "list"], "patch queue")

    if low.startswith("patch show "):
        pid = text[len("patch show "):].strip()
        return cmd_answer(["./patch", "show", pid], "patch show")

    if low.startswith("patch apply "):
        pid = text[len("patch apply "):].strip()
        return cmd_answer(["./patch", "apply", pid], "patch apply")

    if low == "rebuild":
        if (ROOT / "maintenance.sh").exists():
            return cmd_answer(["./maintenance.sh"], "maintenance")
        if rebuild_all:
            try:
                return {
                    "answer": json.dumps(rebuild_all(), indent=2, ensure_ascii=False),
                    "trace": "rebuild via core",
                }
            except Exception as e:
                return {"answer": str(e), "trace": "rebuild error"}
        return cmd_answer(["./rebuild_search_index.sh"], "rebuild search")

    return None


def auto_file_context(text: str) -> tuple[str, list[str]]:
    low = text.lower()
    trace: list[str] = []
    chunks: list[str] = []

    triggers = ["file", "code", "runtime", "source", "build", "savant", "palaver", "web", "ui", "patch"]
    if any(t in low for t in triggers) and (ROOT / "file").exists():
        r = run_cmd(["./file", "list", "runtime", "--limit", "220"])
        if r["stdout"]:
            chunks.append("## runtime file list\n" + r["stdout"][:12000])
            trace.append("attached runtime file list")

    targeted = {
        "core": "runtime/core.py",
        "gateway": "runtime/gateway.py",
        "web": "webui_ultra/server.py",
        "ui": "webui_ultra/server.py",
        "file": "runtime/file_access.py",
        "patch": "runtime/patch_system.py",
        "graph": "runtime/graph_inspect.py",
        "retrieval": "runtime/memory_retrieval.py",
    }

    for key, path in targeted.items():
        if key in low and (ROOT / path).exists() and (ROOT / "file").exists():
            r = run_cmd(["./file", "read", path, "--start", "1", "--end", "420"])
            chunks.append(f"## {path}\n" + r["stdout"][:18000])
            trace.append(f"attached {path}")

    return "\n\n".join(chunks), trace


def call_openai_raw(messages: list[dict]) -> str:
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY missing. Add it to ~/savant-runtime/.env")

    payload = {
        "model": os.getenv("SAVANT_MODEL", "gpt-5"),
        "input": messages,
    }

    data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(
        "https://api.openai.com/v1/responses",
        data=data,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
        method="POST",
    )

    context = ssl.create_default_context()

    with urllib.request.urlopen(req, timeout=120, context=context) as resp:
        raw = resp.read().decode("utf-8")

    obj = json.loads(raw)

    if "output_text" in obj:
        return obj["output_text"]

    texts = []
    for item in obj.get("output", []):
        for content in item.get("content", []):
            if content.get("type") in {"output_text", "text"}:
                texts.append(content.get("text", ""))

    if texts:
        return "\n".join(texts).strip()

    return json.dumps(obj, indent=2, ensure_ascii=False)


def chat_response(message: str) -> dict:
    direct = command_result(message)
    if direct:
        persist_exchange(message, direct["answer"], direct["trace"])
        return direct

    traces: list[str] = []

    memory = ""
    if memory_block_for_prompt:
        try:
            memory = memory_block_for_prompt(message, limit=10)
            traces.append("memory attached" if memory else "memory empty")
        except Exception as e:
            traces.append(f"memory error: {e}")

    file_context, file_trace = auto_file_context(message)
    traces.extend(file_trace)

    context = "\n\n".join(x for x in [memory, file_context] if x)

    user_content = message
    if context:
        user_content = (
            "Authoritative retrieved context follows.\n\n"
            + context
            + "\n\nCurrent user message:\n"
            + message
        )

    try:
        answer = call_openai_raw(
            [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_content},
            ]
        )
        traces.append("model response ok via raw HTTPS")
    except Exception as e:
        answer = (
            "AI response failed.\n\n"
            + str(e)
            + "\n\nRun `health` in Palaver to verify OPENAI_API_KEY and backend status.\n"
            + "Commands still work: files, file read runtime/core.py, search <query>, retrieve <query>, graph, patches, rebuild."
        )
        traces.append("model error")

    persist_exchange(message, answer, "\n".join(traces))
    return {"answer": answer, "trace": "\n".join(traces)}


def persist_exchange(user_text: str, assistant_text: str, trace: str) -> None:
    chat_dir = ROOT / "vault" / "web_chats"
    trace_dir = ROOT / "vault" / "web_traces"
    chat_dir.mkdir(parents=True, exist_ok=True)
    trace_dir.mkdir(parents=True, exist_ok=True)

    stamp = datetime.now(UTC).strftime("%Y%m%d_%H%M%S_%f")
    record = {
        "timestamp": utc_now(),
        "user": user_text,
        "assistant": assistant_text,
        "trace": trace,
    }

    (chat_dir / f"{stamp}.json").write_text(
        json.dumps(record, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    if latest_session and new_session_path and load_session and save_session and write_message_object:
        try:
            session_file = latest_session() or new_session_path()
            conversation = load_session(session_file)

            conversation.append({"role": "user", "content": user_text, "timestamp": utc_now()})
            write_message_object(
                session_file.stem,
                "user",
                user_text,
                source_path="webui_ultra",
                source_type="web_chat",
                ordinal=len(conversation) - 1,
            )

            conversation.append({"role": "assistant", "content": assistant_text, "timestamp": utc_now()})
            write_message_object(
                session_file.stem,
                "assistant",
                assistant_text,
                source_path="webui_ultra",
                source_type="web_chat",
                ordinal=len(conversation) - 1,
            )

            save_session(session_file, conversation)

            if rebuild_all:
                rebuild_all()

        except Exception:
            (trace_dir / f"{stamp}.error.txt").write_text(traceback.format_exc(), encoding="utf-8")


