{
  "id": "opus_voice_request_contract",
  "type": "runtime_contract",
  "status": "active",
  "owner": "envoy",
  "provider": "opus",
  "consumer": "envoy",
  "route": "voice_tts_route",
  "purpose": "Define the Envoy-owned voice intent projected to Opus for provider execution.",
  "request_object": {
    "owner": "envoy",
    "text": "string",
    "persona": "object",
    "voice": "object",
    "accent": "object",
    "language": "object",
    "emotion": "object",
    "pronunciation": "object"
  },
  "response_object": {
    "provider": "string",
    "mime_type": "string",
    "audio": "bytes"
  },
  "authority": {
    "request_intent_owner": "envoy",
    "persona_owner": "envoy",
    "voice_owner": "envoy",
    "provider_selection_owner": "opus",
    "provider_execution_owner": "opus"
  },
  "constraints": {
    "provider_selection_in_request": false,
    "provider_credentials_in_request": false,
    "provider_retry_policy_in_request": false,
    "provider_fallback_policy_in_request": false,
    "authority_transfer": false
  },
  "rule": "Envoy emits provider-neutral voice intent. Opus resolves and executes the external provider without transferring provider authority to Envoy."
}
