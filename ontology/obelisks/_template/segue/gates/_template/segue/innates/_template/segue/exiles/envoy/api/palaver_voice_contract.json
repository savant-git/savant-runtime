{
  "id": "palaver_voice_contract",
  "schema": "savant.envoy.palaver-voice-contract.v1",
  "type": "api_contract",
  "status": "active",
  "provider": "envoy",
  "consumer": "palaver",
  "authority": {
    "conversation_owner": "palaver",
    "persona_owner": "envoy",
    "voice_owner": "envoy",
    "provider_execution_owner": "opus"
  },
  "persona_precedence": [
    "request",
    "workspace",
    "default"
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/voice/personas",
      "operation": "list_personas",
      "purpose": "List personas registered and owned by Envoy."
    },
    {
      "method": "GET",
      "path": "/api/voice/persona",
      "operation": "resolve_persona",
      "query": {
        "id": "optional persona identifier"
      },
      "purpose": "Resolve the effective Envoy persona."
    },
    {
      "method": "GET",
      "path": "/api/voice/resolve",
      "operation": "resolve_voice",
      "query": {
        "id": "optional persona identifier"
      },
      "purpose": "Resolve the Envoy-owned voice profile associated with the effective persona."
    },
    {
      "method": "POST",
      "path": "/api/voice/synthesize",
      "operation": "synthesize_base64",
      "request": {
        "text": "required string",
        "persona_id": "optional persona identifier"
      },
      "response": {
        "ok": "boolean",
        "conversation_owner": "palaver",
        "voice_owner": "envoy",
        "persona_owner": "envoy",
        "provider_owner": "opus",
        "persona_id": "string",
        "persona_source": "request|workspace|default",
        "workspace_persona": "string|null",
        "speech": {
          "persona_id": "string",
          "display_name": "string|null",
          "voice": "object",
          "provider": "string",
          "mime_type": "string",
          "format": "string",
          "audio_base64": "string"
        }
      },
      "purpose": "Synthesize speech from Envoy persona and voice intent through Opus-owned provider execution."
    }
  ],
  "constraints": {
    "palaver_may_own_persona": false,
    "palaver_may_own_voice": false,
    "envoy_may_own_conversation": false,
    "envoy_may_execute_provider_calls": false,
    "palaver_may_execute_provider_calls": false
  }
}
