{
  "id": "coda.palaver_mutation_contract",
  "schema": "savant.coda.palaver-mutation-contract.v1",
  "type": "api_contract",
  "status": "active",
  "provider": "coda",
  "consumer": "palaver",
  "purpose": "Permit Palaver to request Coda-owned durable filesystem mutation without transferring mutation authority.",
  "operations": [
    {
      "id": "replace_text",
      "request": {
        "path": "string",
        "content": "string",
        "expected_digest": "string|null",
        "intent": "string|null"
      },
      "result": {
        "path": "string",
        "bytes": "integer",
        "before_digest": "string|null",
        "after_digest": "string",
        "receipt_id": "string",
        "receipt": "string",
        "owner": "coda",
        "atomic": true,
        "verified": true
      }
    }
  ],
  "ownership": {
    "conversation": "palaver",
    "mutation": "coda"
  },
  "invariants": [
    "palaver requests mutations but does not execute filesystem mutation directly",
    "coda owns durable filesystem mutation",
    "mutation paths remain confined to /root/savant-runtime",
    "protected implementation directories remain blocked by coda policy",
    "expected_digest provides optimistic concurrency when supplied",
    "successful writes are atomically replaced",
    "successful writes are digest verified",
    "successful mutations emit durable receipts",
    "mutation does not create or alter authority by itself"
  ],
  "authority_transfer": false,
  "authority_effect": "none"
}
