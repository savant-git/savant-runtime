def now():
    return datetime.now(UTC).isoformat()


def send_json(h, payload, code=200):
    data = json.dumps(payload, ensure_ascii=False).encode()
    h.send_response(code)
    h.send_header("Content-Type", "application/json; charset=utf-8")
    h.send_header("Cache-Control", "no-store")
    h.send_header("Content-Length", str(len(data)))
    h.end_headers()
    h.wfile.write(data)


def send_html(h, html, code=200):
    data = html.encode()
    h.send_response(code)
    h.send_header("Content-Type", "text/html; charset=utf-8")
    h.send_header("Cache-Control", "no-store")
    h.send_header("Content-Length", str(len(data)))
    h.end_headers()
    h.wfile.write(data)


def body_json(h):
    n = int(h.headers.get("Content-Length", "0"))
    raw = h.rfile.read(n).decode() if n else "{}"
    try:
        return json.loads(raw)
    except Exception:
        return {}


def run_cmd(args, input_text=None):
    p = subprocess.run(args, cwd=str(ROOT), input=input_text, text=True, capture_output=True, check=False)
    return {"ok": p.returncode == 0, "out": (p.stdout or "") + (("\n[stderr]\n" + p.stderr) if p.stderr else ""), "code": p.returncode}


