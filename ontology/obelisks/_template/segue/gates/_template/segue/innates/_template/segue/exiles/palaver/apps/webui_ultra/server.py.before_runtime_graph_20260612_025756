    def do_POST(self):
        try:
            path = urlparse(self.path).path
            data = body_json(self)

            if path == "/api/chat":
                message = data.get("message", "").strip()
                if not message:
                    send_json(self, {"ok": False, "answer": "", "trace": "empty"})
                    return
                send_json(self, {"ok": True, **chat(message)})
                return

            if path == "/api/file/save":
                target = data.get("path", "").strip()
                content = data.get("content", "")
                send_json(self, {"ok": True, "file": save_file_payload(target, content)})
                return

            if path == "/api/file/diff":
                target = data.get("path", "").strip()
                content = data.get("content", "")
                send_json(self, {"ok": True, "diff": diff_payload(target, content)})
                return

            if path == "/api/workspace/save":
                send_json(self, {"ok": True, "result": workspace_state_save(data)})
                return

            if path == "/api/patch/write":
                target = data.get("path", "").strip()
                content = data.get("content", "")
                intent = data.get("intent", "browser write proposal")
                r = run_cmd(["./patch", "write", target, "--stdin", "--intent", intent], input_text=content)
                send_json(self, {"ok": r["ok"], "output": r["out"]})
                return

            if path == "/api/patch/append":
                target = data.get("path", "").strip()
                content = data.get("content", "")
                intent = data.get("intent", "browser append proposal")
                r = run_cmd(["./patch", "append", target, "--stdin", "--intent", intent], input_text=content)
                send_json(self, {"ok": r["ok"], "output": r["out"]})
                return

            if path == "/api/patch-review/create":
                target = data.get("path", "").strip()
                content = data.get("content", "")
                send_json(self, {"ok": True, "patch": patch_review_create_payload(target, content)})
                return

            if path == "/api/patch-review/apply":
                patch_id = data.get("patch_id", "").strip()
                send_json(self, {"ok": True, "patch": patch_review_apply_payload(patch_id)})
                return

            if path == "/api/patch-review/reject":
                patch_id = data.get("patch_id", "").strip()
                send_json(self, {"ok": True, "patch": patch_review_reject_payload(patch_id)})
                return

            send_json(self, {"ok": False, "error": "not found"}, 404)

        except Exception as e:
            crash = ROOT / "vault" / "diagnostics" / "crashes"
            crash.mkdir(parents=True, exist_ok=True)
            stamp = datetime.now(UTC).strftime("%Y%m%d_%H%M%S_%f")
            (crash / f"server_{stamp}.txt").write_text(traceback.format_exc(), encoding="utf-8")
            send_json(self, {"ok": False, "answer": "Server route crashed.", "trace": str(e)}, 500)


