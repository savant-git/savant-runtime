def repository_files_payload(limit=2500):
    indexed = (
        ROOT /
        "vault" /
        "repository" /
        "files" /
        "files.json"
    )

    if indexed.exists():
        try:
            data = json.loads(
                indexed.read_text(
                    encoding="utf-8"
                )
            )

            return [
                x.get("path")
                for x in data.get("files", [])
                if x.get("path")
            ][:limit]

        except Exception:
            pass

    fallback_roots = [
        ROOT / "runtime",
        ROOT / "webui_ultra",
        ROOT / "webui-nextgen" / "src",
        ROOT / "docs",
    ]

    rows = []

    for base in fallback_roots:
        if not base.exists():
            continue

        for f in base.rglob("*"):
            if not f.is_file():
                continue

            rows.append(
                str(
                    f.relative_to(ROOT)
                )
            )

            if len(rows) >= limit:
                return rows

    return rows


