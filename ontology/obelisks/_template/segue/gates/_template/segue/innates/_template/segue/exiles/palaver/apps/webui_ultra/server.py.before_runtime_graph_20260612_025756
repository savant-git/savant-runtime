def read_text_payload(relative, limit=200000):
    target = (ROOT / relative).resolve()
    root = ROOT.resolve()

    try:
        target.relative_to(root)
    except Exception:
        return {"ok": False, "error": "path escapes root", "path": relative}

    if not target.exists():
        return {"ok": False, "error": "missing", "path": relative}

    try:
        text = target.read_text(encoding="utf-8", errors="replace")
    except Exception as e:
        return {"ok": False, "error": str(e), "path": relative}

    return {
        "ok": True,
        "path": relative,
        "bytes": len(text.encode("utf-8")),
        "truncated": len(text) > limit,
        "text": text[:limit],
    }


def read_json_payload(relative, limit=200000):
    import json

    payload = read_text_payload(relative, limit=limit)

    if not payload.get("ok"):
        return payload

    try:
        payload["json"] = json.loads(payload["text"])
    except Exception as e:
        payload["json_error"] = str(e)

    return payload


def latest_matching_payload(glob_pattern, text=True):
    files = sorted(ROOT.glob(glob_pattern))

    if not files:
        return {"ok": False, "error": "no match", "glob": glob_pattern}

    rel = str(files[-1].relative_to(ROOT))

    if text:
        return read_text_payload(rel)

    return read_json_payload(rel)


