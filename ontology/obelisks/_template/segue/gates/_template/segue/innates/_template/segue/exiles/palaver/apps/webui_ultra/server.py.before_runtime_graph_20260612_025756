async function patchWrite(){const path=document.getElementById("patchPath").value.trim(),content=document.getElementById("patchContent").value;const res=await fetch("/api/patch/write",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({path,content,intent:"browser write proposal"})});const data=await res.json();patchOut.textContent=data.output||JSON.stringify(data,null,2)}
