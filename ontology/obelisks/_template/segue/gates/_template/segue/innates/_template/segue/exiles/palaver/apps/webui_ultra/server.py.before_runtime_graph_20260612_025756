async function loadTree(path=""){
 try{
  const res=await fetch("/api/tree?path="+encodeURIComponent(path));
  const data=await res.json();
  if(!data.ok){trace.textContent=data.error||"tree failed";return}
  if(!path){
    document.getElementById("fileTree").innerHTML=renderTree(data.tree);
  }else{
    const holder=document.querySelector(`[data-children="${cssEscape(path)}"]`);
    if(holder) holder.innerHTML=(data.tree.children||[]).map(renderTree).join("");
  }
 }catch(e){trace.textContent=String(e)}
}

function cssEscape(s){
 return String(s).replace(/["\\]/g,"\\$&");
}

function renderTree(node){
 const icon=node.type==="directory"?"▸":"•";
 const cls=node.type==="directory"?"treeDir":"treeFile";
 const path=node.path||"";
 const safe=path.replaceAll("'","\\'");
 let click=node.type==="file"
   ? `openFile('${safe}')`
   : `toggleDir('${safe}')`;
 let html=`<div class="treeItem ${cls}" onclick="${click}">${icon} ${esc(node.name)}</div>`;
 if(node.type==="directory"){
   html+=`<div data-children="${esc(path)}" style="padding-left:12px">`;
   if(node.children){
     for(const child of node.children)html+=renderTree(child);
   }
   html+=`</div>`;
 }
 return html;
}

async function toggleDir(path){
 const holder=document.querySelector(`[data-children="${cssEscape(path)}"]`);
 if(!holder)return;
 if(holder.dataset.loaded==="1"){
   holder.style.display=holder.style.display==="none"?"block":"none";
   return;
 }
 holder.dataset.loaded="1";
 await loadTree(path);
}

