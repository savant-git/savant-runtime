def save_file_payload(path, content):
    target, rel = safe_rel_path(path)

    if any(x in {".git", ".venv", "__pycache__", "node_modules"} for x in target.relative_to(ROOT).parts):
        raise RuntimeError("blocked protected path")

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")

    return {
        "path": rel,
        "bytes": len(content.encode("utf-8")),
    }


def diff_payload(path, proposed):
    import difflib

    target, rel = safe_rel_path(path)

    before = ""
    if target.exists() and target.is_file():
        before = target.read_text(encoding="utf-8", errors="ignore")

    diff = "".join(
        difflib.unified_diff(
            before.splitlines(True),
            proposed.splitlines(True),
            fromfile=f"before/{rel}",
            tofile=f"after/{rel}",
        )
    )

    return {
        "path": rel,
        "diff": diff,
    }


