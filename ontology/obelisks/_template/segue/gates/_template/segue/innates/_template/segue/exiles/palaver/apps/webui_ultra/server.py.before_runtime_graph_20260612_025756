    stamp = datetime.now(UTC).strftime("%Y%m%d_%H%M%S_%f")
    (d / f"{stamp}.json").write_text(json.dumps({"timestamp": now(), "user": user, "assistant": assistant, "trace": trace}, indent=2, ensure_ascii=False) + "\n")


def chat(message):
    cmd = direct_command(message)
    if cmd:
        persist(message, cmd["answer"], cmd["trace"])
        return cmd

    trace = []
    context = ""

    if memory_block_for_prompt:
        try:
            context = memory_block_for_prompt(message, limit=8) or ""
            trace.append("memory attached" if context else "memory empty")
        except Exception as e:
            trace.append("memory error: " + str(e))

    try:
        answer = call_openai(message, context)
        trace.append("openai ok")
    except Exception as e:
        answer = "AI response failed:\n\n" + str(e) + "\n\nRun health. Commands still work."
        trace.append("openai failed")

    persist(message, answer, "\n".join(trace))
    return {"answer": answer, "trace": "\n".join(trace)}



