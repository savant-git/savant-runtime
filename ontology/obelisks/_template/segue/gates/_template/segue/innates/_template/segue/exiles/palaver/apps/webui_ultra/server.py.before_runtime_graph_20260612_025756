def direct_command(message):
    low = message.lower().strip()

    if low in {"health", "status"}:
        return {"answer": json.dumps(health(), indent=2), "trace": "health"}

    if low == "diag":
        if diagnostics:
            return {"answer": json.dumps(diagnostics(), indent=2, ensure_ascii=False), "trace": "diagnostics"}
        return {"answer": "diagnostics unavailable", "trace": "diagnostics unavailable"}

    if low == "files":
        r = run_cmd(["./file", "list", ".", "--limit", "1000"])
        return {"answer": r["out"], "trace": "file list"}

    if low.startswith("file read "):
        target = message[len("file read "):].strip()
        r = run_cmd(["./file", "read", target, "--start", "1", "--end", "900"])
        return {"answer": r["out"], "trace": "file read"}

    if low.startswith("search "):
        q = message[len("search "):].strip()
        r = run_cmd(["./search", "term", q, "--limit", "80"])
        return {"answer": r["out"], "trace": "search"}

    if low.startswith("retrieve "):
        q = message[len("retrieve "):].strip()
        r = run_cmd(["./retrieve", "term", q, "--limit", "30"])
        return {"answer": r["out"], "trace": "retrieve"}

    if low == "graph":
        r = run_cmd(["./graph_info"])
        return {"answer": r["out"], "trace": "graph"}

    if low == "patches":
        r = run_cmd(["./patch", "list"])
        return {"answer": r["out"], "trace": "patch list"}

    if low == "repository report":
        r = run_cmd(["./repository", "report"])
        return {"answer": r["out"], "trace": "repository report"}

    if low == "repository scan":
        r = run_cmd(["./repository", "scan"])
        return {"answer": r["out"], "trace": "repository scan"}

    if low.startswith("patch show "):
        pid = message[len("patch show "):].strip()
        r = run_cmd(["./patch", "show", pid])
        return {"answer": r["out"], "trace": "patch show"}

    if low.startswith("patch apply "):
        pid = message[len("patch apply "):].strip()
        r = run_cmd(["./patch", "apply", pid])
        return {"answer": r["out"], "trace": "patch apply"}

    if low == "rebuild":
        if rebuild_all:
            return {"answer": json.dumps(rebuild_all(), indent=2, ensure_ascii=False), "trace": "rebuild_all"}
        r = run_cmd(["./rebuild_search_index.sh"])
        return {"answer": r["out"], "trace": "rebuild fallback"}

    return None


def call_openai(message, context=""):
    key = os.getenv("OPENAI_API_KEY")
    if not key:
        raise RuntimeError("OPENAI_API_KEY missing")

    user = message if not context else "Context:\n" + context + "\n\nUser:\n" + message
    payload = {"model": os.getenv("SAVANT_MODEL", "gpt-5"), "input": [{"role": "system", "content": SYSTEM_PROMPT}, {"role": "user", "content": user}]}
    req = urllib.request.Request("https://api.openai.com/v1/responses", data=json.dumps(payload).encode(), headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"}, method="POST")

    with urllib.request.urlopen(req, timeout=120, context=ssl.create_default_context()) as resp:
        data = json.loads(resp.read().decode())

    if data.get("output_text"):
        return data["output_text"]

    texts = []
    for item in data.get("output", []):
        for c in item.get("content", []):
            if c.get("text"):
                texts.append(c["text"])
    return "\n".join(texts).strip() or json.dumps(data, indent=2)


