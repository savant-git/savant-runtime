def safe_rel_path(path):
    path = (path or "").strip().lstrip("/")
    target = (ROOT / path).resolve()
    root = ROOT.resolve()
    if not (str(target).startswith(str(root) + "/") or target == root):
        raise RuntimeError("blocked outside root")
    rel = target.relative_to(root)
    if any(x in {".git", ".venv", "__pycache__", "node_modules"} for x in rel.parts):
        raise RuntimeError("blocked protected path")
    return target, str(rel)


def build_file_tree(base=None, max_depth=2, depth=0):
    target = ROOT if base is None else base

    node = {
        "name": "savant-runtime" if target == ROOT else target.name,
        "path": "" if target == ROOT else str(target.relative_to(ROOT)),
        "type": "directory" if target.is_dir() else "file",
    }

    if not target.is_dir():
        return node

    children = []

    try:
        items = sorted(
            target.iterdir(),
            key=lambda x: (
                x.is_file(),
                x.name.lower(),
            )
        )

        count = 0

        for child in items:
            if child.name in {
                ".git",
                ".venv",
                "__pycache__",
                "node_modules",
                ".pytest_cache",
                ".mypy_cache",
            }:
                continue

            if count >= 300:
                children.append({
                    "name": "[truncated]",
                    "path": node["path"],
                    "type": "file",
                })
                break

            if child.is_dir():
                children.append({
                    "name": child.name,
                    "path": str(child.relative_to(ROOT)),
                    "type": "directory",
                    "children": [],
                    "lazy": True,
                })
            else:
                try:
                    size = child.stat().st_size
                except Exception:
                    size = 0

                if size <= 750000:
                    children.append({
                        "name": child.name,
                        "path": str(child.relative_to(ROOT)),
                        "type": "file",
                        "size": size,
                    })

            count += 1

    except Exception:
        pass

    node["children"] = children
    return node


def list_directory_payload(path=""):
    target, rel = safe_rel_path(path)

    if not target.exists():
        raise RuntimeError("missing path")

    if not target.is_dir():
        raise RuntimeError("not a directory")

    return build_file_tree(target, max_depth=1, depth=0)


def read_file_payload(path):
    target, rel = safe_rel_path(path)
    if not target.exists():
        raise RuntimeError("missing file")
    if not target.is_file():
        raise RuntimeError("not a file")
    text = target.read_text(encoding="utf-8", errors="ignore")
    return {"path": rel, "size": len(text), "content": text[:160000]}


