class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            parsed = urlparse(self.path)
            path = parsed.path

            if path == "/api/graph":
                try:
                    graph = {
                        "nodes": [],
                        "edges": []
                    }

                    root = ROOT / "vault"

                    if root.exists():
                        for i,path_obj in enumerate(
                            sorted(root.rglob("*"))[:150]
                        ):
                            node_id = str(path_obj.relative_to(ROOT))

                            graph["nodes"].append({
                                "id": node_id,
                                "label": path_obj.name,
                                "kind": (
                                    "directory"
                                    if path_obj.is_dir()
                                    else "file"
                                )
                            })

                            parent = path_obj.parent

                            if parent != path_obj:
                                parent_id = str(
                                    parent.relative_to(ROOT)
                                )

                                graph["edges"].append({
                                    "source": parent_id,
                                    "target": node_id,
                                    "kind": "contains"
                                })

                    send_json(self, graph)
                    return

                except Exception as e:
                    send_json(
                        self,
                        {
                            "error": str(e)
                        }
                    )
                    return

            # PALAVER_PERSONALITY_PHASE_2_ROUTES_START
            if path == "/api/personality/evolution":
                send_json(self, palaver_read_json_file("vault/personality_foundry/evolution/evolution_report.json"))
                return

            if path == "/api/personality/events":
                send_json(self, palaver_read_text_file("vault/personality_foundry/events/personality_events.jsonl"))
                return

            if path == "/api/personality/graph":
                send_json(self, palaver_read_json_file("vault/personality_foundry/graphs/personality_graph.json"))
                return

            if path == "/api/personality/graph-edges":
                send_json(self, palaver_read_text_file("vault/personality_foundry/graphs/personality_graph_edges.tsv"))
                return
            # PALAVER_PERSONALITY_PHASE_2_ROUTES_END

            # PALAVER_PERSONALITY_ROUTES_START
            if path == "/api/personality/kernel":
                send_json(self, palaver_read_json_file("vault/personality_foundry/kernels/palaver_personality_kernel.json"))
                return

            if path == "/api/personality/genome":
                send_json(self, palaver_read_json_file("vault/personality_foundry/genome.json"))
                return

            if path == "/api/personality/physics":
                send_json(self, palaver_read_json_file("vault/personality_foundry/physics/personality_physics_state.json"))
                return

            if path == "/api/personality/identity":
                send_json(self, palaver_read_json_file("vault/personality_foundry/identity/identity_continuity.json"))
                return

            if path == "/api/personality/projection":
                send_json(self, palaver_read_json_file("vault/personality_foundry/compiled/active_personality_projection.json"))
                return

            if path == "/api/personality/runtime-prompt":
                send_json(self, palaver_read_text_file("vault/personality_foundry/compiled/palaver_runtime_personality_prompt.md"))
                return

            if path == "/api/personality/summary":
                send_json(self, palaver_personality_summary())
                return
            # PALAVER_PERSONALITY_ROUTES_END

            # AUTHORITY_FORCE_ROUTES_START
            if path == "/api/authority/map":
                send_json(self, read_text_payload("vault/graph_address/graph_addresses.latest.tsv"))
                return

            if path == "/api/authority/relationships":
                send_json(self, read_text_payload("vault/relationships/system_relationships.latest.tsv"))
                return

            if path == "/api/authority/contracts":
                send_json(self, read_text_payload("vault/contracts/extension_contracts.md"))
                return

            if path == "/api/authority/palaver":
