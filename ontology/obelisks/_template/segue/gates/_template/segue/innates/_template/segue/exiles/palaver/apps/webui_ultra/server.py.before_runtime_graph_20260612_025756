                            continue

                        for f in base.glob("*.json"):
                            try:
                                text = f.read_text(encoding="utf-8", errors="ignore")
                            except Exception:
                                continue

                            if term in text.lower():
                                rows.append({
                                    "path": str(f.relative_to(ROOT)),
                                    "preview": text[:500],
