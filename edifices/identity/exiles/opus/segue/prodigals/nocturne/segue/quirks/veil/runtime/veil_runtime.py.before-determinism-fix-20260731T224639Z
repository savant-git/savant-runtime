            "generated_at": utc_now(),
        },
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Veil deterministic route-policy planner and simulator."
        )
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    run_parser = subparsers.add_parser(
        "run"
    )
    run_parser.add_argument(
        "--input",
        type=Path,
    )
    run_parser.add_argument(
        "--output",
        type=Path,
    )

    example_parser = subparsers.add_parser(
        "example"
    )
    example_parser.add_argument(
        "--output",
        type=Path,
    )

    subparsers.add_parser(
        "schema"
    )

    args = parser.parse_args()

    if args.command == "run":
        request = load_request(
            args.input
        )
        result = run(
            request
        )
        write_result(
            result,
            args.output,
        )
        return 0 if result.passed else 1

    if args.command == "example":
        request = example_request()
        rendered = json.dumps(
            request.model_dump(
                mode="json",
            ),
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        ) + "\n"

        if args.output is None:
            print(
                rendered,
                end="",
            )
        else:
            args.output.parent.mkdir(
                parents=True,
                exist_ok=True,
            )
            args.output.write_text(
                rendered,
                encoding="utf-8",
            )

        return 0

    if args.command == "schema":
        value = {
            "route_request": RouteRequest.model_json_schema(),
            "route_plan": RoutePlan.model_json_schema(),
            "route_observation": RouteObservation.model_json_schema(),
            "veil_result": VeilResult.model_json_schema(),
        }
        print(
            json.dumps(
                value,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    return 2


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
