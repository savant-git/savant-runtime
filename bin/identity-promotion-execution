#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

SCAFFOLD_CONTROLLER = (
    ROOT
    / "bin"
    / "identity-promotion-scaffold"
)

BUILDER = (
    ROOT
    / "tools"
    / "identity_quality"
    / "promotion"
    / "build_promotion_execution_packet.py"
)

REPORT_ROOT = (
    ROOT
    / "reports"
    / "identity_quality"
    / "promotion"
    / "execution"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def latest_paths() -> list[Path]:
    if not REPORT_ROOT.is_dir():
        return []

    return sorted(
        (
            path
            for path in REPORT_ROOT.glob(
                "*/latest.json"
            )
            if path.is_file()
        ),
        key=lambda path: (
            path.stat().st_mtime_ns,
            path.as_posix(),
        ),
        reverse=True,
    )


def latest_path() -> Path | None:
    paths = latest_paths()

    if not paths:
        return None

    return paths[0]


def load_json(
    path: Path,
) -> dict[str, Any]:
    value = json.loads(
        path.read_text(
            encoding="utf-8",
        )
    )

    if not isinstance(value, dict):
        raise ValueError(
            f"Expected JSON object: {path}"
        )

    return value


def print_file(
    path: Path | None,
) -> int:
    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion execution packet exists.",
            file=sys.stderr,
        )

        return 1

    print(
        path.read_text(
            encoding="utf-8",
        ),
        end="",
    )

    return 0


def build(
    *,
    refresh_scaffold: bool,
    strict: bool,
    remaining: list[str],
) -> int:
    if refresh_scaffold:
        status = execute(
            [
                str(
                    SCAFFOLD_CONTROLLER
                ),
                (
                    "refresh-strict"
                    if strict
                    else "refresh"
                ),
            ]
        )

        if status:
            return status

    command = [
        str(PYTHON),
        str(BUILDER),
    ]

    if strict:
        command.append(
            "--strict"
        )

    command.extend(
        remaining
    )

    return execute(
        command
    )


def status() -> int:
    path = latest_path()

    result: dict[str, object] = {
        "builder": str(BUILDER),
        "builder_exists": (
            BUILDER.is_file()
        ),
        "report_root": str(
            REPORT_ROOT
        ),
        "report_root_exists": (
            REPORT_ROOT.is_dir()
        ),
        "latest_execution_packet": (
            str(path)
            if path
            else None
        ),
        "latest_execution_packet_exists": (
            path.is_file()
            if path
            else False
        ),
    }

    if (
        path is not None
        and path.is_file()
    ):
        try:
            value = load_json(path)

            result[
                "generated_at"
            ] = value.get(
                "generated_at"
            )

            result[
                "digest"
            ] = value.get(
                "digest"
            )

            result[
                "subject"
            ] = value.get(
                "subject"
            )

            result[
                "preflight"
            ] = value.get(
                "preflight"
            )

            result[
                "statistics"
            ] = value.get(
                "statistics"
            )

        except Exception as exc:
            result[
                "read_error"
            ] = {
                "type": type(
                    exc
                ).__name__,
                "message": str(
                    exc
                ),
            }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def stages() -> int:
    path = latest_path()

    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion execution packet exists.",
            file=sys.stderr,
        )

        return 1

    value = load_json(path)

    print(
        json.dumps(
            {
                "subject": value.get(
                    "subject"
                ),
                "preflight": value.get(
                    "preflight"
                ),
                "backups": value.get(
                    "backups"
                ),
                "stages": value.get(
                    "stages"
                ),
                "execution_policy": value.get(
                    "execution_policy"
                ),
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def usage() -> int:
    print(
        """
identity-promotion-execution build
identity-promotion-execution strict
identity-promotion-execution refresh
identity-promotion-execution refresh-strict
identity-promotion-execution status
identity-promotion-execution stages
identity-promotion-execution json
identity-promotion-execution show
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "build":
        return build(
            refresh_scaffold=False,
            strict=False,
            remaining=remaining,
        )

    if command == "strict":
        return build(
            refresh_scaffold=False,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh":
        return build(
            refresh_scaffold=True,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-strict":
        return build(
            refresh_scaffold=True,
            strict=True,
            remaining=remaining,
        )

    if command == "status":
        return status()

    if command == "stages":
        return stages()

    if command == "json":
        return print_file(
            latest_path()
        )

    if command == "show":
        path = latest_path()

        if path is None:
            return print_file(None)

        return print_file(
            path.with_name(
                "latest.md"
            )
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
