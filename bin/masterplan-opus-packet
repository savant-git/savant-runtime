#!/usr/bin/env python3

from __future__ import annotations

import os
import sys
from pathlib import Path


ROOT = Path(
    "/root/savant-runtime"
)

TOOL = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "build_masterplan_opus_packet.py"
)


def main() -> int:
    if not TOOL.is_file():
        print(
            f"missing Masterplan Opus packet tool: {TOOL}",
            file=sys.stderr,
        )

        return 1

    os.execv(
        sys.executable,
        [
            sys.executable,
            str(
                TOOL
            ),
            *sys.argv[1:],
        ],
    )

    return 1


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
