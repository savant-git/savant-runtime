#!/usr/bin/env python3
from __future__ import annotations

import subprocess
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = ROOT / "bin" / "identity-quality-python"

WORKFLOW = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "reconcile_duplicate_segues_current.py"
)


def main() -> int:
    return subprocess.run(
        [
            str(PYTHON),
            str(WORKFLOW),
        ],
        cwd=str(ROOT),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
