#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

BUILDER = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "build_masterplan_artifact_manifest.py"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def usage() -> int:
    print(
        """
masterplan-manifest build TASK_ID
masterplan-manifest persist TASK_ID
masterplan-manifest verify MANIFEST_PATH
masterplan-manifest all
masterplan-manifest persist-all
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "build":
        mapped = [
            "build",
            *remaining,
        ]

    elif command == "persist":
        mapped = [
            "build",
            *remaining,
            "--persist",
        ]

    elif command == "verify":
        mapped = [
            "verify",
            *remaining,
        ]

    elif command == "all":
        mapped = [
            "all",
        ]

    elif command == "persist-all":
        mapped = [
            "all",
            "--persist",
        ]

    else:
        print(
            (
                "ERROR: unknown manifest "
                f"command: {command}"
            ),
            file=sys.stderr,
        )

        return 2

    return execute(
        [
            str(PYTHON),
            str(BUILDER),
            *mapped,
        ]
    )


if __name__ == "__main__":
    raise SystemExit(main())
