class reconcile_error(RuntimeError):
    pass


def utc_now() -> str:
    return (
        dt.datetime.now(
            dt.timezone.utc
        )
        .isoformat()
        .replace(
            "+00:00",
            "Z",
        )
    )


def stamp() -> str:
    return dt.datetime.now(
        dt.timezone.utc
    ).strftime(
        "%Y%m%dT%H%M%SZ"
    )


def sha256_bytes(
    data: bytes,
) -> str:
    return hashlib.sha256(
        data
    ).hexdigest()


def sha256_file(
    path: Path,
) -> str:
    digest = hashlib.sha256()

    with path.open(
        "rb"
    ) as handle:

        for chunk in iter(
            lambda: handle.read(
                1024 * 1024
            ),
            b"",
        ):
            digest.update(
                chunk
            )

    return digest.hexdigest()


def canonical_json(
    value: Any,
) -> str:
    return json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(
            ",",
            ":",
        ),
    )


def ensure_within_root(
    path: Path,
) -> None:

    runtime_root = root.resolve()

    resolved = path.resolve(
        strict=False
    )

    if (
        resolved != runtime_root
        and runtime_root
        not in resolved.parents
    ):
        raise reconcile_error(
            "path escapes runtime root: "
            + str(
                path
            )
        )


def atomic_write(
    path: Path,
    text: str,
    mode: int = 0o644,
) -> None:

    ensure_within_root(
        path
    )

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary = path.with_name(
        "."
        + path.name
        + ".tmp."
        + str(
            os.getpid()
        )
    )

    with temporary.open(
        "w",
        encoding="utf-8",
        newline="\n",
    ) as handle:

        handle.write(
            text
        )

        handle.flush()

        os.fsync(
            handle.fileno()
        )

    os.chmod(
        temporary,
        mode,
    )

    os.replace(
        temporary,
        path,
    )

    try:
        directory_fd = os.open(
            path.parent,
            os.O_RDONLY,
        )
    except OSError:
        return

    try:
        os.fsync(
            directory_fd
        )
    finally:
        os.close(
            directory_fd
        )


def yaml_scalar(
    value: str,
) -> str:

    return json.dumps(
        value,
        ensure_ascii=False,
    )


def parse_authority_yaml(
    path: Path,
) -> dict[str, Any]:

    text = path.read_text(
        encoding="utf-8",
        errors="strict",
    )

    lines = text.splitlines()

    def top_scalar(
        key: str,
    ) -> str | None:

        pattern = re.compile(
            "^"
            + re.escape(
                key
            )
            + r":\s*(.+?)\s*$"
        )

        for line in lines:

            match = pattern.match(
                line
            )

            if not match:
                continue

            raw = match.group(
                1
            ).strip()

            if (
                raw.startswith(
                    (
                        '"',
                        "'",
                    )
                )
                and raw[-1:]
                == raw[:1]
            ):
                raw = raw[
                    1:-1
                ]

            return raw

        return None

    purpose: list[str] = []

    in_purpose = False
    in_current = False

    for line in lines:

        if line == "purpose:":
            in_purpose = True
            in_current = False
            continue

        if (
            in_purpose
            and line
            and not line.startswith(
                " "
            )
        ):
            break

        if (
            in_purpose
            and re.match(
                r"^\s{2}current:\s*$",
                line,
            )
        ):
            in_current = True
            continue

        if (
            in_purpose
            and in_current
        ):

            match = re.match(
                r"^\s{2,}-\s+(.+?)\s*$",
                line,
            )

            if match:

                value = match.group(
                    1
                ).strip()

                if (
                    value.startswith(
                        (
                            '"',
                            "'",
                        )
                    )
                    and value[-1:]
                    == value[:1]
                ):
                    value = value[
                        1:-1
                    ]

                purpose.append(
                    value
                )

                continue

            if (
                line.strip()
                and not line.lstrip().startswith(
                    "-"
                )
            ):

                if re.match(
                    r"^\s{2}[a-zA-Z0-9_-]+:",
                    line,
                ):
                    in_current = False

    return {
        "id": top_scalar(
            "id"
        ),
        "kind": top_scalar(
            "kind"
        ),
        "status": top_scalar(
            "status"
        ),
        "purpose": purpose,
        "sha256": sha256_file(
            path
        ),
        "text": text,
    }


def authority_records() -> dict[
    str,
    dict[str, Any],
]:

    records: dict[
        str,
        dict[str, Any],
    ] = {}

    problems: list[
        str
    ] = []

    for name in expected_exiles:

        path = (
            authority_root
            / (
                name
                + ".yaml"
            )
        )

        if not path.is_file():

            problems.append(
                "missing authority record: "
                + str(
                    path
                )
            )

            continue

        record = parse_authority_yaml(
            path
        )

        if (
            record["id"]
            != "exile:"
            + name
        ):
            problems.append(
                str(
                    path
                )
                + ": expected id exile:"
                + name
                + ", found "
                + repr(
                    record[
                        "id"
                    ]
                )
            )

        if (
            record["kind"]
            != "exile"
        ):
            problems.append(
                str(
                    path
                )
                + ": expected kind exile, found "
                + repr(
                    record[
                        "kind"
                    ]
                )
            )

        if (
            record["status"]
            != "accepted"
        ):
            problems.append(
                str(
                    path
                )
                + ": expected accepted status, found "
                + repr(
                    record[
                        "status"
                    ]
                )
            )

        if not record[
            "purpose"
        ]:
            problems.append(
                str(
                    path
                )
                + ": accepted purpose.current is empty"
            )

        record[
            "path"
        ] = path

        records[
            name
        ] = record

    if problems:

        raise reconcile_error(
            "\n".join(
                problems
            )
        )

    if len(
        records
    ) != 18:

        raise reconcile_error(
            "expected 18 accepted exile records, found "
            + str(
                len(
                    records
                )
            )
        )

    return records


def generated_instance_yaml(
    name: str,
    record: dict[
        str,
        Any,
    ],
) -> str:

    purpose_lines = "".join(
        "    - "
        + yaml_scalar(
            item
        )
        + "\n"
        for item
        in record[
            "purpose"
        ]
    )

    authority_ref = str(
        record[
            "path"
        ].relative_to(
            root
        )
    )

    return (
        "schema: "
        + yaml_scalar(
            "savant://projection/identity/exile-instance/1.0.0"
        )
        + "\n"
        + "id: "
        + yaml_scalar(
            "exile:"
            + name
        )
        + "\n"
        + "kind: "
        + yaml_scalar(
            "exile"
        )
        + "\n"
        + "name: "
        + yaml_scalar(
            name
        )
        + "\n"
        + "status: "
        + yaml_scalar(
            "accepted"
        )
        + "\n"
        + "authority_effect: "
        + yaml_scalar(
            "none"
        )
        + "\n"
        + "authority_ref: "
        + yaml_scalar(
            authority_ref
        )
        + "\n"
        + "authority_sha256: "
        + yaml_scalar(
            record[
                "sha256"
            ]
        )
        + "\n"
        + "purpose_projection:\n"
        + "  source: "
        + yaml_scalar(
            authority_ref
        )
        + "\n"
        + "  current:\n"
        + purpose_lines
        + "composition:\n"
        + "  parent_edifice: "
        + yaml_scalar(
            "identity"
        )
        + "\n"
        + "  child_level: "
        + yaml_scalar(
            "prodigal"
        )
        + "\n"
        + "  transition: "
        + yaml_scalar(
            "segue"
        )
        + "\n"
        + "invariants:\n"
        + "  filesystem_presence_establishes_authority: false\n"
        + "  canonical_substance_duplicated: false\n"
        + "  child_substance_by_reference: true\n"
        + "  projections_are_authority: false\n"
        + "lineage:\n"
        + "  decision: "
        + yaml_scalar(
            str(
                decision.relative_to(
                    root
                )
            )
        )
        + "\n"
        + "generated_by: "
        + yaml_scalar(
            generator
        )
        + "\n"
    )


