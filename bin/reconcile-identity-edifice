def safe_generated_write(
    path: Path,
    text: str,
) -> str:

    if path.exists():

        old = path.read_text(
            encoding="utf-8",
            errors="strict",
        )

        if old == text:
            return "unchanged"

        marker = (
            "generated_by: "
            + yaml_scalar(
                generator
            )
        )

        if marker not in old:

            raise reconcile_error(
                "refusing to overwrite non-generated file: "
                + str(
                    path
                )
            )

    atomic_write(
        path,
        text,
    )

    return "written"


def nonempty_directory(
    path: Path,
) -> bool:

    return (
        path.is_dir()
        and any(
            path.iterdir()
        )
    )


def direct_collection_state(
    parent: Path,
    plural: str,
) -> dict[str, Any]:

    direct = (
        parent
        / plural
    )

    canonical = (
        parent
        / "segue"
        / plural
    )

    result: dict[
        str,
        Any,
    ] = {
        "parent": str(
            parent.relative_to(
                root
            )
        ),
        "plural": plural,
        "direct": str(
            direct.relative_to(
                root
            )
        ),
        "canonical": str(
            canonical.relative_to(
                root
            )
        ),
        "direct_exists": (
            direct.exists()
            or direct.is_symlink()
        ),
        "direct_symlink": direct.is_symlink(),
        "canonical_exists": canonical.exists(),
        "action": "none",
    }

    if direct.is_symlink():

        target = os.readlink(
            direct
        )

        result[
            "target"
        ] = target

        if target != (
            "segue/"
            + plural
        ):
            result[
                "action"
            ] = "repair_symlink"

        return result

    if direct.is_dir():

        if nonempty_directory(
            direct
        ):

            if canonical.exists():

                result[
                    "action"
                ] = "collision"

            else:

                result[
                    "action"
                ] = "move_and_link"

        else:

            result[
                "action"
            ] = "remove_empty_direct"

    elif direct.exists():

        result[
            "action"
        ] = "invalid_non_directory"

    elif canonical.exists():

        result[
            "action"
        ] = "link_existing_canonical"

    return result


def plan(
    records: dict[
        str,
        dict[str, Any],
    ],
) -> dict[str, Any]:

    if exiles_root.is_dir():

        current = sorted(
            path.name
            for path
            in exiles_root.iterdir()
            if path.is_dir()
        )

    else:

        current = []

    missing = [
        name
        for name
        in expected_exiles
        if name not in current
    ]

    extra = [
        name
        for name
        in current
        if name
        not in expected_exiles
    ]

    collection_actions: list[
        dict[str, Any]
    ] = []

    if exiles_root.is_dir():

        for name in expected_exiles:

            exile = (
                exiles_root
                / name
            )

            if not exile.exists():
                continue

            collection_actions.append(
                direct_collection_state(
                    exile,
                    "prodigals",
                )
            )

            candidate_roots = (
                exile
                / "prodigals",
                exile
                / "segue"
                / "prodigals",
            )

            for candidate_root in candidate_roots:

                if (
                    not candidate_root.is_dir()
                    or candidate_root.is_symlink()
                ):
                    continue

                for prodigal in sorted(
                    path
                    for path
                    in candidate_root.iterdir()
                    if path.is_dir()
                ):

                    collection_actions.append(
                        direct_collection_state(
                            prodigal,
                            "quirks",
                        )
                    )

    blockers = [
        item
        for item
        in collection_actions
        if item[
            "action"
        ]
        in {
            "collision",
            "invalid_non_directory",
        }
    ]

    return {
        "schema": (
            "savant://projection/identity/"
            "reconciliation-plan/1.0.0"
        ),
        "authority_effect": "none",
        "expected_exile_count": 18,
        "expected_exiles": list(
            expected_exiles
        ),
        "current_exiles": current,
        "missing_exiles": missing,
        "extra_exiles_preserved": extra,
        "authority_records": {
            name: {
                "path": str(
                    record[
                        "path"
                    ].relative_to(
                        root
                    )
                ),
                "sha256": record[
                    "sha256"
                ],
                "purpose": record[
                    "purpose"
                ],
            }
            for name, record
            in records.items()
        },
        "collection_actions": (
            collection_actions
        ),
        "blockers": blockers,
        "decision": str(
            decision.relative_to(
                root
            )
        ),
        "generated_at": utc_now(),
    }


def acquire_lock() -> int:

    lock_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    try:

        file_descriptor = os.open(
            lock_path,
            os.O_CREAT
            | os.O_EXCL
            | os.O_WRONLY,
            0o600,
        )

    except FileExistsError as exc:

        raise reconcile_error(
            "active reconciliation lock exists: "
            + str(
                lock_path
            )
        ) from exc

    os.write(
        file_descriptor,
        (
            str(
                os.getpid()
            )
            + "\n"
        ).encode(
            "utf-8"
        ),
    )

    os.fsync(
        file_descriptor
    )

    return file_descriptor


def release_lock(
    file_descriptor: int,
) -> None:

    try:

        os.close(
            file_descriptor
        )

    finally:

        try:

            lock_path.unlink()

        except FileNotFoundError:

            pass


def make_backup() -> Path:

    backup = (
        backup_root
        / stamp()
    )

    if backup.exists():

        raise reconcile_error(
            "backup collision: "
            + str(
                backup
            )
        )

    backup.mkdir(
        parents=True,
        mode=0o700,
    )

    if identity.exists():

        shutil.copytree(
            identity,
            backup
            / "identity",
            symlinks=True,
        )

    manifest = {
        "schema": (
            "savant://receipt/identity/"
            "backup/1.0.0"
        ),
        "created_at": utc_now(),
        "source": str(
            identity
        ),
        "backup": str(
            backup
        ),
        "authority_effect": "none",
    }

    atomic_write(
        backup
        / "backup.json",
        json.dumps(
            manifest,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        0o600,
    )

    return backup


def ensure_compat_collection(
    parent: Path,
    plural: str,
    changes: list[
        dict[str, Any]
    ],
) -> None:

    state = direct_collection_state(
        parent,
        plural,
    )

    action = state[
        "action"
    ]

    direct = (
        parent
        / plural
    )

    canonical = (
        parent
        / "segue"
        / plural
    )

    if action == "none":
        return

    if action in {
        "collision",
        "invalid_non_directory",
    }:

        raise reconcile_error(
            "collection blocker: "
            + json.dumps(
                state,
                sort_keys=True,
            )
        )

    if action == "remove_empty_direct":

        direct.rmdir()

        changes.append(
            {
                "action": action,
                "path": str(
                    direct.relative_to(
                        root
                    )
                ),
            }
        )

        return

    canonical.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    if action == "move_and_link":

        os.replace(
            direct,
            canonical,
        )

        os.symlink(
            "segue/"
            + plural,
            direct,
        )

        changes.append(
            {
                "action": action,
                "from": str(
                    direct.relative_to(
                        root
                    )
                ),
                "to": str(
                    canonical.relative_to(
                        root
                    )
                ),
            }
        )

        return

    if action == "link_existing_canonical":

        os.symlink(
            "segue/"
            + plural,
            direct,
        )

        changes.append(
            {
                "action": action,
                "path": str(
                    direct.relative_to(
                        root
                    )
                ),
                "target": (
                    "segue/"
                    + plural
                ),
            }
        )

        return

    if action == "repair_symlink":

        direct.unlink()

        os.symlink(
            "segue/"
            + plural,
            direct,
        )

        changes.append(
            {
                "action": action,
                "path": str(
                    direct.relative_to(
                        root
                    )
                ),
                "target": (
                    "segue/"
                    + plural
                ),
            }
        )

        return

    raise reconcile_error(
        "unhandled collection action: "
        + json.dumps(
            state,
            sort_keys=True,
        )
    )


def materialize_coalesce(
    changes: list[
        dict[str, Any]
    ],
) -> None:

    if not legacy_coalesce.is_file():
        return

    target = (
        exiles_root
        / "modus"
        / "segue"
        / "prodigals"
        / "coalesce"
    )

    target.mkdir(
        parents=True,
        exist_ok=True,
    )

    instance = (
        target
        / "instance.yaml"
    )

    source = str(
        legacy_coalesce.relative_to(
            root
        )
    )

    text = (
        "schema: "
        + yaml_scalar(
            "savant://projection/identity/"
            "prodigal-reference/1.0.0"
        )
        + "\n"
        + "id: "
        + yaml_scalar(
            "prodigal:modus:coalesce"
        )
        + "\n"
        + "kind: "
        + yaml_scalar(
            "prodigal"
        )
        + "\n"
        + "name: "
        + yaml_scalar(
            "coalesce"
        )
        + "\n"
        + "status: "
        + yaml_scalar(
            "active"
        )
        + "\n"
        + "authority_effect: "
        + yaml_scalar(
            "none"
        )
        + "\n"
        + "owner: "
        + yaml_scalar(
            "exile:modus"
        )
        + "\n"
        + "source_ref: "
        + yaml_scalar(
            source
        )
        + "\n"
        + "source_sha256: "
        + yaml_scalar(
            sha256_file(
                legacy_coalesce
            )
        )
        + "\n"
        + "projection_mode: "
        + yaml_scalar(
            "reference-only"
        )
        + "\n"
        + "canonical_substance_copied: false\n"
        + "generated_by: "
        + yaml_scalar(
            generator
        )
        + "\n"
    )

    result = safe_generated_write(
        instance,
        text,
    )

    if result == "written":

        changes.append(
            {
                "action": (
                    "materialize_reference"
                ),
                "path": str(
                    instance.relative_to(
                        root
                    )
                ),
                "source": source,
            }
        )

    legacy = (
        exiles_root
        / "modus"
        / "prodigals"
    )

    if (
        not legacy.exists()
        and not legacy.is_symlink()
    ):

        os.symlink(
            "segue/prodigals",
            legacy,
        )

        changes.append(
            {
                "action": (
                    "link_existing_canonical"
                ),
                "path": str(
                    legacy.relative_to(
                        root
                    )
                ),
                "target": (
                    "segue/prodigals"
                ),
            }
        )


def reconcile(
    records: dict[
        str,
        dict[str, Any],
    ],
) -> tuple[
    Path,
    list[dict[str, Any]],
    dict[str, Any],
]:

    if not decision.is_file():

        raise reconcile_error(
            "missing accepted decision: "
            + str(
                decision
            )
        )

    preflight = plan(
        records
    )

    if preflight[
        "blockers"
    ]:

        raise reconcile_error(
            "preflight blockers exist:\n"
            + json.dumps(
                preflight[
                    "blockers"
                ],
                indent=2,
            )
        )

    backup = make_backup()

    changes: list[
        dict[str, Any]
    ] = []

    exiles_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    try:

        for name in expected_exiles:

            exile = (
                exiles_root
                / name
            )

            exile.mkdir(
                parents=True,
                exist_ok=True,
            )

            instance_path = (
                exile
                / "instance.yaml"
            )

            result = safe_generated_write(
                instance_path,
                generated_instance_yaml(
                    name,
                    records[
                        name
                    ],
                ),
            )

            if result == "written":

                changes.append(
                    {
                        "action": (
                            "write_instance_projection"
                        ),
                        "path": str(
                            instance_path.relative_to(
                                root
                            )
                        ),
                    }
                )

            segue_path = (
                exile
                / "segue"
                / "instance.yaml"
            )

            result = safe_generated_write(
                segue_path,
                generated_segue_yaml(
                    name
                ),
            )

            if result == "written":

                changes.append(
                    {
                        "action": (
                            "write_segue_projection"
                        ),
                        "path": str(
                            segue_path.relative_to(
                                root
                            )
                        ),
                    }
                )

            ensure_compat_collection(
                exile,
                "prodigals",
                changes,
            )

            canonical_prodigals = (
                exile
                / "segue"
                / "prodigals"
            )

            if canonical_prodigals.is_dir():

                for prodigal in sorted(
                    path
                    for path
                    in canonical_prodigals.iterdir()
                    if path.is_dir()
                ):

                    ensure_compat_collection(
                        prodigal,
                        "quirks",
                        changes,
                    )

        materialize_coalesce(
            changes
        )

        projection_dir = (
            identity
            / "projections"
        )

        projection_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        post = plan(
            records
        )

        index_payload = {
            "schema": (
                "savant://projection/identity/"
                "exile-index/1.0.0"
            ),
            "authority_effect": "none",
            "generated_at": utc_now(),
            "decision": str(
                decision.relative_to(
                    root
                )
            ),
            "exiles": [
                {
                    "id": (
                        "exile:"
                        + name
                    ),
                    "name": name,
                    "authority_ref": str(
                        records[
                            name
                        ][
                            "path"
                        ].relative_to(
                            root
                        )
                    ),
                    "authority_sha256": (
                        records[
                            name
                        ][
                            "sha256"
                        ]
                    ),
                    "purpose": (
                        records[
                            name
                        ][
                            "purpose"
                        ]
                    ),
                    "instance_projection": str(
                        (
                            exiles_root
                            / name
                            / "instance.yaml"
                        ).relative_to(
                            root
                        )
                    ),
                    "segue_projection": str(
                        (
                            exiles_root
                            / name
                            / "segue"
                            / "instance.yaml"
                        ).relative_to(
                            root
                        )
                    ),
                }
                for name
                in expected_exiles
            ],
        }

        semantic = dict(
            index_payload
        )

        semantic.pop(
            "generated_at",
            None,
        )

        index_payload[
            "semantic_digest"
        ] = sha256_bytes(
            canonical_json(
                semantic
            ).encode(
                "utf-8"
            )
        )

        index_path = (
            projection_dir
            / "exiles.json"
        )

        atomic_write(
            index_path,
            json.dumps(
                index_payload,
                indent=2,
                sort_keys=True,
            )
            + "\n",
        )

        changes.append(
            {
                "action": (
                    "write_projection"
                ),
                "path": str(
                    index_path.relative_to(
                        root
                    )
                ),
            }
        )

        return (
            backup,
            changes,
            post,
        )

    except Exception:

        restore_identity(
            backup
        )

        raise


def restore_identity(
    backup: Path,
) -> None:

    ensure_within_root(
        backup
    )

    snapshot = (
        backup
        / "identity"
    )

    if not snapshot.exists():

        raise reconcile_error(
            "backup contains no identity snapshot: "
            + str(
                backup
            )
        )

    if (
        identity.exists()
        or identity.is_symlink()
    ):

        if (
            identity.is_symlink()
            or identity.is_file()
        ):

            identity.unlink()

        else:

            shutil.rmtree(
                identity
            )

    shutil.copytree(
        snapshot,
        identity,
        symlinks=True,
    )


def verify(
    records: dict[
        str,
        dict[str, Any],
    ],
) -> dict[str, Any]:

    errors: list[
        str
    ] = []

    warnings: list[
        str
    ] = []

    if not decision.is_file():

        errors.append(
            "missing decision: "
            + str(
                decision
            )
        )

    if exiles_root.is_dir():

        actual = sorted(
            path.name
            for path
            in exiles_root.iterdir()
            if path.is_dir()
        )

    else:

        actual = []

    for name in expected_exiles:

        exile = (
            exiles_root
            / name
        )

        if not exile.is_dir():

            errors.append(
                "missing exile directory: "
                + str(
                    exile
                )
            )

            continue

        instance = (
            exile
            / "instance.yaml"
        )

        segue = (
            exile
            / "segue"
            / "instance.yaml"
        )

        if not instance.is_file():

            errors.append(
                "missing exile instance projection: "
                + str(
                    instance
                )
            )

        if not segue.is_file():

            errors.append(
                "missing exile segue projection: "
                + str(
                    segue
                )
            )

        direct = (
            exile
            / "prodigals"
        )

        canonical = (
            exile
            / "segue"
            / "prodigals"
        )

        if (
            direct.is_dir()
            and not direct.is_symlink()
        ):

            errors.append(
                "direct prodigals directory bypasses segue: "
                + str(
                    direct
                )
            )

        if direct.is_symlink():

            target = os.readlink(
                direct
            )

            if target != (
                "segue/prodigals"
            ):

                errors.append(
                    "invalid prodigals compatibility link: "
                    + str(
                        direct
                    )
                    + " -> "
                    + target
                )

            if not canonical.is_dir():

                errors.append(
                    "broken canonical prodigals collection: "
                    + str(
                        canonical
                    )
                )

        if canonical.is_dir():

            for prodigal in sorted(
                path
                for path
                in canonical.iterdir()
                if path.is_dir()
            ):

                quirks_direct = (
                    prodigal
                    / "quirks"
                )

                quirks_canonical = (
                    prodigal
                    / "segue"
                    / "quirks"
                )

                if (
                    quirks_direct.is_dir()
                    and not quirks_direct.is_symlink()
                ):

                    errors.append(
                        "direct quirks directory bypasses segue: "
                        + str(
                            quirks_direct
                        )
                    )

                if quirks_direct.is_symlink():

                    target = os.readlink(
                        quirks_direct
                    )

                    if target != (
                        "segue/quirks"
                    ):

                        errors.append(
                            "invalid quirks compatibility link: "
                            + str(
                                quirks_direct
                            )
                            + " -> "
                            + target
                        )

                    if not quirks_canonical.is_dir():

                        errors.append(
                            "broken canonical quirks collection: "
                            + str(
                                quirks_canonical
                            )
                        )

    extras = [
        name
        for name
        in actual
        if name
        not in expected_exiles
    ]

    if extras:

        warnings.append(
            "unrecognized exile directories preserved: "
            + ", ".join(
                extras
            )
        )

    index = (
        identity
        / "projections"
        / "exiles.json"
    )

    if not index.is_file():

        errors.append(
            "missing exile index projection: "
            + str(
                index
            )
        )

    return {
        "passed": (
            not errors
        ),
        "expected_exile_count": 18,
        "actual_expected_exile_count": sum(
            1
            for name
            in expected_exiles
            if (
                exiles_root
                / name
            ).is_dir()
        ),
        "errors": errors,
        "warnings": warnings,
    }


def write_receipt(
    backup: Path,
    changes: list[
        dict[str, Any]
    ],
    verification: dict[
        str,
        Any,
    ],
    records: dict[
        str,
        dict[str, Any],
    ],
) -> Path:

    receipt_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    payload = {
        "schema": (
            "savant://receipt/identity-edifice-"
            "reconciliation/1.0.0"
        ),
        "operation": (
            "identity-edifice-reconciliation"
        ),
        "occurred_at": utc_now(),
        "authority_effect": (
            "implements-current-user-directive"
        ),
        "decision": str(
            decision.relative_to(
                root
            )
        ),
        "backup": str(
            backup
        ),
        "changes": changes,
        "verification": verification,
        "authority_sources": {
            name: {
                "path": str(
                    records[
                        name
                    ][
                        "path"
                    ].relative_to(
                        root
                    )
                ),
                "sha256": (
                    records[
                        name
                    ][
                        "sha256"
                    ]
                ),
            }
            for name
            in expected_exiles
        },
    }

    semantic = dict(
        payload
    )

    semantic.pop(
        "occurred_at",
        None,
    )

    payload[
        "semantic_digest"
    ] = sha256_bytes(
        canonical_json(
            semantic
        ).encode(
            "utf-8"
        )
    )

    path = (
        receipt_root
        / (
            stamp()
            + "__"
            + payload[
                "semantic_digest"
            ][
                :16
            ]
            + ".json"
        )
    )

    atomic_write(
        path,
        json.dumps(
            payload,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        0o600,
    )

    return path


def print_json(
    value: Any,
) -> None:

    print(
        json.dumps(
            value,
            indent=2,
            sort_keys=True,
            ensure_ascii=False,
        )
    )


def main() -> int:

    parser = argparse.ArgumentParser(
        prog=(
            "reconcile-identity-edifice"
        )
    )

    commands = parser.add_subparsers(
        dest="command",
        required=True,
    )

    commands.add_parser(
        "plan"
    )

    commands.add_parser(
        "apply"
    )

    commands.add_parser(
        "verify"
    )

    rollback_parser = commands.add_parser(
        "rollback"
    )

    rollback_parser.add_argument(
        "backup"
    )

    arguments = parser.parse_args()

    if not root.is_dir():

        raise reconcile_error(
            "runtime root missing: "
            + str(
                root
            )
        )

    records = authority_records()

    if arguments.command == "plan":

        print_json(
            plan(
                records
            )
        )

        return 0

    if arguments.command == "verify":

        result = verify(
            records
        )

        print_json(
            result
        )

        return (
            0
            if result[
                "passed"
            ]
            else 1
        )

    if arguments.command == "rollback":

        file_descriptor = acquire_lock()

        try:

            restore_identity(
                Path(
                    arguments.backup
                ).resolve()
            )

            result = verify(
                records
            )

            print_json(
                {
                    "rolled_back": True,
                    "backup": (
                        arguments.backup
                    ),
                    "verification_after_rollback": (
                        result
                    ),
                }
            )

            return 0

        finally:

            release_lock(
                file_descriptor
            )

    if arguments.command == "apply":

        file_descriptor = acquire_lock()

        try:

            (
                backup,
                changes,
                _,
            ) = reconcile(
                records
            )

            result = verify(
                records
            )

            if not result[
                "passed"
            ]:

                restore_identity(
                    backup
                )

                raise reconcile_error(
                    "post-apply verification failed; "
                    "identity tree restored from backup:\n"
                    + json.dumps(
                        result,
                        indent=2,
                    )
                )

            receipt = write_receipt(
                backup,
                changes,
                result,
                records,
            )

            print_json(
                {
                    "passed": True,
                    "backup": str(
                        backup
                    ),
                    "receipt": str(
                        receipt
                    ),
                    "changes": len(
                        changes
                    ),
                    "verification": result,
                }
            )

            return 0

        finally:

            release_lock(
                file_descriptor
            )

    return 2


if __name__ == "__main__":

    try:

        raise SystemExit(
            main()
        )

    except reconcile_error as error:

        print(
            "ERROR: "
            + str(
                error
            ),
            file=sys.stderr,
        )

        raise SystemExit(
            1
        )
