#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

DECISION = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "admit_masterplan_decision.py"
)

MASTERPLAN_PROJECT = (
    ROOT
    / "bin"
    / "masterplan-project"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def admit(
    arguments: list[str],
    *,
    plan: bool,
    strict: bool,
) -> int:
    command = [
        str(PYTHON),
        str(DECISION),
        *arguments,
    ]

    if plan:
        command.append(
            "--plan"
        )

    if strict:
        command.append(
            "--strict"
        )

    status = execute(
        command
    )

    if status:
        return status

    if plan:
        return 0

    return execute(
        [
            str(MASTERPLAN_PROJECT),
            "strict",
        ]
    )


def usage() -> int:
    print(
        """
masterplan-decision plan TASK_ID DECISION_TYPE --actor ACTOR --rationale TEXT [--payload JSON]
masterplan-decision apply TASK_ID DECISION_TYPE --actor ACTOR --rationale TEXT [--payload JSON]
masterplan-decision apply-strict TASK_ID DECISION_TYPE --actor ACTOR --rationale TEXT [--payload JSON]
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "plan":
        return admit(
            remaining,
            plan=True,
            strict=False,
        )

    if command == "apply":
        return admit(
            remaining,
            plan=False,
            strict=False,
        )

    if command == "apply-strict":
        return admit(
            remaining,
            plan=False,
            strict=True,
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
