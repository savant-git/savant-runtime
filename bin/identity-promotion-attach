#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

ADMISSION_CONTROLLER = (
    ROOT
    / "bin"
    / "identity-promotion-admit"
)

ATTACHER = (
    ROOT
    / "tools"
    / "identity_quality"
    / "promotion"
    / "attach_promotion_definition.py"
)

REPORT_ROOT = (
    ROOT
    / "reports"
    / "identity_quality"
    / "promotion"
    / "definition-attachments"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def latest_paths() -> list[Path]:
    if not REPORT_ROOT.is_dir():
        return []

    return sorted(
        (
            path
            for path in REPORT_ROOT.glob(
                "*/latest.json"
            )
            if path.is_file()
        ),
        key=lambda path: (
            path.stat().st_mtime_ns,
            path.as_posix(),
        ),
        reverse=True,
    )


def latest_path() -> Path | None:
    paths = latest_paths()

    if not paths:
        return None

    return paths[0]


def load_json(
    path: Path,
) -> dict[str, Any]:
    value = json.loads(
        path.read_text(
            encoding="utf-8",
        )
    )

    if not isinstance(value, dict):
        raise ValueError(
            f"Expected JSON object: {path}"
        )

    return value


def print_file(
    path: Path | None,
) -> int:
    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no definition attachment exists.",
            file=sys.stderr,
        )

        return 1

    print(
        path.read_text(
            encoding="utf-8",
        ),
        end="",
    )

    return 0


def attach(
    *,
    refresh_admission: bool,
    apply: bool,
    strict: bool,
    remaining: list[str],
) -> int:
    if refresh_admission:
        status = execute(
            [
                str(ADMISSION_CONTROLLER),
                (
                    "refresh-apply-approved-strict"
                    if strict
                    else "refresh-apply-approved"
                ),
            ]
        )

        if status:
            return status

    command = [
        str(PYTHON),
        str(ATTACHER),
    ]

    if apply:
        command.append(
            "--apply"
        )

    if strict:
        command.append(
            "--strict"
        )

    command.extend(
        remaining
    )

    return execute(command)


def status() -> int:
    path = latest_path()

    result: dict[str, object] = {
        "attacher": str(ATTACHER),
        "attacher_exists": ATTACHER.is_file(),
        "report_root": str(REPORT_ROOT),
        "report_root_exists": (
            REPORT_ROOT.is_dir()
        ),
        "latest_attachment": (
            str(path)
            if path
            else None
        ),
        "latest_attachment_exists": (
            path.is_file()
            if path
            else False
        ),
    }

    if (
        path is not None
        and path.is_file()
    ):
        try:
            value = load_json(path)

            result["generated_at"] = value.get(
                "generated_at"
            )

            result["mode"] = value.get(
                "mode"
            )

            result["passed"] = value.get(
                "passed"
            )

            result["digest"] = value.get(
                "digest"
            )

            result["subject"] = value.get(
                "subject"
            )

            result["definition"] = value.get(
                "definition"
            )

            result["rollback"] = value.get(
                "rollback"
            )

        except Exception as exc:
            result["read_error"] = {
                "type": type(exc).__name__,
                "message": str(exc),
            }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def usage() -> int:
    print(
        """
identity-promotion-attach plan
identity-promotion-attach plan-strict
identity-promotion-attach apply
identity-promotion-attach apply-strict
identity-promotion-attach refresh-apply
identity-promotion-attach refresh-apply-strict
identity-promotion-attach status
identity-promotion-attach json
identity-promotion-attach show
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "plan":
        return attach(
            refresh_admission=False,
            apply=False,
            strict=False,
            remaining=remaining,
        )

    if command == "plan-strict":
        return attach(
            refresh_admission=False,
            apply=False,
            strict=True,
            remaining=remaining,
        )

    if command == "apply":
        return attach(
            refresh_admission=False,
            apply=True,
            strict=False,
            remaining=remaining,
        )

    if command == "apply-strict":
        return attach(
            refresh_admission=False,
            apply=True,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh-apply":
        return attach(
            refresh_admission=True,
            apply=True,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-apply-strict":
        return attach(
            refresh_admission=True,
            apply=True,
            strict=True,
            remaining=remaining,
        )

    if command == "status":
        return status()

    if command == "json":
        return print_file(
            latest_path()
        )

    if command == "show":
        path = latest_path()

        if path is None:
            return print_file(None)

        return print_file(
            path.with_name(
                "latest.md"
            )
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
