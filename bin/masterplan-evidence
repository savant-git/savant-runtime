#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

EVIDENCE = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "admit_masterplan_evidence.py"
)

PROJECT = (
    ROOT
    / "bin"
    / "masterplan-project"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def usage() -> int:
    print(
        """
masterplan-evidence plan TASK_ID KIND [--path PATH] [--passed true|false|unknown] --actor ACTOR [--notes TEXT]
masterplan-evidence apply TASK_ID KIND [--path PATH] [--passed true|false|unknown] --actor ACTOR [--notes TEXT]
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "plan":
        return execute(
            [
                str(PYTHON),
                str(EVIDENCE),
                *remaining,
                "--plan",
            ]
        )

    if command == "apply":
        status = execute(
            [
                str(PYTHON),
                str(EVIDENCE),
                *remaining,
            ]
        )

        if status:
            return status

        return execute(
            [
                str(PROJECT),
                "strict",
            ]
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
