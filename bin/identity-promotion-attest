#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

PARENT_VERIFIER = (
    ROOT
    / "bin"
    / "identity-promotion-parent-verify"
)

BUILDER = (
    ROOT
    / "tools"
    / "identity_quality"
    / "promotion"
    / "build_promotion_attestation.py"
)

REPORT_ROOT = (
    ROOT
    / "reports"
    / "identity_quality"
    / "promotion"
    / "attestations"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def latest_paths() -> list[Path]:
    if not REPORT_ROOT.is_dir():
        return []

    return sorted(
        (
            path
            for path in REPORT_ROOT.glob(
                "*/latest.json"
            )
            if path.is_file()
        ),
        key=lambda path: (
            path.stat().st_mtime_ns,
            path.as_posix(),
        ),
        reverse=True,
    )


def latest_path() -> Path | None:
    paths = latest_paths()

    if not paths:
        return None

    return paths[0]


def load_json(
    path: Path,
) -> dict[str, Any]:
    value = json.loads(
        path.read_text(
            encoding="utf-8",
        )
    )

    if not isinstance(value, dict):
        raise ValueError(
            f"Expected JSON object: {path}"
        )

    return value


def print_file(
    path: Path | None,
) -> int:
    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion attestation exists.",
            file=sys.stderr,
        )

        return 1

    print(
        path.read_text(
            encoding="utf-8",
        ),
        end="",
    )

    return 0


def build(
    *,
    refresh_verification: bool,
    strict: bool,
    remaining: list[str],
) -> int:
    if refresh_verification:
        status = execute(
            [
                str(PARENT_VERIFIER),
                (
                    "strict"
                    if strict
                    else "verify"
                ),
            ]
        )

        if status:
            return status

    command = [
        str(PYTHON),
        str(BUILDER),
    ]

    if strict:
        command.append(
            "--strict"
        )

    command.extend(
        remaining
    )

    return execute(command)


def status() -> int:
    path = latest_path()

    result: dict[str, object] = {
        "builder": str(BUILDER),
        "builder_exists": (
            BUILDER.is_file()
        ),
        "report_root": str(
            REPORT_ROOT
        ),
        "report_root_exists": (
            REPORT_ROOT.is_dir()
        ),
        "latest_attestation": (
            str(path)
            if path
            else None
        ),
        "latest_attestation_exists": (
            path.is_file()
            if path
            else False
        ),
    }

    if (
        path is not None
        and path.is_file()
    ):
        try:
            value = load_json(path)

            result[
                "generated_at"
            ] = value.get(
                "generated_at"
            )

            result[
                "passed"
            ] = value.get(
                "passed"
            )

            result[
                "digest"
            ] = value.get(
                "digest"
            )

            result[
                "subject"
            ] = value.get(
                "subject"
            )

            result[
                "parent"
            ] = value.get(
                "parent"
            )

            result[
                "relationships"
            ] = value.get(
                "relationships"
            )

            result[
                "authority"
            ] = value.get(
                "authority"
            )

            result[
                "implementation"
            ] = value.get(
                "implementation"
            )

            result[
                "global_verification"
            ] = value.get(
                "global_verification"
            )

            result[
                "promotion_queue"
            ] = value.get(
                "promotion_queue"
            )

        except Exception as exc:
            result[
                "read_error"
            ] = {
                "type": type(
                    exc
                ).__name__,
                "message": str(
                    exc
                ),
            }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def evidence() -> int:
    path = latest_path()

    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion attestation exists.",
            file=sys.stderr,
        )

        return 1

    value = load_json(path)

    print(
        json.dumps(
            {
                "subject": value.get(
                    "subject"
                ),
                "parent": value.get(
                    "parent"
                ),
                "relationships": value.get(
                    "relationships"
                ),
                "authority": value.get(
                    "authority"
                ),
                "implementation": value.get(
                    "implementation"
                ),
                "global_verification": value.get(
                    "global_verification"
                ),
                "promotion_queue": value.get(
                    "promotion_queue"
                ),
                "boundary": value.get(
                    "boundary"
                ),
                "passed": value.get(
                    "passed"
                ),
                "digest": value.get(
                    "digest"
                ),
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def usage() -> int:
    print(
        """
identity-promotion-attest build
identity-promotion-attest strict
identity-promotion-attest refresh
identity-promotion-attest refresh-strict
identity-promotion-attest status
identity-promotion-attest evidence
identity-promotion-attest json
identity-promotion-attest show
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "build":
        return build(
            refresh_verification=False,
            strict=False,
            remaining=remaining,
        )

    if command == "strict":
        return build(
            refresh_verification=False,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh":
        return build(
            refresh_verification=True,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-strict":
        return build(
            refresh_verification=True,
            strict=True,
            remaining=remaining,
        )

    if command == "status":
        return status()

    if command == "evidence":
        return evidence()

    if command == "json":
        return print_file(
            latest_path()
        )

    if command == "show":
        path = latest_path()

        if path is None:
            return print_file(None)

        return print_file(
            path.with_name(
                "latest.md"
            )
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
