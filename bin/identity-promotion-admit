#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

CONTENT_CONTROLLER = (
    ROOT
    / "bin"
    / "identity-promotion-content"
)

ADMITTER = (
    ROOT
    / "tools"
    / "identity_quality"
    / "promotion"
    / "admit_promotion_content_bundle.py"
)

REPORT_ROOT = (
    ROOT
    / "reports"
    / "identity_quality"
    / "promotion"
    / "admissions"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def latest_paths() -> list[Path]:
    if not REPORT_ROOT.is_dir():
        return []

    return sorted(
        (
            path
            for path in REPORT_ROOT.glob(
                "*/latest.json"
            )
            if path.is_file()
        ),
        key=lambda path: (
            path.stat().st_mtime_ns,
            path.as_posix(),
        ),
        reverse=True,
    )


def latest_path() -> Path | None:
    paths = latest_paths()

    if not paths:
        return None

    return paths[0]


def load_json(
    path: Path,
) -> dict[str, Any]:
    value = json.loads(
        path.read_text(
            encoding="utf-8",
        )
    )

    if not isinstance(value, dict):
        raise ValueError(
            f"Expected JSON object: {path}"
        )

    return value


def print_file(
    path: Path | None,
) -> int:
    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion admission exists.",
            file=sys.stderr,
        )

        return 1

    print(
        path.read_text(
            encoding="utf-8",
        ),
        end="",
    )

    return 0


def admit(
    *,
    refresh_content: bool,
    apply: bool,
    approve_existing: bool,
    strict: bool,
    remaining: list[str],
) -> int:
    if refresh_content:
        status = execute(
            [
                str(
                    CONTENT_CONTROLLER
                ),
                (
                    "refresh-strict"
                    if strict
                    else "refresh"
                ),
            ]
        )

        if status:
            return status

    command = [
        str(PYTHON),
        str(ADMITTER),
    ]

    if apply:
        command.append(
            "--apply"
        )

    if approve_existing:
        command.append(
            "--approve-existing"
        )

    if strict:
        command.append(
            "--strict"
        )

    command.extend(
        remaining
    )

    return execute(
        command
    )


def status() -> int:
    path = latest_path()

    result: dict[str, object] = {
        "admitter": str(
            ADMITTER
        ),
        "admitter_exists": (
            ADMITTER.is_file()
        ),
        "report_root": str(
            REPORT_ROOT
        ),
        "report_root_exists": (
            REPORT_ROOT.is_dir()
        ),
        "latest_admission": (
            str(path)
            if path
            else None
        ),
        "latest_admission_exists": (
            path.is_file()
            if path
            else False
        ),
    }

    if (
        path is not None
        and path.is_file()
    ):
        try:
            value = load_json(
                path
            )

            result[
                "generated_at"
            ] = value.get(
                "generated_at"
            )

            result[
                "mode"
            ] = value.get(
                "mode"
            )

            result[
                "passed"
            ] = value.get(
                "passed"
            )

            result[
                "digest"
            ] = value.get(
                "digest"
            )

            result[
                "subject"
            ] = value.get(
                "subject"
            )

            result[
                "review"
            ] = value.get(
                "review"
            )

            result[
                "statistics"
            ] = value.get(
                "statistics"
            )

            result[
                "transaction"
            ] = value.get(
                "transaction"
            )

            result[
                "rollback"
            ] = value.get(
                "rollback"
            )

        except Exception as exc:
            result[
                "read_error"
            ] = {
                "type": type(
                    exc
                ).__name__,
                "message": str(
                    exc
                ),
            }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def files() -> int:
    path = latest_path()

    if (
        path is None
        or not path.is_file()
    ):
        print(
            "ERROR: no promotion admission exists.",
            file=sys.stderr,
        )

        return 1

    value = load_json(
        path
    )

    print(
        json.dumps(
            {
                "subject": value.get(
                    "subject"
                ),
                "mode": value.get(
                    "mode"
                ),
                "passed": value.get(
                    "passed"
                ),
                "preflight": value.get(
                    "preflight"
                ),
                "review": value.get(
                    "review"
                ),
                "backups": value.get(
                    "backups"
                ),
                "files": value.get(
                    "files"
                ),
                "rollback": value.get(
                    "rollback"
                ),
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    return 0


def usage() -> int:
    print(
        """
identity-promotion-admit plan
identity-promotion-admit plan-strict
identity-promotion-admit refresh-plan
identity-promotion-admit refresh-plan-strict
identity-promotion-admit apply
identity-promotion-admit apply-strict
identity-promotion-admit apply-approved
identity-promotion-admit apply-approved-strict
identity-promotion-admit refresh-apply-approved
identity-promotion-admit refresh-apply-approved-strict
identity-promotion-admit status
identity-promotion-admit files
identity-promotion-admit json
identity-promotion-admit show
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "plan":
        return admit(
            refresh_content=False,
            apply=False,
            approve_existing=False,
            strict=False,
            remaining=remaining,
        )

    if command == "plan-strict":
        return admit(
            refresh_content=False,
            apply=False,
            approve_existing=False,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh-plan":
        return admit(
            refresh_content=True,
            apply=False,
            approve_existing=False,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-plan-strict":
        return admit(
            refresh_content=True,
            apply=False,
            approve_existing=False,
            strict=True,
            remaining=remaining,
        )

    if command == "apply":
        return admit(
            refresh_content=False,
            apply=True,
            approve_existing=False,
            strict=False,
            remaining=remaining,
        )

    if command == "apply-strict":
        return admit(
            refresh_content=False,
            apply=True,
            approve_existing=False,
            strict=True,
            remaining=remaining,
        )

    if command == "apply-approved":
        return admit(
            refresh_content=False,
            apply=True,
            approve_existing=True,
            strict=False,
            remaining=remaining,
        )

    if command == "apply-approved-strict":
        return admit(
            refresh_content=False,
            apply=True,
            approve_existing=True,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh-apply-approved":
        return admit(
            refresh_content=True,
            apply=True,
            approve_existing=True,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-apply-approved-strict":
        return admit(
            refresh_content=True,
            apply=True,
            approve_existing=True,
            strict=True,
            remaining=remaining,
        )

    if command == "status":
        return status()

    if command == "files":
        return files()

    if command == "json":
        return print_file(
            latest_path()
        )

    if command == "show":
        path = latest_path()

        if path is None:
            return print_file(
                None
            )

        return print_file(
            path.with_name(
                "latest.md"
            )
        )

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
