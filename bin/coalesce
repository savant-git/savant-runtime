#!/usr/bin/env python3

from __future__ import annotations

import os
import sys
from pathlib import Path


COALESCE = Path(
    "/root/savant-runtime/ontology/obelisks/_template/segue/"
    "gates/_template/segue/innates/_template/segue/exiles/"
    "modus/segue/prodigals/coalesce/bin/coalesce"
)


def main() -> int:
    if not COALESCE.is_file():
        print(
            f"canonical Coalesce executable missing: {COALESCE}",
            file=sys.stderr,
        )
        return 1

    os.execv(
        str(COALESCE),
        [
            str(COALESCE),
            *sys.argv[1:],
        ],
    )

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
