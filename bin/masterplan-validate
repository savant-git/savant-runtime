#!/usr/bin/env python3

from __future__ import annotations

import os
import sys
from pathlib import Path


ROOT = Path(
    "/root/savant-runtime"
)

VALIDATOR = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "run_masterplan_validation.sh"
)


def main() -> int:
    if not VALIDATOR.is_file():
        print(
            f"missing Masterplan validator: {VALIDATOR}",
            file=sys.stderr,
        )

        return 1

    os.execv(
        "/usr/bin/bash",
        [
            "/usr/bin/bash",
            str(
                VALIDATOR
            ),
            *sys.argv[1:],
        ],
    )

    return 1


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
