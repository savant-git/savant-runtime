#!/usr/bin/env python3
from __future__ import annotations

import filecmp
import os
import sys
from pathlib import Path


root = Path("/root/savant-runtime")
canon = root / "canon"

moves = (
    (
        root / "authority",
        canon / "authority",
    ),
    (
        root / "specifications",
        canon / "specifications",
    ),
)


class CanonizeError(RuntimeError):
    pass


def same_file(
    left: Path,
    right: Path,
) -> bool:
    return (
        left.is_file()
        and right.is_file()
        and filecmp.cmp(
            left,
            right,
            shallow=False,
        )
    )


def merge_directory(
    source: Path,
    destination: Path,
) -> None:
    destination.mkdir(
        parents=True,
        exist_ok=True,
    )

    for item in sorted(
        source.iterdir(),
        key=lambda path: path.name,
    ):
        target = (
            destination
            / item.name
        )

        if (
            not target.exists()
            and not target.is_symlink()
        ):
            os.replace(
                item,
                target,
            )
            continue

        if (
            item.is_dir()
            and not item.is_symlink()
            and target.is_dir()
            and not target.is_symlink()
        ):
            merge_directory(
                item,
                target,
            )

            if not any(
                item.iterdir()
            ):
                item.rmdir()

            continue

        if same_file(
            item,
            target,
        ):
            item.unlink()
            continue

        raise CanonizeError(
            "conflict while moving canon material: "
            f"{item} -> {target}"
        )


def move_tree(
    source: Path,
    destination: Path,
) -> None:
    if source.is_symlink():
        expected = os.path.relpath(
            destination,
            source.parent,
        )

        if os.readlink(
            source
        ) == expected:
            return

        raise CanonizeError(
            "unexpected compatibility symlink: "
            f"{source} -> {os.readlink(source)}"
        )

    if not source.exists():
        destination.mkdir(
            parents=True,
            exist_ok=True,
        )
        return

    if not source.is_dir():
        raise CanonizeError(
            f"expected directory: {source}"
        )

    if not destination.exists():
        destination.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        os.replace(
            source,
            destination,
        )
        return

    if not destination.is_dir():
        raise CanonizeError(
            "canonical destination is not a directory: "
            f"{destination}"
        )

    merge_directory(
        source,
        destination,
    )

    if (
        source.exists()
        and not any(
            source.iterdir()
        )
    ):
        source.rmdir()


def compatibility_link(
    source: Path,
    destination: Path,
) -> None:
    if (
        source.exists()
        or source.is_symlink()
    ):
        if source.is_symlink():
            expected = os.path.relpath(
                destination,
                source.parent,
            )

            if os.readlink(
                source
            ) == expected:
                return

        raise CanonizeError(
            "cannot establish compatibility path because it already exists: "
            f"{source}"
        )

    source.symlink_to(
        os.path.relpath(
            destination,
            source.parent,
        ),
        target_is_directory=True,
    )


def main() -> int:
    if not root.is_dir():
        raise CanonizeError(
            f"missing Savant runtime root: {root}"
        )

    canon.mkdir(
        parents=True,
        exist_ok=True,
    )

    for (
        source,
        destination,
    ) in moves:
        move_tree(
            source,
            destination,
        )

        compatibility_link(
            source,
            destination,
        )

    print(
        "canon authority: "
        f"{canon / 'authority'}"
    )

    print(
        "canon specifications: "
        f"{canon / 'specifications'}"
    )

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(
            main()
        )

    except CanonizeError as exc:
        print(
            "canonize-specifications: "
            f"{exc}",
            file=sys.stderr,
        )

        raise SystemExit(1)
