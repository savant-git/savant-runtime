#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(
    "/root/savant-runtime"
)

if str(ROOT) not in sys.path:
    sys.path.insert(
        0,
        str(ROOT),
    )


from runtime.constitution import (
    ConstitutionalRegistry,
)

from runtime.scrybe import (
    Scrybe,
)


def engine(
    instance: str,
) -> Scrybe:
    registry = (
        ConstitutionalRegistry
        .load(
            ROOT
        )
    )

    return Scrybe.install(
        registry,
        instance=instance,
    )


def build_parser(
) -> argparse.ArgumentParser:
    parser = (
        argparse.ArgumentParser(
            description=(
                "Scrybe — Savant "
                "living memory substrate"
            )
        )
    )

    parser.add_argument(
        "--instance",
        default="lore",
    )

    commands = (
        parser
        .add_subparsers(
            dest="command",
            required=True,
        )
    )

    commands.add_parser(
        "profile"
    )

    commands.add_parser(
        "validate"
    )

    commands.add_parser(
        "health"
    )

    recall = (
        commands.add_parser(
            "recall"
        )
    )

    recall.add_argument(
        "query"
    )

    recall.add_argument(
        "--limit",
        type=int,
        default=9,
    )

    recall.add_argument(
        "--type",
        dest="memory_type",
    )

    recall.add_argument(
        "--at",
    )

    context = (
        commands.add_parser(
            "context"
        )
    )

    context.add_argument(
        "query"
    )

    context.add_argument(
        "--limit",
        type=int,
    )

    context.add_argument(
        "--at",
    )

    explain = (
        commands.add_parser(
            "explain"
        )
    )

    explain.add_argument(
        "query"
    )

    explain.add_argument(
        "--limit",
        type=int,
        default=9,
    )

    explain.add_argument(
        "--at",
    )

    remember = (
        commands.add_parser(
            "remember"
        )
    )

    remember.add_argument(
        "identity"
    )

    feed = (
        commands.add_parser(
            "feed"
        )
    )

    feed.add_argument(
        "--limit",
        type=int,
        default=18,
    )

    feed.add_argument(
        "--type",
        dest="memory_type",
    )

    feed.add_argument(
        "--at",
    )

    return parser


def main() -> int:
    arguments = (
        build_parser()
        .parse_args()
    )

    scrybe = engine(
        arguments.instance
    )

    if (
        arguments.command
        == "profile"
    ):
        result = (
            scrybe.profile()
        )

    elif (
        arguments.command
        == "validate"
    ):
        result = (
            scrybe.validate()
        )

    elif (
        arguments.command
        == "health"
    ):
        result = (
            scrybe.health()
        )

    elif (
        arguments.command
        == "recall"
    ):
        result = (
            scrybe.recall(
                arguments.query,
                limit=(
                    arguments.limit
                ),
                memory_type=(
                    arguments
                    .memory_type
                ),
                at=arguments.at,
            )
        )

    elif (
        arguments.command
        == "context"
    ):
        result = (
            scrybe.hydrate(
                arguments.query,
                limit=(
                    arguments.limit
                ),
                at=arguments.at,
            )
        )

    elif (
        arguments.command
        == "explain"
    ):
        result = (
            scrybe.explain(
                arguments.query,
                limit=(
                    arguments.limit
                ),
                at=arguments.at,
            )
        )

    elif (
        arguments.command
        == "remember"
    ):
        result = (
            scrybe.remember(
                arguments.identity
            )
        )

    elif (
        arguments.command
        == "feed"
    ):
        result = (
            scrybe.feed(
                memory_type=(
                    arguments
                    .memory_type
                ),
                at=arguments.at,
                limit=(
                    arguments.limit
                ),
            )
        )

    else:
        raise RuntimeError(
            "unsupported command"
        )

    print(
        json.dumps(
            result,
            indent=2,
            sort_keys=True,
            default=str,
        )
    )

    if (
        arguments.command
        == "validate"
        and not result[
            "valid"
        ]
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
