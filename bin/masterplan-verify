    / "apply_masterplan_decision.py",
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "admit_masterplan_evidence.py",
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "build_masterplan_attestation.py",
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "complete_masterplan_task.py",
    ROOT
    / "tools"
    / "niche"
