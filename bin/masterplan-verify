    / "bin"
    / "masterplan-segue-verify",
)


EXECUTABLE_FILES = (
    MASTERPLAN_BUILD,
    MASTERPLAN_PROJECT,
    MASTERPLAN_GATE,
    MASTERPLAN_SCHEMA,
    MASTERPLAN_SCHEMA_VALIDATE,
    MASTERPLAN_POLICY,
    MASTERPLAN_MANIFEST,
    MASTERPLAN_INTEGRITY_TREE,
    MASTERPLAN_SEGUE_VERIFY,
    MASTERPLAN_REPLAY,
    MASTERPLAN_AUDIT,
)


def execute(
    command: list[str],
) -> dict[str, Any]:
    completed = subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
        capture_output=True,
        text=True,
    )

    return {
        "command": command,
        "returncode": completed.returncode,
        "passed": (
            completed.returncode
            == 0
        ),
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }


def file_check() -> dict[str, Any]:
    missing = [
        str(path)
        for path in REQUIRED_FILES
        if not path.is_file()
    ]

    non_executable = [
        str(path)
        for path in EXECUTABLE_FILES
        if (
            path.is_file()
            and not (
                path.stat().st_mode
                & 0o111
            )
        )
    ]

    return {
        "passed": (
            not missing
            and not non_executable
        ),
        "required_count": len(
            REQUIRED_FILES
        ),
        "executable_count": len(
            EXECUTABLE_FILES
        ),
        "missing": missing,
        "non_executable": (
            non_executable
        ),
    }


def test_files() -> list[Path]:
    return sorted(
        (
            path
            for path in TEST_ROOT.glob(
                "test_masterplan*.py"
            )
            if path.is_file()
        ),
        key=lambda path: path.name,
    )


def stage(
    stage_id: str,
    command: list[str],
) -> dict[str, Any]:
    result = execute(
        command
    )

    result[
        "stage_id"
    ] = stage_id

    return result


def main() -> int:
    strict = (
        "--strict"
        in sys.argv[1:]
    )

    unknown_arguments = [
        argument
        for argument in sys.argv[1:]
        if argument != "--strict"
    ]

    if unknown_arguments:
        print(
            json.dumps(
                {
                    "operation": (
                        "verify_masterplan_prodigal"
                    ),
                    "passed": False,
                    "error": {
                        "type": "ArgumentError",
                        "message": (
                            "Unknown arguments: "
                            + " ".join(
                                unknown_arguments
                            )
                        ),
                    },
                },
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
        )

        return 2

    files = file_check()
    tests = test_files()

    stages: list[
        dict[str, Any]
    ] = []

    stage_definitions = [
        (
            "compile",
            [
                str(PYTHON),
                "-m",
                "py_compile",
                *[
                    str(path)
                    for path in REQUIRED_FILES
                    if path.suffix == ".py"
                ],
                *[
                    str(path)
                    for path in tests
                ],
            ],
        ),
        (
            "tests",
            [
                str(PYTHON),
                "-m",
                "pytest",
                "-q",
                *[
                    str(path)
                    for path in tests
                ],
            ],
        ),
        (
            "schema-registry",
            [
                str(MASTERPLAN_SCHEMA),
                "registry",
            ],
        ),
        (
            "schema-runtime-validation",
            [
                str(MASTERPLAN_SCHEMA),
                "validate",
            ],
        ),
        (
            "json-schema-validation",
            [
                str(
                    MASTERPLAN_SCHEMA_VALIDATE
                ),
                "publish-strict",
            ],
        ),
        (
            "policy-runtime",
            [
                str(MASTERPLAN_POLICY),
                "verify",
            ],
        ),
        (
            "graph-build",
            [
                str(MASTERPLAN_BUILD),
                "strict",
            ],
        ),
        (
            "roadmap-projection",
            [
                str(MASTERPLAN_PROJECT),
                "strict",
            ],
        ),
        (
            "agent-context",
            [
                str(MASTERPLAN_GATE),
                "context",
            ],
        ),
        (
            "segue-reconciliation",
            [
                str(
                    MASTERPLAN_SEGUE_VERIFY
                ),
            ],
        ),
        (
            "artifact-manifests",
            [
                str(MASTERPLAN_MANIFEST),
                "persist-all",
            ],
        ),
        (
            "merkle-integrity-tree",
            [
                str(
                    MASTERPLAN_INTEGRITY_TREE
                ),
                "refresh-verify",
            ],
        ),
        (
            "graph-replay",
            [
                str(MASTERPLAN_REPLAY),
                "strict",
            ],
        ),
        (
            "integrity-audit",
            [
                str(MASTERPLAN_AUDIT),
                "strict",
            ],
        ),
    ]

    if files["passed"] and tests:
        for stage_id, command in (
            stage_definitions
        ):
            result = stage(
                stage_id,
                command,
            )

            stages.append(
                result
            )

            if not result[
                "passed"
            ]:
                break

    passed = all(
        (
            files["passed"],
            bool(tests),
            len(stages)
            == len(
                stage_definitions
            ),
            all(
                stage_result[
                    "passed"
                ]
                for stage_result
                in stages
            ),
        )
    )

    payload = {
        "schema": (
            "savant://niche/masterplan/"
            "integrated-verification/1.2.0"
        ),
        "operation": (
            "verify_masterplan_prodigal"
        ),
        "passed": passed,
        "strict": strict,
        "files": files,
        "tests": {
            "count": len(tests),
            "paths": [
                str(path)
                for path in tests
            ],
        },
        "statistics": {
            "planned_stage_count": len(
                stage_definitions
            ),
            "executed_stage_count": len(
                stages
            ),
            "passed_stage_count": sum(
                result[
                    "passed"
                ]
                for result in stages
            ),
            "failed_stage_count": sum(
                not result[
                    "passed"
                ]
                for result in stages
            ),
        },
        "stages": stages,
    }

    print(
        json.dumps(
            payload,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
    )

    if strict and not passed:
        return 1

    return (
        0
        if passed
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
