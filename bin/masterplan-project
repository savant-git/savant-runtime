#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = ROOT / "bin" / "identity-quality-python"

BUILDER = ROOT / "bin" / "masterplan-build"

PROJECTOR = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "project_masterplan_markdown.py"
)

MASTERPLANCTL = ROOT / "bin" / "masterplanctl"

ROADMAP = ROOT / "docs" / "SAVANT_MASTER_TASKS.md"


def execute(command: list[str]) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def project(
    *,
    rebuild: bool,
    strict: bool,
    remaining: list[str],
) -> int:
    if rebuild:
        status = execute(
            [
                str(BUILDER),
                "strict" if strict else "build",
            ]
        )

        if status:
            return status

    if not PROJECTOR.is_file():
        print(
            f"ERROR: projector missing: {PROJECTOR}",
            file=sys.stderr,
        )

        return 1

    command = [
        str(PYTHON),
        str(PROJECTOR),
    ]

    if strict:
        command.append("--strict")

    command.extend(remaining)

    return execute(command)


def usage() -> int:
    print(
        """
masterplan-project build
masterplan-project strict
masterplan-project refresh
masterplan-project refresh-strict
masterplan-project verify
masterplan-project show
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command == "build":
        return project(
            rebuild=False,
            strict=False,
            remaining=remaining,
        )

    if command == "strict":
        return project(
            rebuild=False,
            strict=True,
            remaining=remaining,
        )

    if command == "refresh":
        return project(
            rebuild=True,
            strict=False,
            remaining=remaining,
        )

    if command == "refresh-strict":
        return project(
            rebuild=True,
            strict=True,
            remaining=remaining,
        )

    if command == "verify":
        status = project(
            rebuild=True,
            strict=True,
            remaining=[],
        )

        if status:
            return status

        return execute(
            [
                str(MASTERPLANCTL),
                "verify",
            ]
        )

    if command == "show":
        if not ROADMAP.is_file():
            status = project(
                rebuild=True,
                strict=True,
                remaining=[],
            )

            if status:
                return status

        print(
            ROADMAP.read_text(
                encoding="utf-8",
            ),
            end="",
        )

        return 0

    print(
        f"ERROR: unknown command: {command}",
        file=sys.stderr,
    )

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
