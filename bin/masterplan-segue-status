#!/usr/bin/env python3
from __future__ import annotations

import subprocess
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

CHECKER = (
    ROOT
    / "tools"
    / "niche"
    / "masterplan"
    / "check_segue_reconciliation_state.py"
)


def main() -> int:
    return subprocess.run(
        [
            str(PYTHON),
            str(CHECKER),
        ],
        cwd=str(ROOT),
        check=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
