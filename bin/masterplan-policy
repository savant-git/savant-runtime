#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path("/root/savant-runtime")

PYTHON = (
    ROOT
    / "bin"
    / "identity-quality-python"
)

RUNTIME = (
    ROOT
    / "hierarchies"
    / "identity"
    / "exiles"
    / "niche"
    / "prodigals"
    / "masterplan"
    / "policies"
    / "masterplan_policy_runtime.py"
)


def execute(
    command: list[str],
) -> int:
    return subprocess.run(
        command,
        cwd=str(ROOT),
        check=False,
    ).returncode


def usage() -> int:
    print(
        """
masterplan-policy seed
masterplan-policy validate
masterplan-policy registry
masterplan-policy evaluate TASK_ID OPERATION
masterplan-policy verify
"""
    )

    return 0


def main() -> int:
    arguments = sys.argv[1:]

    if not arguments:
        return usage()

    command = arguments[0]
    remaining = arguments[1:]

    if command in {
        "help",
        "--help",
        "-h",
    }:
        return usage()

    if command in {
        "seed",
        "validate",
        "registry",
    }:
        mapped = [
            command,
        ]

    elif command == "evaluate":
        if len(remaining) != 2:
            print(
                (
                    "ERROR: evaluate requires "
                    "TASK_ID and OPERATION."
                ),
                file=sys.stderr,
            )

            return 2

        mapped = [
            "evaluate",
            *remaining,
        ]

    elif command == "verify":
        for mapped in (
            ["seed"],
            ["validate"],
            ["registry"],
        ):
            status = execute(
                [
                    str(PYTHON),
                    str(RUNTIME),
                    *mapped,
                ]
            )

            if status:
                return status

        return 0

    else:
        print(
            f"ERROR: unknown policy command: {command}",
            file=sys.stderr,
        )

        return 2

    return execute(
        [
            str(PYTHON),
            str(RUNTIME),
            *mapped,
        ]
    )


if __name__ == "__main__":
    raise SystemExit(main())
