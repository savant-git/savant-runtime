def add_evidence(
    graph,
    observation: str,
    epistemic_class: str,
    tags: tuple[str, ...],
) -> None:
    graph.add_evidence(
        Evidence(
            subject_id=graph.character_id,
            observation=observation,
            source=SOURCE,
            epistemic_class=epistemic_class,
            evidence_state="admitted",
            tags=tags,
        )
    )


def build_character(
    runtime: GuiseRuntime,
    character_id: str,
    display_name: str,
    role: str,
    aliases: tuple[str, ...],
):
    graph = runtime.new_character(
        character_id,
        display_name=display_name,
    )

    add_evidence(
        graph,
        (
            f"{display_name} is a canonical member of "
            f"the {AFFILIATION}."
        ),
        "explicit",
        ("sgis", "affiliation"),
    )

    add_evidence(
        graph,
        (
            f"{display_name}'s established touring "
            f"position is {role}."
        ),
        "explicit",
        ("sgis", "role"),
    )

    if aliases:
        add_evidence(
            graph,
            (
                f"Canonical supplied nickname"
                f"{'s' if len(aliases) != 1 else ''}: "
                f"{', '.join(aliases)}."
            ),
            "explicit",
            ("identity", "nickname"),
        )

    graph.provenance.append(
        {
            "source_id": SOURCE.source_id,
            "source_kind": SOURCE.source_kind,
            "authority_class": (
                SOURCE.authority_class
            ),
            "purpose": (
                "Sun Gods in Shadow touring crew "
                "character substantiation"
            ),
        }
    )

    graph.unresolved.append(
        (
            "Character information not explicitly "
            "established by admitted VISCERA canon "
            "remains unknown."
        )
    )

    return graph


def main() -> int:
    runtime = GuiseRuntime()

    character_ids = tuple(
        item[0]
        for item in ROSTER
    )

    if len(character_ids) != 49:
        raise RuntimeError(
            "canonical SGIS roster must contain "
            "exactly 49 characters"
        )

    if len(set(character_ids)) != 49:
        raise RuntimeError(
            "duplicate SGIS character_id detected"
        )

    collisions = [
        character_id
        for character_id in character_ids
        if runtime.store.exists(character_id)
    ]

    if collisions:
        print(
            json.dumps(
                {
                    "status": "aborted",
                    "reason": (
                        "existing guise character "
                        "collision"
                    ),
                    "characters": collisions,
                    "character_count": len(
                        collisions
                    ),
                    "authority_effect": "none",
                },
                ensure_ascii=False,
                sort_keys=True,
                indent=2,
            )
        )
        return 2

    saved = []

    for (
        character_id,
        display_name,
        role,
        aliases,
    ) in ROSTER:
        graph = build_character(
            runtime,
            character_id,
            display_name,
            role,
            aliases,
        )

        for (
            observation,
            epistemic_class,
            tags,
        ) in EXTRA_EVIDENCE.get(
            character_id,
            (),
        ):
            add_evidence(
                graph,
                observation,
                epistemic_class,
                tags,
            )

        if character_id == (
            "agatha-aggie-ortoza"
        ):
            for (
                observation,
                epistemic_class,
                tags,
            ) in AGGIE_EVIDENCE:
                add_evidence(
                    graph,
                    observation,
                    epistemic_class,
                    tags,
                )

        elif character_id == "derek-marlow":
            for (
                observation,
                epistemic_class,
                tags,
            ) in MARLOW_EVIDENCE:
                add_evidence(
                    graph,
                    observation,
                    epistemic_class,
                    tags,
                )

        elif character_id == (
            "peter-peeny-daly"
        ):
            for (
                observation,
                epistemic_class,
                tags,
            ) in PEENY_EVIDENCE:
                add_evidence(
                    graph,
                    observation,
                    epistemic_class,
                    tags,
                )

        projection = graph.projection(
            runtime.guise.manifest
        )

        saved.append(
            runtime.store.save_projection(
                projection
            )
        )

    status = runtime.store.status()

    missing = [
        character_id
        for character_id in character_ids
        if not runtime.store.exists(
            character_id
        )
    ]

    result = {
        "status": (
            "ok"
            if not missing
            else "incomplete"
        ),
        "operation": (
            "sgis_guise_character_import"
        ),
        "requested_character_count": 49,
        "saved_character_count": len(saved),
        "missing": missing,
        "guise_store_character_count": (
            status["character_count"]
        ),
        "saved": saved,
        "automatic_canonization": False,
        "authority_effect": "none",
    }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            sort_keys=True,
            indent=2,
        )
    )

    return 0 if not missing else 1


if __name__ == "__main__":
    raise SystemExit(main())
