#!/usr/bin/env python3

from __future__ import annotations

import json
import sys

from pathlib import Path


root = Path(
    "/root/savant-runtime"
)

if str(
    root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            root
        ),
    )


from runtime.constitution import (  # noqa: E402
    ConstitutionalRegistry,
    ConstitutionalValidator,
)

from runtime.living_guard_constitutional import (  # noqa: E402
    engine_id,
    install,
    operator_id,
)


def main() -> int:
    registry = (
        ConstitutionalRegistry.load(
            root
        )
    )

    installed = install(
        registry
    )

    validation = (
        ConstitutionalValidator(
            installed
        ).validate()
    )

    present = (
        operator_id
        in installed.ids
    )

    result = {
        "schema":
            (
                "savant.living-governance."
                "guard-constitutional.v1"
            ),

        "owner":
            "living-governance",

        "engine":
            engine_id,

        "operator":
            operator_id,

        "operator_present":
            present,

        "constitutional_valid":
            bool(
                validation.get(
                    "valid",
                    False,
                )
            ),

        "authority_effect":
            (
                "constitutional-extension"
                if present
                else "none"
            ),

        "credential_values_exposed":
            False,
    }

    print(
        json.dumps(
            result,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    return (
        0
        if (
            result[
                "operator_present"
            ]
            and result[
                "constitutional_valid"
            ]
        )
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
