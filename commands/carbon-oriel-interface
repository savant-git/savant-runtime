#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel_capabilities import (  # noqa: E402
    collect,
    oriel_capabilities_error,
)

from oriel_interface import (  # noqa: E402
    interface_contracts,
    operation_catalog,
    oriel_interface_error,
    profile,
    selftest,
    status,
)

from oriel_introspection import (  # noqa: E402
    oriel_introspection_error,
    snapshot,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-interface",
        description=(
            "carbon public interface for "
            "oriel specialization discovery "
            "and introspection"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    for name in (
        "status",
        "selftest",
        "profile",
        "operations",
        "capabilities",
        "contracts",
        "health",
    ):
        subparsers.add_parser(
            name
        )

    return parser


def main() -> int:
    args = build_parser().parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "profile":
            output = profile()

        elif args.command == "operations":
            output = operation_catalog()

        elif args.command == "capabilities":
            output = collect()

        elif args.command == "contracts":
            output = interface_contracts()

        elif args.command == "health":
            output = snapshot()

        else:
            raise ValueError(
                "unknown command"
            )

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_capabilities_error,
        oriel_interface_error,
        oriel_introspection_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and output.get(
            "ok"
        )
        is False
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
