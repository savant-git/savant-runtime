#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(runtime_root) not in sys.path:
    sys.path.insert(
        0,
        str(runtime_root),
    )


from oriel_closure import (  # noqa: E402
    close,
    evaluate,
    oriel_closure_error,
    selftest,
    status,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-close",
        description=(
            "current-validation closure gate "
            "for carbon.oriel"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "evaluate"
    )

    subparsers.add_parser(
        "close"
    )

    subparsers.add_parser(
        "selftest"
    )

    return parser


def main() -> int:
    args = build_parser().parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "evaluate":
            output = evaluate()

        elif args.command == "close":
            output = close()

        elif args.command == "selftest":
            output = selftest()

        else:
            raise ValueError(
                "unknown command"
            )

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_closure_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "schema":
                        "savant.carbon.oriel-closure.v1",

                    "kind":
                        "closure-error",

                    "owner":
                        "carbon",

                    "component":
                        "oriel-closure",

                    "authority_effect":
                        "none",

                    "ok":
                        False,

                    "closed":
                        False,

                    "error":
                        str(exc),

                    "authority_transfer":
                        False,
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and (
            output.get(
                "ok"
            )
            is False
            or output.get(
                "closed"
            )
            is False
        )
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
