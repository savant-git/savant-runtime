#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel_capabilities import (  # noqa: E402
    oriel_capabilities_error,
)

from oriel_composition import (  # noqa: E402
    export_packet,
    import_reference,
    oriel_composition_error,
    profile,
    selftest,
    specialization_reference,
    status,
)

from oriel_introspection import (  # noqa: E402
    oriel_introspection_error,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_object(
    path: str,
) -> dict[str, Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "input must be a JSON object"
        )

    return value


def csv_values(
    value: str | None,
) -> list[str]:
    if value is None:
        return []

    return [
        item.strip()
        for item
        in value.split(
            ","
        )
        if item.strip()
    ]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-composition",
        description=(
            "carbon oriel reference-only "
            "composition boundary"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "selftest"
    )

    subparsers.add_parser(
        "profile"
    )

    subparsers.add_parser(
        "specialization"
    )

    export_parser = (
        subparsers.add_parser(
            "export"
        )
    )

    export_parser.add_argument(
        "--target-exile",
        required=True,
    )

    export_parser.add_argument(
        "--mask"
    )

    export_parser.add_argument(
        "--no-dependencies",
        action="store_true",
    )

    import_parser = (
        subparsers.add_parser(
            "import-reference"
        )
    )

    import_parser.add_argument(
        "--import-id",
        required=True,
    )

    import_parser.add_argument(
        "--references",
        required=True,
    )

    return parser


def main() -> int:
    args = build_parser().parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "profile":
            output = profile()

        elif args.command == "specialization":
            output = (
                specialization_reference()
            )

        elif args.command == "export":
            mask = (
                read_object(
                    args.mask
                )
                if args.mask
                else None
            )

            output = export_packet(
                target_exile=
                    args.target_exile,
                mask=
                    mask,
                include_dependencies=(
                    not args.no_dependencies
                ),
            )

        elif args.command == "import-reference":
            output = import_reference(
                import_id=
                    args.import_id,
                references=
                    csv_values(
                        args.references
                    ),
            )

        else:
            raise ValueError(
                "unknown command"
            )

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_capabilities_error,
        oriel_composition_error,
        oriel_introspection_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and output.get(
            "ok"
        )
        is False
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
