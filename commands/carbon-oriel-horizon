#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel import (  # noqa: E402
    oriel_error,
)

from oriel_horizon import (  # noqa: E402
    capability_manifest,
    engine,
    oriel_horizon_error,
    selftest,
    status,
)

from oriel_reality import (  # noqa: E402
    oriel_reality_error,
)

from oriel_simulation import (  # noqa: E402
    oriel_simulation_error,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_object(
    path: str,
) -> dict[str, Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "input must be a JSON object"
        )

    return value


def read_list(
    path: str,
) -> list[Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        list,
    ):
        raise ValueError(
            "input must be a JSON list"
        )

    return value


def csv_values(
    value: str | None,
) -> list[str]:
    if value is None:
        return []

    return [
        item.strip()
        for item
        in value.split(
            ","
        )
        if item.strip()
    ]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-horizon",
        description=(
            "Carbon-owned Oriel spacetime "
            "reachability and optionality analysis"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "capabilities"
    )

    subparsers.add_parser(
        "selftest"
    )

    reachability_parser = (
        subparsers.add_parser(
            "reachability"
        )
    )

    reachability_parser.add_argument(
        "--oriel",
        required=True,
    )

    reachability_parser.add_argument(
        "--facts",
        required=True,
    )

    reachability_parser.add_argument(
        "--entity",
        required=True,
    )

    reachability_parser.add_argument(
        "--timestamp",
        required=True,
    )

    reachability_parser.add_argument(
        "--duration-minutes",
        type=int,
        default=60,
    )

    reachability_parser.add_argument(
        "--mode",
        default="tour_bus",
    )

    reachability_parser.add_argument(
        "--candidate-locations"
    )

    reachability_parser.add_argument(
        "--until"
    )

    frontier_parser = (
        subparsers.add_parser(
            "frontier"
        )
    )

    frontier_parser.add_argument(
        "cone"
    )

    opportunities_parser = (
        subparsers.add_parser(
            "opportunities"
        )
    )

    opportunities_parser.add_argument(
        "--cone",
        required=True,
    )

    opportunities_parser.add_argument(
        "--facts",
        required=True,
    )

    opportunities_parser.add_argument(
        "--historical-entity"
    )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "capabilities":
            output = capability_manifest()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "reachability":
            output = engine.reachability(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
                entity=
                    args.entity,
                timestamp=
                    args.timestamp,
                duration_minutes=
                    args.duration_minutes,
                mode=
                    args.mode,
                candidate_locations=
                    csv_values(
                        args.candidate_locations
                    ),
                until=
                    args.until,
            )

        elif args.command == "frontier":
            output = engine.frontier(
                read_object(
                    args.cone
                )
            )

        elif args.command == "opportunities":
            output = (
                engine.historical_opportunities(
                    read_object(
                        args.cone
                    ),
                    read_list(
                        args.facts
                    ),
                    historical_entity=
                        args.historical_entity,
                )
            )

        else:
            parser.error(
                "unknown command"
            )

            return 2

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_error,
        oriel_horizon_error,
        oriel_reality_error,
        oriel_simulation_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and output.get(
            "ok"
        )
        is False
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
