#!/usr/bin/env python3
from __future__ import annotations
import argparse
import json
import sys
from pathlib import Path
from typing import Any

runtime_root = Path('/root/savant-runtime/ontology/obelisks/_template/segue/gates/_template/segue/innates/_template/segue/exiles/carbon/runtime')

if str(runtime_root) not in sys.path:
    sys.path.insert(0, str(runtime_root))

from oriel import oriel_error
from oriel_causality import capability_manifest, engine, oriel_causality_error, selftest, status

def read_json(path: str) -> Any:
    if path == '-':
        return json.load(sys.stdin)
    return json.loads(Path(path).read_text(encoding='utf-8'))

def read_object(path: str) -> dict[str, Any]:
    value = read_json(path)
    if not isinstance(value, dict):
        raise ValueError('input must be a JSON object')
    return value

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog='carbon-oriel-causality', description='Carbon-owned Oriel causal-logistics projection and ripple analysis')
    subparsers = parser.add_subparsers(dest='command', required=True)
    subparsers.add_parser('status')
    subparsers.add_parser('capabilities')
    subparsers.add_parser('selftest')

    graph_parser = subparsers.add_parser('graph')
    graph_parser.add_argument('--oriel', required=True)
    graph_parser.add_argument('--mode', default='tour_bus')
    graph_parser.add_argument('--pressure-threshold-minutes', type=float, default=60.0)

    corridor_parser = subparsers.add_parser('corridor')
    corridor_parser.add_argument('--oriel', required=True)
    corridor_parser.add_argument('--target-event', required=True)
    corridor_parser.add_argument('--mode', default='tour_bus')

    horizon_parser = subparsers.add_parser('horizon')
    horizon_parser.add_argument('--oriel', required=True)
    horizon_parser.add_argument('--source-event', required=True)
    horizon_parser.add_argument('--target-event', required=True)
    horizon_parser.add_argument('--mode', default='tour_bus')

    propagate_parser = subparsers.add_parser('propagate')
    propagate_parser.add_argument('--oriel', required=True)
    propagate_parser.add_argument('--intervention', required=True)
    propagate_parser.add_argument('--mode', default='tour_bus')

    return parser

def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        if args.command == 'status':
            output = status()
        elif args.command == 'capabilities':
            output = capability_manifest()
        elif args.command == 'selftest':
            output = selftest()
        elif args.command == 'graph':
            output = engine.graph(read_object(args.oriel), mode=args.mode, pressure_threshold_minutes=args.pressure_threshold_minutes)
        elif args.command == 'corridor':
            output = engine.critical_corridor(read_object(args.oriel), target_event=args.target_event, mode=args.mode)
        elif args.command == 'horizon':
            output = engine.inevitability_horizon(read_object(args.oriel), source_event=args.source_event, target_event=args.target_event, mode=args.mode)
        elif args.command == 'propagate':
            output = engine.propagate(read_object(args.oriel), read_object(args.intervention), mode=args.mode)
        else:
            parser.error('unknown command')
            return 2
    except (OSError, ValueError, json.JSONDecodeError, oriel_error, oriel_causality_error) as exc:
        print(json.dumps({'ok': False, 'error': str(exc)}, indent=2, sort_keys=True))
        return 1

    print(json.dumps(output, indent=2, ensure_ascii=False, sort_keys=True))

    if isinstance(output, dict) and output.get('ok') is False:
        return 1

    return 0

if __name__ == '__main__':
    raise SystemExit(main())
