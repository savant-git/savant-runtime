#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/coda/runtime"
)

if str(runtime_root) not in sys.path:
    sys.path.insert(
        0,
        str(runtime_root),
    )


from governance_surface import (  # noqa: E402
    coda_governance_surface_error,
    descriptors,
    selftest,
    status,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="coda-governance-surface",
        description=(
            "Coda governance-aware mutation "
            "receipt surface"
        ),
    )

    commands = parser.add_subparsers(
        dest="command",
        required=True,
    )

    commands.add_parser(
        "status"
    )

    commands.add_parser(
        "selftest"
    )

    commands.add_parser(
        "describe"
    )

    return parser


def main() -> int:
    args = (
        build_parser()
        .parse_args()
    )

    try:
        if args.command == "status":
            output = status()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "describe":
            output = descriptors()

        else:
            raise ValueError(
                "unknown command"
            )

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        coda_governance_surface_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "schema":
                        (
                            "savant.coda."
                            "governance-surface.v1"
                        ),

                    "owner":
                        "coda",

                    "governance_owner":
                        "living-governance",

                    "authority_effect":
                        "none",

                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),

                    "authority_transfer":
                        False,
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
