#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


root = Path(
    "/root/savant-runtime"
)

if str(
    root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            root
        ),
    )


from runtime.living_plan_evidence import (  # noqa: E402
    living_plan_evidence_error,
    one,
    projection,
    status,
)


def load_context(
    path: str | None,
) -> dict[str, Any]:
    if path is None:
        return {}

    value = json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "context must be a json object"
        )

    return value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="living-plan-evidence",
        description=(
            "evidence-backed completion and "
            "next-work projection over masterplan"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    for name in (
        "show",
        "next",
    ):
        child = subparsers.add_parser(
            name
        )

        if name == "show":
            child.add_argument(
                "id"
            )

        child.add_argument(
            "--evidence",
            action="append",
            default=[],
        )

        child.add_argument(
            "--context"
        )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "show":
            output = one(
                args.id,
                evidence=args.evidence,
                context=load_context(
                    args.context
                ),
            )

        elif args.command == "next":
            result = projection(
                evidence=args.evidence,
                context=load_context(
                    args.context
                ),
            )

            output = {
                "schema":
                    (
                        "savant.living-plan."
                        "next-projection.v1"
                    ),

                "owner":
                    result[
                        "owner"
                    ],

                "authority_effect":
                    result[
                        "authority_effect"
                    ],

                "stream":
                    result[
                        "stream"
                    ],

                "next":
                    result[
                        "next"
                    ],

                "action_counts":
                    result[
                        "action_counts"
                    ],
            }

        else:
            parser.error(
                "unknown command"
            )

            return 2

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        living_plan_evidence_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
