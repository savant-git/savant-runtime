#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


CARBON_RUNTIME = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

sys.path.insert(
    0,
    str(CARBON_RUNTIME),
)

from cameo import CameoRuntime


def emit(
    value,
) -> None:
    print(
        json.dumps(
            value,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        prog="carbon-cameo"
    )

    sub = root.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser("health")

    policy = sub.add_parser("policy")

    policy.add_argument(
        "--involvement",
        type=float,
        required=True,
    )

    reason = sub.add_parser("reason")

    reason.add_argument(
        "--task",
        required=True,
    )

    reason.add_argument(
        "--anchor",
        action="append",
        default=[],
    )

    reason.add_argument(
        "--constraint",
        action="append",
        default=[],
    )

    reason.add_argument(
        "--destination",
    )

    reason.add_argument(
        "--context",
        default="",
    )

    reason.add_argument(
        "--mode",
        choices=(
            "diagnostic",
            "expansion",
            "bridge",
            "convergence",
            "directed_possibility",
            "open_catalyst",
        ),
        default="bridge",
    )

    reason.add_argument(
        "--involvement",
        type=float,
        default=50.0,
    )

    return root


def main() -> int:
    args = parser().parse_args()
    runtime = CameoRuntime()

    if args.command == "health":
        emit(runtime.health())
        return 0

    if args.command == "policy":
        emit(
            runtime.policy(
                args.involvement
            )
        )
        return 0

    if args.command == "reason":
        result = runtime.reason(
            task=args.task,
            anchors=args.anchor,
            constraints=args.constraint,
            destination=args.destination,
            involvement=args.involvement,
            mode=args.mode,
            context=args.context,
        )

        emit(result)

        return (
            0
            if result.get("status")
            in {
                "ok",
                "unavailable",
            }
            else 1
        )

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
