#!/usr/bin/env python3

from __future__ import annotations

import json
import sys

from pathlib import Path


root = Path(
    "/root/savant-runtime"
)

if str(
    root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            root
        ),
    )


from runtime.constitution import (  # noqa: E402
    ConstitutionalRegistry,
    ConstitutionalValidator,
)

from runtime.living_governance_constitutional import (  # noqa: E402
    describe,
    install,
    operator_id,
    service_id,
)


def main() -> int:
    registry = (
        ConstitutionalRegistry.load(
            root
        )
    )

    installed = install(
        registry
    )

    validation = (
        ConstitutionalValidator(
            installed
        ).validate()
    )

    result = {
        "owner":
            "living-governance",

        "authority_effect":
            "constitutional-extension",

        "service_present":
            service_id
            in installed.ids,

        "operator_present":
            operator_id
            in installed.ids,

        "constitutional_valid":
            bool(
                validation.get(
                    "valid",
                    False,
                )
            ),

        "description":
            describe(
                installed
            ),

        "credential_values_exposed":
            False,
    }

    print(
        json.dumps(
            result,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    return (
        0
        if (
            result[
                "service_present"
            ]
            and result[
                "operator_present"
            ]
            and result[
                "constitutional_valid"
            ]
        )
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
