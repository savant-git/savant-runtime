#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from living_policy_lifecycle import (  # noqa: E402
    living_policy_lifecycle_error,
    project,
    selftest,
    status,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_records(
    path: str,
) -> list[dict[str, Any]]:
    value = read_json(
        path
    )

    if isinstance(
        value,
        dict,
    ):
        for field in (
            "records",
            "policies",
            "items",
        ):
            candidate = value.get(
                field
            )

            if isinstance(
                candidate,
                list,
            ):
                value = candidate
                break

    if not isinstance(
        value,
        list,
    ):
        raise ValueError(
            (
                "records must be a JSON array "
                "or object containing "
                "records/policies/items"
            )
        )

    records = []

    for item in value:
        if not isinstance(
            item,
            dict,
        ):
            raise ValueError(
                (
                    "every policy record "
                    "must be an object"
                )
            )

        records.append(
            item
        )

    return records


def read_events(
    path: str | None,
) -> list[dict[str, Any]] | None:
    if path is None:
        return None

    value = read_json(
        path
    )

    if isinstance(
        value,
        dict,
    ):
        for field in (
            "events",
            "supersession_events",
            "items",
        ):
            candidate = value.get(
                field
            )

            if isinstance(
                candidate,
                list,
            ):
                value = candidate
                break

    if not isinstance(
        value,
        list,
    ):
        raise ValueError(
            (
                "supersession input must be "
                "a JSON array or object "
                "containing events/"
                "supersession_events/items"
            )
        )

    events = []

    for item in value:
        if not isinstance(
            item,
            dict,
        ):
            raise ValueError(
                (
                    "every supersession event "
                    "must be an object"
                )
            )

        events.append(
            item
        )

    return events


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="living-policy-lifecycle",
        description=(
            "append-only Living Governance "
            "policy lifecycle projection "
            "with Pryme-owned supersession "
            "resolution"
        ),
    )

    commands = parser.add_subparsers(
        dest="command",
        required=True,
    )

    commands.add_parser(
        "status"
    )

    commands.add_parser(
        "selftest"
    )

    evaluate = commands.add_parser(
        "project"
    )

    evaluate.add_argument(
        "--records",
        required=True,
    )

    evaluate.add_argument(
        "--supersession-events"
    )

    return parser


def main() -> int:
    args = (
        build_parser()
        .parse_args()
    )

    try:
        if args.command == "status":
            output = status()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "project":
            output = project(
                read_records(
                    args.records
                ),
                supersession=
                    read_events(
                        (
                            args
                            .supersession_events
                        )
                    ),
            )

        else:
            raise ValueError(
                "unknown command"
            )

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        living_policy_lifecycle_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "schema":
                        (
                            "savant.living-governance."
                            "policy-lifecycle.v1"
                        ),

                    "owner":
                        "living-governance",

                    (
                        "supersession_"
                        "resolution_owner"
                    ):
                        "pryme",

                    "authority_effect":
                        "none",

                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),

                    "authority_transfer":
                        False,
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
