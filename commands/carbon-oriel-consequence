#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel import oriel_error  # noqa: E402

from oriel_causality import (  # noqa: E402
    oriel_causality_error,
)

from oriel_consequence import (  # noqa: E402
    capability_manifest,
    engine,
    oriel_consequence_error,
    selftest,
    status,
)

from oriel_inverse import (  # noqa: E402
    oriel_inverse_error,
)

from oriel_quantum import (  # noqa: E402
    oriel_quantum_error,
)

from oriel_reality import (  # noqa: E402
    oriel_reality_error,
)

from oriel_simulation import (  # noqa: E402
    oriel_simulation_error,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_object(
    path: str,
) -> dict[str, Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "input must be a JSON object"
        )

    return value


def read_list(
    path: str,
) -> list[Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        list,
    ):
        raise ValueError(
            "input must be a JSON list"
        )

    return value


def add_superposition_inputs(
    parser: argparse.ArgumentParser,
) -> None:
    parser.add_argument(
        "--oriel",
        required=True,
    )

    parser.add_argument(
        "--facts",
        required=True,
    )

    parser.add_argument(
        "--scenario",
        required=True,
    )

    parser.add_argument(
        "--possibilities",
        required=True,
    )

    parser.add_argument(
        "--mode",
        default="tour_bus",
    )

    parser.add_argument(
        "--pressure-threshold-minutes",
        type=float,
        default=60.0,
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-consequence",
        description=(
            "Reality-bound Carbon Oriel "
            "quantum consequence analysis"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "capabilities"
    )

    subparsers.add_parser(
        "selftest"
    )

    superpose_parser = (
        subparsers.add_parser(
            "superpose"
        )
    )

    add_superposition_inputs(
        superpose_parser
    )

    frontier_parser = (
        subparsers.add_parser(
            "frontier"
        )
    )

    frontier_parser.add_argument(
        "lattice"
    )

    compare_parser = (
        subparsers.add_parser(
            "compare"
        )
    )

    compare_parser.add_argument(
        "lattice"
    )

    compare_parser.add_argument(
        "left"
    )

    compare_parser.add_argument(
        "right"
    )

    collapse_parser = (
        subparsers.add_parser(
            "collapse"
        )
    )

    collapse_parser.add_argument(
        "lattice"
    )

    collapse_parser.add_argument(
        "possibility"
    )

    collapse_parser.add_argument(
        "--allow-conditional",
        action="store_true",
    )

    collapse_parser.add_argument(
        "--allow-unresolved",
        action="store_true",
    )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "capabilities":
            output = capability_manifest()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "superpose":
            output = engine.superpose(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
                read_object(
                    args.scenario
                ),
                read_list(
                    args.possibilities
                ),
                mode=
                    args.mode,
                pressure_threshold_minutes=
                    args.pressure_threshold_minutes,
            )

        elif args.command == "frontier":
            output = engine.frontier(
                read_object(
                    args.lattice
                )
            )

        elif args.command == "compare":
            output = engine.compare(
                read_object(
                    args.lattice
                ),
                args.left,
                args.right,
            )

        elif args.command == "collapse":
            output = engine.collapse(
                read_object(
                    args.lattice
                ),
                args.possibility,
                allow_conditional=
                    args.allow_conditional,
                allow_unresolved=
                    args.allow_unresolved,
            )

        else:
            parser.error(
                "unknown command"
            )

            return 2

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_error,
        oriel_causality_error,
        oriel_consequence_error,
        oriel_inverse_error,
        oriel_quantum_error,
        oriel_reality_error,
        oriel_simulation_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and output.get(
            "ok"
        )
        is False
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
