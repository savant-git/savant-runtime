#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys

from pathlib import Path
from typing import Any


runtime_root = Path(
    "/root/savant-runtime/"
    "ontology/obelisks/_template/"
    "segue/gates/_template/segue/"
    "innates/_template/segue/"
    "exiles/carbon/runtime"
)

if str(
    runtime_root
) not in sys.path:
    sys.path.insert(
        0,
        str(
            runtime_root
        ),
    )


from oriel import (  # noqa: E402
    oriel_error,
)

from oriel_reality import (  # noqa: E402
    capability_manifest,
    engine,
    oriel_reality_error,
    selftest,
    status,
)


def read_json(
    path: str,
) -> Any:
    if path == "-":
        return json.load(
            sys.stdin
        )

    return json.loads(
        Path(
            path
        ).read_text(
            encoding="utf-8"
        )
    )


def read_object(
    path: str,
) -> dict[str, Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        dict,
    ):
        raise ValueError(
            "input must be a JSON object"
        )

    return value


def read_list(
    path: str,
) -> list[Any]:
    value = read_json(
        path
    )

    if not isinstance(
        value,
        list,
    ):
        raise ValueError(
            "input must be a JSON list"
        )

    return value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="carbon-oriel-reality",
        description=(
            "Bind sourced historical reality "
            "to Carbon Oriel simulation"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status"
    )

    subparsers.add_parser(
        "capabilities"
    )

    subparsers.add_parser(
        "selftest"
    )

    bind_parser = subparsers.add_parser(
        "bind"
    )

    bind_parser.add_argument(
        "--oriel",
        required=True,
    )

    bind_parser.add_argument(
        "--facts",
        required=True,
    )

    validate_parser = subparsers.add_parser(
        "validate"
    )

    validate_parser.add_argument(
        "--oriel",
        required=True,
    )

    validate_parser.add_argument(
        "--facts",
        required=True,
    )

    validate_parser.add_argument(
        "--mode",
        default="tour_bus",
    )

    availability_parser = (
        subparsers.add_parser(
            "availability"
        )
    )

    availability_parser.add_argument(
        "--oriel",
        required=True,
    )

    availability_parser.add_argument(
        "--facts",
        required=True,
    )

    availability_parser.add_argument(
        "--location",
        required=True,
    )

    availability_parser.add_argument(
        "--start",
        required=True,
    )

    availability_parser.add_argument(
        "--end",
        required=True,
    )

    snapshot_parser = subparsers.add_parser(
        "snapshot"
    )

    snapshot_parser.add_argument(
        "--oriel",
        required=True,
    )

    snapshot_parser.add_argument(
        "--facts",
        required=True,
    )

    snapshot_parser.add_argument(
        "--timestamp",
        required=True,
    )

    snapshot_parser.add_argument(
        "--location"
    )

    encounter_parser = subparsers.add_parser(
        "encounters"
    )

    encounter_parser.add_argument(
        "--oriel",
        required=True,
    )

    encounter_parser.add_argument(
        "--facts",
        required=True,
    )

    encounter_parser.add_argument(
        "--fictional-entity",
        required=True,
    )

    encounter_parser.add_argument(
        "--historical-entity",
        required=True,
    )

    encounter_parser.add_argument(
        "--radius-km",
        type=float,
        default=5.0,
    )

    gaps_parser = subparsers.add_parser(
        "gaps"
    )

    gaps_parser.add_argument(
        "--oriel",
        required=True,
    )

    gaps_parser.add_argument(
        "--facts",
        required=True,
    )

    return parser


def main() -> int:
    parser = build_parser()

    args = parser.parse_args()

    try:
        if args.command == "status":
            output = status()

        elif args.command == "capabilities":
            output = capability_manifest()

        elif args.command == "selftest":
            output = selftest()

        elif args.command == "bind":
            output = engine.bind(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
            )

        elif args.command == "validate":
            output = engine.validate(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
                mode=args.mode,
            )

        elif args.command == "availability":
            output = engine.availability(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
                location_id=
                    args.location,
                start=
                    args.start,
                end=
                    args.end,
            )

        elif args.command == "snapshot":
            output = engine.snapshot(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
                timestamp=
                    args.timestamp,
                location_id=
                    args.location,
            )

        elif args.command == "encounters":
            output = (
                engine.encounter_opportunities(
                    read_object(
                        args.oriel
                    ),
                    read_list(
                        args.facts
                    ),
                    fictional_entity=
                        args.fictional_entity,
                    historical_entity=
                        args.historical_entity,
                    radius_km=
                        args.radius_km,
                )
            )

        elif args.command == "gaps":
            output = engine.coverage_gaps(
                read_object(
                    args.oriel
                ),
                read_list(
                    args.facts
                ),
            )

        else:
            parser.error(
                "unknown command"
            )

            return 2

    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        oriel_error,
        oriel_reality_error,
    ) as exc:
        print(
            json.dumps(
                {
                    "ok":
                        False,

                    "error":
                        str(
                            exc
                        ),
                },
                indent=2,
                sort_keys=True,
            )
        )

        return 1

    print(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    )

    if (
        isinstance(
            output,
            dict,
        )
        and (
            output.get(
                "outcome"
            )
            == "fail"
            or output.get(
                "ok"
            )
            is False
        )
    ):
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
